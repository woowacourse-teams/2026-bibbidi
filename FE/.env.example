BIBBIDI_API_BASE_URL=
BIBBIDI_API_PROXY_TARGET=http://localhost:8080
FE_SERVICE_URL=http://localhost:3000
BIBBIDI_GA_MEASUREMENT_ID=

# 공지 기간·개발 프로젝트 QA·탈퇴 삭제 절차 완료 전 운영에서 켜지 않는다.
BIBBIDI_POSTHOG_ENABLED=false
BIBBIDI_POSTHOG_PROJECT_TOKEN=
BIBBIDI_POSTHOG_HOST=https://us.i.posthog.com
# Sentry는 로컬에서 비활성. 배포 CodeBuild에서만 true와 프로젝트 DSN을 설정한다.
BIBBIDI_SENTRY_ENABLED=false
BIBBIDI_SENTRY_DSN=
# SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN은 CodeBuild 비밀 설정에서 주입한다.
BIBBIDI_APP_ENV=development
BIBBIDI_APP_VERSION=local
