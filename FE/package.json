{
  "name": "bibbidi-fe",
  "version": "0.1.0",
  "private": true,
  "description": "Bibbidi frontend built with Next.js and TypeScript",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "next build"
  },
  "dependencies": {
    "@sentry/nextjs": "11.1.0",
    "@sentry/react": "11.1.0",
    "next": "16.4.6",
    "posthog-js": "1.434.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.9.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "5.18.6",
    "eslint-plugin-react-x": "5.18.6",
    "globals": "^16.5.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
