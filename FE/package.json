{
  "name": "bibbidi-fe",
  "version": "0.1.0",
  "private": true,
  "description": "Bibbidi frontend built with React, TypeScript, and Webpack",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "webpack serve --mode development",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && webpack --mode production"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "5.18.6",
    "eslint-plugin-react-x": "5.18.6",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.8",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "^3.9.6",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  }
}
