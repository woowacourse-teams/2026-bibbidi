{
  "description": "GitHub Issue 기반 AI Development Logger",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "timeout": 15, "statusMessage": "작업 시작 상태를 기록하는 중" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "timeout": 20, "statusMessage": "Issue와 요청을 연결하는 중" }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "timeout": 30, "statusMessage": "이 작업을 해도 되는지 확인하는 중" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "timeout": 20, "statusMessage": "테스트 결과를 기록하는 중" }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[join(root,'packages','development-logger','src','cli.mjs'),'hook','codex'],{stdio:'inherit'});process.exit(result.status??1)\"", "timeout": 30, "statusMessage": "이번 턴에서 바뀐 코드를 기록하는 중" }] }]
  }
}
