diff --git a/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/BibbidiEvaluationIntegrationTest.java b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/BibbidiEvaluationIntegrationTest.java
