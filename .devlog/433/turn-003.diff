diff --git a/FE/src/features/preparation/hooks/useRoadmapViewPicker.ts b/FE/src/features/preparation/hooks/useRoadmapViewPicker.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bf5a1a987b889c5cbd53a332f74b6248df3ebbb9
--- /dev/null
+++ b/FE/src/features/preparation/hooks/useRoadmapViewPicker.ts
@@ -0,0 +1,51 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+
+import {
+  MOBILE_LAYOUT_MEDIA_QUERY,
+  useIsMobileLayout,
+} from "../../../shared/responsive";
+import { RoadmapView } from "../view/RoadmapViewSwitcher";
+
+export function useRoadmapViewPicker({
+  audience,
+  onViewChange,
+}: {
+  audience: string;
+  onViewChange: (view: RoadmapView) => void;
+}) {
+  const isMobile = useIsMobileLayout();
+  const [pickerAudience, setPickerAudience] = useState<string | null>(null);
+  const restorePickerFocus = useRef(false);
+  const triggerRef = useCallback((node: HTMLButtonElement | null) => {
+    if (node && restorePickerFocus.current) {
+      node.focus();
+      restorePickerFocus.current = false;
+    }
+  }, []);
+
+  useEffect(() => {
+    const mediaQuery = window.matchMedia?.(MOBILE_LAYOUT_MEDIA_QUERY);
+    const closeOnDesktop = (event: MediaQueryListEvent) => {
+      if (!event.matches) setPickerAudience(null);
+    };
+    mediaQuery?.addEventListener("change", closeOnDesktop);
+    return () => mediaQuery?.removeEventListener("change", closeOnDesktop);
+  }, []);
+
+  const open = () => setPickerAudience(audience);
+  const close = () => setPickerAudience(null);
+  const select = (view: RoadmapView) => {
+    restorePickerFocus.current = true;
+    close();
+    onViewChange(view);
+  };
+
+  return {
+    isMobile,
+    isOpen: isMobile && pickerAudience === audience,
+    open,
+    close,
+    select,
+    triggerRef,
+  };
+}
