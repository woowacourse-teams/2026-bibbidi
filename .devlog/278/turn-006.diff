diff --git a/Infra/nginx/nginx.conf.template b/Infra/nginx/nginx.conf.template
index 8a39d28a81ca6b4dff067fcf738773fddd0216fa..f94178d38a8aad180cbf08a1721d0e25955c2788 100644
--- a/Infra/nginx/nginx.conf.template
+++ b/Infra/nginx/nginx.conf.template
@@ -145,6 +145,22 @@ http {
             return 404;
         }
 
+        # H2 콘솔은 frame으로 화면을 그린다. frame 허용은 백엔드가 SAMEORIGIN으로 붙이므로 여기서는 X-Frame-Options를 붙이지 않는다.
+        location ^~ /h2-console {
+            limit_req zone=per_ip_api burst=60 nodelay;
+            limit_conn per_ip_conn 40;
+
+            add_header Strict-Transport-Security "max-age=31536000" always;
+            add_header X-Content-Type-Options nosniff always;
+            add_header Referrer-Policy strict-origin-when-cross-origin always;
+
+            proxy_pass http://backend:8080;
+            proxy_set_header Host $host;
+            proxy_set_header X-Real-IP $remote_addr;
+            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+            proxy_set_header X-Forwarded-Proto $scheme;
+        }
+
         location / {
             limit_req zone=per_ip_api burst=60 nodelay;
             limit_conn per_ip_conn 40;
