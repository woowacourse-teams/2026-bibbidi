diff --git a/FE/src/features/checklist/view/ChecklistStatusConfirmationDialog.tsx b/FE/src/features/checklist/view/ChecklistStatusConfirmationDialog.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..5acaac7d1b0f9ff575801a4ab673b52510eca2a6
--- /dev/null
+++ b/FE/src/features/checklist/view/ChecklistStatusConfirmationDialog.tsx
@@ -0,0 +1,38 @@
+import { ChecklistModalDialog } from "./ChecklistModalDialog";
+
+export function ChecklistStatusConfirmationDialog({
+  isPending,
+  errorMessage,
+  onCancel,
+  onConfirm,
+}: {
+  isPending: boolean;
+  errorMessage?: string;
+  onCancel: () => void;
+  onConfirm: () => void;
+}) {
+  return (
+    <ChecklistModalDialog
+      title="남은 일정도 완료할까요?"
+      description={
+        <>
+          이 할 일을 완료하면 아직 남아 있는 일정도 함께 완료돼요.
+          {errorMessage ? <p role="alert">{errorMessage}</p> : null}
+        </>
+      }
+      onEscape={() => {
+        if (!isPending) onCancel();
+      }}
+      actions={
+        <>
+          <button type="button" disabled={isPending} onClick={onCancel}>
+            취소
+          </button>
+          <button type="button" disabled={isPending} onClick={onConfirm}>
+            {isPending ? "변경 중" : "함께 완료"}
+          </button>
+        </>
+      }
+    />
+  );
+}
