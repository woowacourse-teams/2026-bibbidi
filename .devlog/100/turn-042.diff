+    @Transactional(readOnly = true)
+    public List<RecommendedCatalogItemResult> findRecommendedCatalogItems(Long ownerId, int limit) {
+        Checklist checklist = checklistRepository.getByOwnerId(ownerId);
+        List<CatalogItemDetailSnapshot> allItems = catalogService.findAllItemDetails();
+
+        List<CatalogItemDetailSnapshot> candidates = findCandidates(checklist, allItems);
+        List<CatalogItemDetailSnapshot> pickedItems = pickRandomly(candidates, limit);
+
+        return toResults(pickedItems);
+    }
+
+    private List<CatalogItemDetailSnapshot> findCandidates(
+            Checklist checklist,
+            List<CatalogItemDetailSnapshot> allItems
+    ) {
+        List<CatalogItemDetailSnapshot> addedItems = filter(allItems, item -> checklist.hasAdded(item.id()));
+        List<CatalogItemDetailSnapshot> notAddedItems = filter(allItems, item -> !checklist.hasAdded(item.id()));
+
+        int basePhase = basePhase(addedItems, notAddedItems);
+        return filter(notAddedItems, item -> item.isUpTo(basePhase));
+    }
+
+    private int basePhase(
+            List<CatalogItemDetailSnapshot> addedItems,
+            List<CatalogItemDetailSnapshot> notAddedItems
+    ) {
+        int maxAddedPhase = addedItems.stream()
+                .mapToInt(CatalogItemDetailSnapshot::phase)
+                .max()
+                .orElse(FIRST_PHASE);
+        int minNotAddedPhase = notAddedItems.stream()
+                .mapToInt(CatalogItemDetailSnapshot::phase)
+                .min()
+                .orElse(FIRST_PHASE);
+        return Math.max(maxAddedPhase, minNotAddedPhase);
+    }
+
+    private List<CatalogItemDetailSnapshot> filter(
+            List<CatalogItemDetailSnapshot> items,
+            Predicate<CatalogItemDetailSnapshot> condition
+    ) {
+        return items.stream()
+                .filter(condition)
+                .toList();
+    }
+
+    private List<RecommendedCatalogItemResult> toResults(List<CatalogItemDetailSnapshot> items) {
+        return items.stream()
+                .map(RecommendedCatalogItemResult::from)
+                .toList();
+    }
