+package com.bibbidi.wedding.checklist.service.dto;
+
+import com.bibbidi.wedding.catalog.service.dto.CatalogItemDetailSnapshot;
+import com.bibbidi.wedding.checklist.domain.Checklist;
+import java.util.List;
+
+public record CatalogItemDetails(List<CatalogItemDetailSnapshot> values) {
+
+    public CatalogItemDetails addedTo(Checklist checklist) {
+        return new CatalogItemDetails(values.stream()
+                .filter(item -> checklist.hasAdded(item.id()))
+                .toList());
+    }
+
+    public CatalogItemDetails notAddedTo(Checklist checklist) {
+        return new CatalogItemDetails(values.stream()
+                .filter(item -> !checklist.hasAdded(item.id()))
+                .toList());
+    }
+
+    public CatalogItemDetails upTo(int phase) {
+        return new CatalogItemDetails(values.stream()
+                .filter(item -> item.isUpTo(phase))
+                .toList());
+    }
+
+    public boolean hasItemUpTo(int phase) {
+        return values.stream()
+                .anyMatch(item -> item.isUpTo(phase));
+    }
+
+    public int highestPhaseOr(int defaultPhase) {
+        return values.stream()
+                .mapToInt(CatalogItemDetailSnapshot::phase)
+                .max()
+                .orElse(defaultPhase);
+    }
+
+    public int lowestPhaseOr(int defaultPhase) {
+        return values.stream()
+                .mapToInt(CatalogItemDetailSnapshot::phase)
+                .min()
+                .orElse(defaultPhase);
+    }
+}
