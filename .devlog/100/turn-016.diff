+package com.bibbidi.wedding.catalog.domain;
+
+import java.util.Collection;
+import org.jspecify.annotations.NonNull;
+import org.jspecify.annotations.Nullable;
+
+public record CandidateItem(
+        @Nullable Long itemId,
+        @NonNull String title,
+        @NonNull String categoryName,
+        int phase,
+        @NonNull String stepName
+) {
+
+    public boolean isAddedIn(Collection<Long> addedItemIds) {
+        return addedItemIds.contains(itemId);
+    }
+
+    public boolean isUpTo(int basePhase) {
+        return phase <= basePhase;
+    }
+}
