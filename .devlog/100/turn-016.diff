+    public List<CandidateItem> findCandidates(Collection<Long> addedItemIds) {
+        List<CandidateItem> allItems = candidateItems();
+        List<CandidateItem> addedItems = filter(allItems, item -> item.isAddedIn(addedItemIds));
+        List<CandidateItem> notAddedItems = filter(allItems, item -> !item.isAddedIn(addedItemIds));
+
+        int basePhase = Math.max(maxPhaseOf(addedItems), minPhaseOf(notAddedItems));
+        return filter(notAddedItems, item -> item.isUpTo(basePhase));
+    }
+
+    private List<CandidateItem> candidateItems() {
+        return categories.stream()
+                .flatMap(category -> category.candidateItems().stream())
+                .toList();
+    }
+
+    private static List<CandidateItem> filter(List<CandidateItem> items, Predicate<CandidateItem> condition) {
+        return items.stream()
+                .filter(condition)
+                .toList();
+    }
+
+    private static int maxPhaseOf(List<CandidateItem> items) {
+        return items.stream()
+                .mapToInt(CandidateItem::phase)
+                .max()
+                .orElse(FIRST_PHASE);
+    }
+
+    private static int minPhaseOf(List<CandidateItem> items) {
+        return items.stream()
+                .mapToInt(CandidateItem::phase)
+                .min()
+                .orElse(FIRST_PHASE);
+    }
+
     private static List<Category> sortByDisplayOrder(List<Category> categories) {
