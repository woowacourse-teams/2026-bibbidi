diff --git a/FE/src/features/preparation/view/AddedRoadmapTaskTitle.tsx b/FE/src/features/preparation/view/AddedRoadmapTaskTitle.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..bbf5f83f51026ac1c5dc4ccabfd307efc9137267
--- /dev/null
+++ b/FE/src/features/preparation/view/AddedRoadmapTaskTitle.tsx
@@ -0,0 +1,56 @@
+import { useEffect, useRef, useState } from "react";
+
+import { useMediaQuery } from "../../../shared/responsive";
+
+export function AddedRoadmapTaskTitle({
+  title,
+  onComplete,
+}: {
+  title: string;
+  onComplete: () => void;
+}) {
+  const ref = useRef<HTMLSpanElement>(null);
+  const [text, setText] = useState("");
+  const reducedMotion = useMediaQuery("(prefers-reduced-motion: reduce)");
+
+  useEffect(() => {
+    ref.current?.closest("li")?.scrollIntoView({
+      behavior: reducedMotion ? "instant" : "smooth",
+      block: "nearest",
+      inline: "center",
+    });
+    if (reducedMotion) {
+      onComplete();
+      return;
+    }
+    const letters = Array.from(
+      new Intl.Segmenter("ko", { granularity: "grapheme" }).segment(title),
+      (part) => part.segment,
+    );
+    let index = 0;
+    let timer: number;
+    const type = () => {
+      index += 1;
+      setText(letters.slice(0, index).join(""));
+      timer = window.setTimeout(
+        index < letters.length ? type : onComplete,
+        index < letters.length ? Math.min(45, 900 / letters.length) : 250,
+      );
+    };
+    timer = window.setTimeout(type, 350);
+    return () => window.clearTimeout(timer);
+  }, [title, reducedMotion, onComplete]);
+
+  return (
+    <span
+      aria-hidden="true"
+      className="personal-roadmap__task-title personal-roadmap__task-title--added"
+      ref={ref}
+    >
+      <span className="personal-roadmap__title-reserve">{title}</span>
+      <span className="personal-roadmap__title-typing">
+        {reducedMotion ? title : text}
+      </span>
+    </span>
+  );
+}
