+                                .requestHeaders(headerWithName(AUTHORIZATION)
+                                        .description("로그인한 회원의 access token"))
+                                .requestFields(PayloadDocumentation.fieldWithPath("deleteGrant")
+                                        .description("소셜 재인증으로 받은 탈퇴용 표"))
+                                .build())));
