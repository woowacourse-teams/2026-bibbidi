+                pendingUser.userId(), LEGACY_NICKNAME, LEGACY_PASSWORD, ClientType.WEB);
+
+        BibbidiTokenClaims claims = bibbidiTokenParser.parseAccessToken(session.accessToken());
+
+        assertThat(claims.userId()).isEqualTo(legacyUserId);
+        assertThat(session.termsAgreementRequired()).isFalse();
