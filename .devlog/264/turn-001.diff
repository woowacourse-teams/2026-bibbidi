+                .extracting(exception -> ((BusinessException) exception).clientError())
+                .isEqualTo(ClientError.USER_NOT_FOUND);
+        assertThatThrownBy(() -> sessionRefreshService.refresh(pendingSession.refreshToken(), ClientType.WEB))
