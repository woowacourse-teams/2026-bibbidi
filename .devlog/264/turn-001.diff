+        legacyAccountTransferService.transfer(pendingUser.userId(), LEGACY_NICKNAME, LEGACY_PASSWORD, ClientType.WEB);
+
+        assertThatThrownBy(() -> userService.findCurrentUserInfo(pendingUser.userId()))
