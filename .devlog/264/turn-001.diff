index 0000000000000000000000000000000000000000..7a323d3b6d047e7256a71614b96861a5fab8c56a
--- /dev/null
+++ b/BE/src/main/java/com/bibbidi/wedding/auth/service/LegacyAccountTransferService.java
@@ -0,0 +1,96 @@
+package com.bibbidi.wedding.auth.service;
+
+import com.bibbidi.wedding.auth.domain.ClientType;
+import com.bibbidi.wedding.auth.domain.SocialIdentity;
+import com.bibbidi.wedding.auth.password.Argon2PasswordHasher;
+import com.bibbidi.wedding.auth.repository.RefreshSessionRepository;
+import com.bibbidi.wedding.auth.repository.SocialIdentityRepository;
+import com.bibbidi.wedding.auth.service.dto.IssuedSession;
+import com.bibbidi.wedding.auth.service.dto.UserAuthInfo;
+import com.bibbidi.wedding.common.domain.UserStatus;
+import com.bibbidi.wedding.common.exception.BusinessException;
+import com.bibbidi.wedding.common.exception.ClientError;
+import com.bibbidi.wedding.user.service.UserResult;
+import com.bibbidi.wedding.user.service.UserService;
+import com.bibbidi.wedding.user.service.dto.PasswordLoginInfo;
+import java.time.LocalDateTime;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * 비밀번호로 가입했던 기존 회원을 소셜 계정으로 옮긴다.
+ *
+ * <p>기존 회원을 남기고 소셜 로그인으로 새로 생긴 회원을 지운다. 기존 회원이 쓰던 체크리스트를 그대로 쓰게 하기 위해서다.
+ * 옮긴 뒤에는 기존 회원의 비밀번호를 지워서 같은 닉네임과 비밀번호로 다시 옮길 수 없게 한다.
+ *
+ * <p>약관에 동의하기 전인 회원만 옮길 수 있다. 가입을 마친 회원은 그동안 만든 데이터가 있을 수 있는데,
+ * 옮기면 그 회원을 지우면서 데이터도 함께 지워지기 때문이다.
+ */
+@Service
+@Transactional
+public class LegacyAccountTransferService {
+
+    private final UserService userService;
+    private final Argon2PasswordHasher passwordHasher;
+    private final SocialIdentityRepository socialIdentityRepository;
+    private final RefreshSessionRepository refreshSessionRepository;
+    private final SessionIssueService sessionIssueService;
+
+    public LegacyAccountTransferService(
+            UserService userService,
+            Argon2PasswordHasher passwordHasher,
+            SocialIdentityRepository socialIdentityRepository,
+            RefreshSessionRepository refreshSessionRepository,
+            SessionIssueService sessionIssueService
+    ) {
+        this.userService = userService;
+        this.passwordHasher = passwordHasher;
+        this.socialIdentityRepository = socialIdentityRepository;
+        this.refreshSessionRepository = refreshSessionRepository;
+        this.sessionIssueService = sessionIssueService;
+    }
+
+    public IssuedSession transfer(
+            Long currentUserId,
+            String nickname,
+            String password,
+            ClientType clientType
+    ) {
+        UserResult currentUser = userService.findCurrentUserInfo(currentUserId);
+        if (currentUser.status() == UserStatus.ACTIVE) {
+            throw new BusinessException(
+                    ClientError.INVALID_REQUEST,
+                    "가입을 마친 회원은 기존 회원을 옮겨 올 수 없습니다. userId=" + currentUserId
+            );
+        }
+        SocialIdentity socialIdentity = socialIdentityRepository.findByUserId(currentUserId)
+                .orElseThrow(() -> new BusinessException(
+                        ClientError.INVALID_REQUEST,
+                        "소셜 계정이 연결되지 않은 회원은 기존 회원을 옮겨 올 수 없습니다. userId=" + currentUserId
+                ));
+
+        PasswordLoginInfo legacyAccount = userService.findPasswordLoginInfo(nickname)
+                .orElseThrow(() -> new BusinessException(
+                        ClientError.AUTHENTICATION_FAILED,
+                        "비밀번호로 가입한 회원 중에 요청한 닉네임이 없습니다. userId=" + currentUserId
+                ));
+        if (!passwordHasher.matches(password, legacyAccount.passwordHash())) {
+            throw new BusinessException(
+                    ClientError.AUTHENTICATION_FAILED,
+                    "기존 회원의 비밀번호가 맞지 않습니다. userId=" + currentUserId
+            );
+        }
+
+        socialIdentityRepository.save(socialIdentity.moveTo(legacyAccount.userId()));
+        userService.removePassword(legacyAccount.userId());
+        refreshSessionRepository.revokeAllOfUser(currentUserId, LocalDateTime.now());
+        userService.delete(currentUserId);
+
+        UserResult legacyUser = userService.findCurrentUserInfo(legacyAccount.userId());
+        return sessionIssueService.issueForNewFamily(toUserAuthInfo(legacyUser), clientType);
+    }
+
+    private static UserAuthInfo toUserAuthInfo(UserResult user) {
+        return new UserAuthInfo(user.id(), user.status(), user.role(), user.nickname(), user.email());
+    }
+}
