+        assertThatThrownBy(() -> legacyAccountTransferService.transfer(
+                pendingUser.userId(), "없는회원", LEGACY_PASSWORD, ClientType.WEB))
+                .isInstanceOf(BusinessException.class)
+                .extracting(exception -> ((BusinessException) exception).clientError())
+                .isEqualTo(ClientError.AUTHENTICATION_FAILED);
+    }
+
+    @Test
+    @DisplayName("약관 동의까지 마친 회원은 기존 회원을 옮겨 올 수 없다")
+    void shouldRejectTransferToActiveUser() {
+        userService.activate(pendingUser.userId());
+
+        assertThatThrownBy(() -> legacyAccountTransferService.transfer(
+                pendingUser.userId(), LEGACY_NICKNAME, LEGACY_PASSWORD, ClientType.WEB))
+                .isInstanceOf(BusinessException.class)
+                .extracting(exception -> ((BusinessException) exception).clientError())
