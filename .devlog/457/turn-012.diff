diff --git a/.github/workflows/load-test.yml b/.github/workflows/load-test.yml
new file mode 100644
index 0000000000000000000000000000000000000000..e0e7321bb232281921169914e9ab81ffab2a5f58
--- /dev/null
+++ b/.github/workflows/load-test.yml
@@ -0,0 +1,112 @@
+name: 비비디 부하 테스트
+
+on:
+  workflow_dispatch:
+    inputs:
+      target:
+        description: 부하를 줄 환경
+        type: choice
+        options: [dev]
+        default: dev
+      script:
+        description: 실행할 k6 스크립트
+        type: choice
+        options: [smoke-test]
+        default: smoke-test
+  # 수동 실행 워크플로는 default 브랜치에 있어야 실행되므로, 머지 전 연결 검증용으로만 푸시에도 실행한다. 검증 뒤 제거한다.
+  push:
+    branches: [chore/457]
+    paths:
+      - "Infra/k6/**"
+      - ".github/workflows/load-test.yml"
+
+permissions:
+  contents: read
+
+# 같은 IP에서 나가는 부하가 겹치면 결과가 섞이므로 한 번에 하나만 실행한다.
+concurrency:
+  group: load-test
+  cancel-in-progress: false
+
+jobs:
+  k6:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    environment: ${{ inputs.target == 'production' && 'backend-prod' || 'backend-dev' }}
+    env:
+      TARGET_LABEL: ${{ inputs.target == 'production' && 'prod-test' || 'dev-test' }}
+      SCRIPT: ${{ inputs.script || 'smoke-test' }}
+      REPORT_DIR: ${{ github.workspace }}/k6-report
+    steps:
+      - uses: actions/checkout@v7
+
+      - uses: grafana/setup-k6-action@v1
+        with:
+          k6-version: 2.2.0
+
+      # 배포가 쓰는 시크릿을 새로 만들지 않고 재사용한다. 덩어리 전체가 아니라 필요한 키만 꺼내 가린 뒤 환경 변수로 넘긴다.
+      - name: 기존 시크릿에서 필요한 값만 꺼내기
+        env:
+          SPRING_ENV_CONTENT: ${{ secrets.BIBBIDI_SPRING_ENV }}
+          NGINX_ENV_CONTENT: ${{ secrets.BIBBIDI_NGINX_ENV }}
+          ALLOY_ENV_CONTENT: ${{ secrets.BIBBIDI_ALLOY_ENV }}
+        run: |
+          set -euo pipefail
+          pick() {
+            printf '%s\n' "$1" \
+              | tr -d '\r' \
+              | sed -n -E "s/^(export )?$2=//p" \
+              | head -n 1 \
+              | sed -E "s/^(\"|')//; s/(\"|')$//"
+          }
+          jwt_secret="$(pick "$SPRING_ENV_CONTENT" AUTH_JWT_SECRET)"
+          server_name="$(pick "$NGINX_ENV_CONTENT" SERVER_NAME)"
+          ingest_token="$(pick "$ALLOY_ENV_CONTENT" MONITORING_INGEST_TOKEN)"
+          for secret in "$jwt_secret" "$ingest_token"; do
+            if [ -n "$secret" ]; then echo "::add-mask::$secret"; fi
+          done
+          test -n "$jwt_secret" || { echo "::error::BIBBIDI_SPRING_ENV에서 AUTH_JWT_SECRET을 찾지 못했습니다."; exit 1; }
+          test -n "$server_name" || { echo "::error::BIBBIDI_NGINX_ENV에서 SERVER_NAME을 찾지 못했습니다."; exit 1; }
+          test -n "$ingest_token" || { echo "::error::BIBBIDI_ALLOY_ENV에서 MONITORING_INGEST_TOKEN을 찾지 못했습니다."; exit 1; }
+          {
+            echo "AUTH_JWT_SECRET=$jwt_secret"
+            echo "BASE_URL=https://$server_name"
+            echo "K6_PROMETHEUS_RW_BEARER_TOKEN=$ingest_token"
+          } >> "$GITHUB_ENV"
+
+      - name: testid 정하기
+        run: echo "TEST_ID=${SCRIPT}-$(date -u +%Y%m%d-%H%M)" >> "$GITHUB_ENV"
+
+      # 지표는 모니터링 서버로 보내고, 회차별 파일(summary.json, report.md, report.html)은 REPORT_DIR에 남긴다.
+      # url 태그는 보내지 않고 name 태그로만 집계해 시계열 수를 제한한다.
+      - name: k6 실행
+        env:
+          K6_NO_USAGE_REPORT: "true"
+          K6_SYSTEM_TAGS: proto,status,method,name,group,check,error,error_code,tls_version,scenario,expected_response
+          K6_PROMETHEUS_RW_SERVER_URL: https://monitoring.bibbidi.kr/prometheus/api/v1/write
+          K6_PROMETHEUS_RW_TREND_STATS: p(95),p(99),avg,max
+          K6_PROMETHEUS_RW_LABELS: target=${{ env.TARGET_LABEL }}
+          K6_PROMETHEUS_RW_STALE_MARKERS: "true"
+          K6_WEB_DASHBOARD: "true"
+          K6_WEB_DASHBOARD_PORT: "-1"
+          K6_WEB_DASHBOARD_EXPORT: ${{ env.REPORT_DIR }}/report.html
+          SUMMARY_DIR: ${{ env.REPORT_DIR }}
+        run: |
+          mkdir -p "$REPORT_DIR"
+          k6 run -o experimental-prometheus-rw --tag "testid=$TEST_ID" "Infra/k6/$SCRIPT.ts"
+
+      - name: 잡 요약에 판정표 남기기
+        if: always()
+        run: |
+          if [ -f "$REPORT_DIR/report.md" ]; then
+            cat "$REPORT_DIR/report.md" >> "$GITHUB_STEP_SUMMARY"
+          fi
+
+      - name: 보고서 아티팩트 올리기
+        if: always()
+        uses: actions/upload-artifact@v7
+        with:
+          name: k6-${{ env.TEST_ID }}
+          path: ${{ env.REPORT_DIR }}
+          retention-days: 90
+          if-no-files-found: warn
