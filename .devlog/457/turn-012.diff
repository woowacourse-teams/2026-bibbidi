diff --git a/Infra/k6/smoke-test.ts b/Infra/k6/smoke-test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..654e7305b9e75933438193ff263f0cca701f130b
--- /dev/null
+++ b/Infra/k6/smoke-test.ts
@@ -0,0 +1,55 @@
+import exec from 'k6/execution';
+import http from 'k6/http';
+import type { Options } from 'k6/options';
+import { config } from './src/config.ts';
+import {
+  isNewUserSession,
+  loadCatalogItemIds,
+  newUserSession,
+  poolUserId,
+  prepareReturningUser,
+  returningUserSession,
+  type SetupData,
+} from './src/session.ts';
+import { signAccessToken } from './src/token.ts';
+
+export { handleSummary } from './src/summary.ts';
+
+// 체크리스트 조회의 404(아직 데이터 없음)는 setup()이 예상하는 응답이라 실패로 세지 않는다.
+http.setResponseCallback(http.expectedStatuses({ min: 200, max: 399 }, 404));
+
+// Smoke는 경로가 끝까지 동작하는지만 본다. 성공 기준은 모든 check 통과와 5xx 0건이고, 응답 시간 기준은 걸지 않는다.
+export const options: Options = {
+  scenarios: {
+    smoke: {
+      executor: 'constant-arrival-rate',
+      rate: config.rate,
+      timeUnit: '1s',
+      duration: config.duration,
+      preAllocatedVUs: 5,
+      maxVUs: 20,
+    },
+  },
+  thresholds: {
+    checks: ['rate==1'],
+    server_errors: ['count==0'],
+  },
+  summaryTrendStats: ['avg', 'p(95)', 'p(99)', 'max'],
+};
+
+export function setup(): SetupData {
+  const catalogItemIds = loadCatalogItemIds(signAccessToken(poolUserId(0)));
+  const pool = Array.from({ length: config.poolSize }, (_, index) =>
+    prepareReturningUser(poolUserId(index), catalogItemIds),
+  );
+  return { runId: Math.floor(Date.now() / 1000), catalogItemIds, pool };
+}
+
+export default function (data: SetupData): void {
+  const iteration = exec.scenario.iterationInTest;
+  if (isNewUserSession()) {
+    newUserSession(data, iteration);
+  } else {
+    returningUserSession(data, iteration);
+  }
+}
diff --git a/Infra/k6/src/api.ts b/Infra/k6/src/api.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ee9735113f91724f940c3e0aa097617a6f1e3a1d
--- /dev/null
+++ b/Infra/k6/src/api.ts
@@ -0,0 +1,43 @@
+import { check } from 'k6';
+import http, { type RefinedResponse } from 'k6/http';
+import { Counter } from 'k6/metrics';
+import { config } from './config.ts';
+
+export const serverErrors = new Counter('server_errors');
+
+export interface RequestSpec {
+  // 지표의 name 태그. 경로 변수는 {id}처럼 묶어 시계열 수를 제한한다.
+  name: string;
+  method: 'GET' | 'POST' | 'PUT' | 'DELETE';
+  path: string;
+  expected: number[];
+  body?: unknown;
+}
+
+export function call(token: string, spec: RequestSpec): RefinedResponse<'text'> {
+  const response = http.request(
+    spec.method,
+    `${config.baseUrl}${spec.path}`,
+    spec.body === undefined ? null : JSON.stringify(spec.body),
+    {
+      headers: {
+        Authorization: `Bearer ${token}`,
+        'Content-Type': 'application/json',
+      },
+      tags: { name: spec.name },
+    },
+  );
+
+  if (response.status >= 500) {
+    serverErrors.add(1);
+  }
+  check(response, {
+    [`${spec.name} -> ${spec.expected.join('|')}`]: (r) => spec.expected.includes(r.status),
+  });
+
+  return response;
+}
+
+export function jsonOf<T>(response: RefinedResponse<'text'>): T {
+  return response.json() as unknown as T;
+}
diff --git a/Infra/k6/src/config.ts b/Infra/k6/src/config.ts
