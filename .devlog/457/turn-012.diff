+++ b/Infra/k6/src/config.ts
@@ -0,0 +1,24 @@
+function required(name: string): string {
+  const value = __ENV[name];
+  if (!value) {
+    throw new Error(`환경 변수 ${name}가 필요합니다.`);
+  }
+  return value;
+}
+
+function numberOf(name: string, fallback: number): number {
+  const value = __ENV[name];
+  return value ? Number(value) : fallback;
+}
+
+export const config = {
+  baseUrl: required('BASE_URL').replace(/\/+$/, ''),
+  jwtSecret: required('AUTH_JWT_SECRET'),
+  jwtIssuer: __ENV.AUTH_JWT_ISSUER ?? 'bibbidi',
+  jwtAudience: __ENV.AUTH_JWT_AUDIENCE ?? 'bibbidi-client',
+  tokenLifetimeSeconds: numberOf('TOKEN_LIFETIME_SECONDS', 1800),
+  rate: numberOf('RATE', 1),
+  duration: __ENV.DURATION ?? '1m',
+  poolSize: numberOf('POOL_SIZE', 10),
+  newUserRatio: numberOf('NEW_USER_RATIO', 0.3),
+};
diff --git a/Infra/k6/src/session.ts b/Infra/k6/src/session.ts
new file mode 100644
index 0000000000000000000000000000000000000000..50a8fb6593eff6e0e8a7e97cdff3106732670d6a
--- /dev/null
+++ b/Infra/k6/src/session.ts
@@ -0,0 +1,168 @@
+import { call, jsonOf } from './api.ts';
+import { config } from './config.ts';
+import { LOAD_TEST_USER_ID_BASE, signAccessToken } from './token.ts';
+
+interface CatalogResponse {
+  categories: { steps: { items: { id: number }[] }[] }[];
+}
+
+interface ChecklistResponse {
+  id: number;
+  items: { id: number; appointments: { id: number }[] }[];
+}
+
+interface AddCatalogItemsResponse {
+  items: { id: number }[];
+}
+
+interface AppointmentResponse {
+  id: number;
+}
+
+export interface PoolUser {
+  userId: number;
+  appointmentId: number;
+}
+
+export interface SetupData {
+  runId: number;
+  catalogItemIds: number[];
+  pool: PoolUser[];
+}
+
+// 재방문 사용자는 setup()이 미리 만든 고정 사용자 풀에서 고른다.
+export function poolUserId(index: number): number {
+  return LOAD_TEST_USER_ID_BASE + 1 + index;
+}
+
+// 신규 사용자는 회차마다 겹치지 않는 ID를 쓴다. 이전 회차 데이터와 부딪히지 않고 정리 대역(900000000 이상)에 들어간다.
+function newUserId(runId: number, iteration: number): number {
+  return LOAD_TEST_USER_ID_BASE + 100_000_000_000 + runId * 100_000 + iteration;
+}
+
+function pickRandom(ids: number[], count: number): number[] {
+  const pool = [...ids];
+  const picked: number[] = [];
+  while (picked.length < count && pool.length > 0) {
+    picked.push(pool.splice(Math.floor(Math.random() * pool.length), 1)[0]);
+  }
+  return picked;
+}
+
+function dateAfter(days: number): string {
+  return new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
+}
+
+export function loadCatalogItemIds(token: string): number[] {
+  const response = call(token, { name: 'GET /api/catalog', method: 'GET', path: '/api/catalog', expected: [200] });
+  return jsonOf<CatalogResponse>(response).categories.flatMap((category) =>
+    category.steps.flatMap((step) => step.items.map((item) => item.id)),
+  );
+}
+
+function createChecklist(token: string): void {
+  call(token, { name: 'POST /api/checklists', method: 'POST', path: '/api/checklists', expected: [201] });
+}
+
+function addCatalogItems(token: string, catalogItemIds: number[]): number[] {
+  const response = call(token, {
+    name: 'POST /api/checklists/me/catalog-items',
+    method: 'POST',
+    path: '/api/checklists/me/catalog-items',
+    body: catalogItemIds,
+    expected: [201],
+  });
+  return jsonOf<AddCatalogItemsResponse>(response).items.map((item) => item.id);
+}
+
+function createAppointment(token: string, checklistItemId: number, daysAfter: number): number {
+  const date = dateAfter(daysAfter);
+  const response = call(token, {
+    name: 'POST /api/checklist-items/{id}/appointments',
+    method: 'POST',
+    path: `/api/checklist-items/${checklistItemId}/appointments`,
+    body: {
+      title: '부하 테스트 일정',
+      date,
+      startTime: `${date}T10:00:00`,
+      endTime: `${date}T11:00:00`,
+      place: '부하 테스트 장소',
+      memo: 'k6',
+    },
+    expected: [201],
+  });
+  return jsonOf<AppointmentResponse>(response).id;
+}
+
+function findChecklist(token: string): ChecklistResponse | null {
+  const response = call(token, {
+    name: 'GET /api/checklists/me',
+    method: 'GET',
+    path: '/api/checklists/me',
+    expected: [200, 404],
+  });
+  return response.status === 200 ? jsonOf<ChecklistResponse>(response) : null;
+}
+
+// 홈 화면이 부르는 조회들.
+function visitHome(token: string): void {
+  const reads: [string, string][] = [
+    ['GET /api/checklists/me/progress', '/api/checklists/me/progress'],
+    ['GET /api/appointments/me/nearby', '/api/appointments/me/nearby?limit=6'],
+    ['GET /api/checklists/me/unscheduled-items', '/api/checklists/me/unscheduled-items?limit=4'],
+    ['GET /api/checklists/me/recommended-catalog-items', '/api/checklists/me/recommended-catalog-items?limit=4'],
+  ];
+  for (const [name, path] of reads) {
+    call(token, { name, method: 'GET', path, expected: [200] });
+  }
+}
+
+// 이미 데이터가 있으면 그대로 쓰고, 없을 때만 체크리스트와 일정을 만든다. 같은 서버에 다시 실행해도 데이터가 불어나지 않는다.
+export function prepareReturningUser(userId: number, catalogItemIds: number[]): PoolUser {
+  const token = signAccessToken(userId);
+  let checklist = findChecklist(token);
+
+  if (checklist === null) {
+    createChecklist(token);
+    addCatalogItems(token, pickRandom(catalogItemIds, 3));
+    checklist = findChecklist(token);
+  }
+  if (checklist === null || checklist.items.length === 0) {
+    throw new Error(`재방문 사용자 ${userId}의 체크리스트를 준비하지 못했습니다.`);
+  }
+
+  const item = checklist.items[0];
+  const appointmentId = item.appointments[0]?.id ?? createAppointment(token, item.id, 1);
+  return { userId, appointmentId };
+}
+
+// 신규 사용자: 둘러보기 → 체크리스트 담기 → 일정 잡기 → 홈
+export function newUserSession(data: SetupData, iteration: number): void {
+  const token = signAccessToken(newUserId(data.runId, iteration));
+
+  loadCatalogItemIds(token);
+  createChecklist(token);
+  const [firstItemId] = addCatalogItems(token, pickRandom(data.catalogItemIds, 3));
+  createAppointment(token, firstItemId, 1 + (iteration % 28));
+  visitHome(token);
+}
+
+// 재방문 사용자: 홈 → 진행하기
+export function returningUserSession(data: SetupData, iteration: number): void {
+  const user = data.pool[iteration % data.pool.length];
+  const token = signAccessToken(user.userId);
+
+  visitHome(token);
+  findChecklist(token);
+  call(token, {
+    name: 'PUT /api/appointments/{id}/complete',
+    method: 'PUT',
+    path: `/api/appointments/${user.appointmentId}/complete`,
+    body: iteration % 2 === 0,
+    expected: [200],
+  });
+}
+
+export function isNewUserSession(): boolean {
+  return Math.random() < config.newUserRatio;
+}
diff --git a/Infra/k6/src/summary.ts b/Infra/k6/src/summary.ts
new file mode 100644
index 0000000000000000000000000000000000000000..62e152fc81147f88f9df71753734ceb31062fc5b
--- /dev/null
+++ b/Infra/k6/src/summary.ts
@@ -0,0 +1,72 @@
+interface ThresholdResult {
+  ok: boolean;
+}
+
+interface MetricSummary {
+  values?: Record<string, number>;
+  thresholds?: Record<string, ThresholdResult>;
+}
+
+export interface SummaryData {
+  metrics?: Record<string, MetricSummary>;
+  state?: { testRunDurationMs?: number };
+}
+
+function value(data: SummaryData, metric: string, stat: string): number | undefined {
+  return data.metrics?.[metric]?.values?.[stat];
+}
+
+function format(number: number | undefined, digits = 2): string {
+  return number === undefined ? '-' : number.toFixed(digits);
+}
+
+function failedThresholds(data: SummaryData): string[] {
+  const failed: string[] = [];
+  for (const [metric, summary] of Object.entries(data.metrics ?? {})) {
+    for (const [expression, result] of Object.entries(summary.thresholds ?? {})) {
+      if (!result.ok) {
+        failed.push(`${metric}: ${expression}`);
+      }
+    }
+  }
+  return failed;
+}
+
+// 깃허브 잡 요약에 그대로 보여 줄 판정표. 문서에 없는 키는 '-'로 두어 요약이 깨지지 않게 한다.
+export function toMarkdown(data: SummaryData): string {
+  const failed = failedThresholds(data);
+  const verdict = failed.length === 0 ? '통과' : '실패';
+  const durationSeconds = (data.state?.testRunDurationMs ?? 0) / 1000;
+
+  const rows: [string, string][] = [
+    ['판정', failed.length === 0 ? '✅ 통과' : '❌ 실패'],
+    ['실행 시간(초)', format(durationSeconds, 0)],
+    ['요청 수', format(value(data, 'http_reqs', 'count'), 0)],
+    ['요청/초', format(value(data, 'http_reqs', 'rate'))],
+    ['세션(반복) 수', format(value(data, 'iterations', 'count'), 0)],
+    ['체크 통과율', format(value(data, 'checks', 'rate'), 4)],
+    ['5xx 건수', format(value(data, 'server_errors', 'count') ?? 0, 0)],
+    ['응답 시간 avg(ms)', format(value(data, 'http_req_duration', 'avg'))],
+    ['응답 시간 p(95)(ms)', format(value(data, 'http_req_duration', 'p(95)'))],
+    ['응답 시간 p(99)(ms)', format(value(data, 'http_req_duration', 'p(99)'))],
+    ['응답 시간 max(ms)', format(value(data, 'http_req_duration', 'max'))],
+    ['누락된 반복(dropped_iterations)', format(value(data, 'dropped_iterations', 'count') ?? 0, 0)],
+  ];
+
+  const table = ['| 항목 | 값 |', '| --- | --- |', ...rows.map(([name, cell]) => `| ${name} | ${cell} |`)];
+  const failures =
+    failed.length === 0 ? [] : ['', '실패한 임계값', ...failed.map((entry) => `- ${entry}`)];
+
+  return [`## k6 결과: ${verdict}`, '', ...table, ...failures, ''].join('\n');
+}
+
+export function handleSummary(data: SummaryData): Record<string, string> {
+  const directory = __ENV.SUMMARY_DIR ?? '.';
+  const markdown = toMarkdown(data);
+
+  return {
+    [`${directory}/summary.json`]: JSON.stringify(data, null, 2),
+    [`${directory}/report.md`]: markdown,
+    stdout: markdown,
+  };
+}
diff --git a/Infra/k6/src/token.ts b/Infra/k6/src/token.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0171d24d7a11474d99505e43a814b56e0901e763
--- /dev/null
+++ b/Infra/k6/src/token.ts
@@ -0,0 +1,33 @@
+import { hmac } from 'k6/crypto';
+import { b64encode } from 'k6/encoding';
+import { config } from './config.ts';
+
+// 부하 테스트 전용 사용자 ID 대역. 이 값 이상의 owner_id는 정리 SQL이 테스트 데이터로 본다.
+export const LOAD_TEST_USER_ID_BASE = 900_000_000;
+
+function base64Url(input: string | ArrayBuffer): string {
+  return b64encode(input, 'rawurl');
+}
+
+// 서버(BibbidiTokenIssuer)가 만드는 Access Token과 같은 클레임을 같은 시크릿(UTF-8 바이트)으로 서명한다.
+export function signAccessToken(userId: number): string {
+  const issuedAt = Math.floor(Date.now() / 1000);
+  const header = { alg: 'HS256', typ: 'JWT' };
+  const payload = {
+    jti: `${userId}-${issuedAt}-${Math.random().toString(36).slice(2)}`,
+    iss: config.jwtIssuer,
+    aud: [config.jwtAudience],
+    sub: String(userId),
+    iat: issuedAt,
+    exp: issuedAt + config.tokenLifetimeSeconds,
+    category: 'ACCESS',
+    status: 'ACTIVE',
+    role: 'NORMAL',
+    nickname: `k6-${userId}`,
+    email: `k6-${userId}@loadtest.invalid`,
+  };
+
+  const signingInput = `${base64Url(JSON.stringify(header))}.${base64Url(JSON.stringify(payload))}`;
+  const signature = hmac('sha256', config.jwtSecret, signingInput, 'binary');
+  return `${signingInput}.${base64Url(signature)}`;
+}
