+import assert from "node:assert/strict";
+import test from "node:test";
+import { validateEnvironment } from "./cli.ts";
+import { TagCleaner, type TagRepository } from "./tag-cleaner.ts";
+
+class FakeTagRepository implements TagRepository {
+  readonly deletedNames: string[] = [];
+  private readonly names: string[];
+  private readonly failing: string[];
+
+  constructor(names: string[], failing: string[] = []) {
+    this.names = names;
+    this.failing = failing;
+  }
+
+  async listTagNames(): Promise<string[]> {
+    return this.names;
+  }
+
+  async deleteTag(name: string): Promise<void> {
+    if (this.failing.includes(name)) throw new Error("삭제 거부");
+    this.deletedNames.push(name);
+  }
+}
+
+test("k6 접두사 태그만 지우고 릴리스 태그는 남긴다", async () => {
+  const repository = new FakeTagRepository(["k6/dev/smoke-test/1", "v1.0.0", "k6/dev/smoke-test/2"]);
+
+  const result = await new TagCleaner(repository).clean({ dryRun: false });
+
+  assert.deepEqual(repository.deletedNames, ["k6/dev/smoke-test/1", "k6/dev/smoke-test/2"]);
+  assert.deepEqual(result.deleted, ["k6/dev/smoke-test/1", "k6/dev/smoke-test/2"]);
+  assert.deepEqual(result.failed, []);
+});
+
+test("모의 실행은 지울 대상만 알려 주고 실제로 지우지 않는다", async () => {
+  const repository = new FakeTagRepository(["k6/dev/smoke-test/1"]);
+
+  const result = await new TagCleaner(repository).clean({ dryRun: true });
+
+  assert.deepEqual(repository.deletedNames, []);
+  assert.deepEqual(result.deleted, ["k6/dev/smoke-test/1"]);
+  assert.equal(result.dryRun, true);
+});
+
+test("한 태그의 삭제가 실패해도 나머지는 계속 지우고 실패를 모아 알린다", async () => {
+  const repository = new FakeTagRepository(["k6/dev/smoke-test/1", "k6/dev/smoke-test/2"], ["k6/dev/smoke-test/1"]);
+
+  const result = await new TagCleaner(repository).clean({ dryRun: false });
+
+  assert.deepEqual(repository.deletedNames, ["k6/dev/smoke-test/2"]);
+  assert.deepEqual(result.failed, [{ name: "k6/dev/smoke-test/1", reason: "삭제 거부" }]);
+});
+
+test("필수 환경변수가 없으면 이름을 알려 주며 실패한다", () => {
+  assert.throws(() => validateEnvironment({ GITHUB_TOKEN: "token" }), /GITHUB_REPOSITORY/);
+});
diff --git a/.github/k6-tag-cleanup/tag-cleaner.ts b/.github/k6-tag-cleanup/tag-cleaner.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79d0f5fb11362877c212410970738727b215e512
--- /dev/null
+++ b/.github/k6-tag-cleanup/tag-cleaner.ts
@@ -0,0 +1,43 @@
+export const K6_TAG_PREFIX = "k6/";
+
+export interface TagRepository {
+  listTagNames(prefix: string): Promise<string[]>;
+  deleteTag(name: string): Promise<void>;
+}
+
+export type CleanupResult = {
+  dryRun: boolean;
+  deleted: string[];
+  failed: { name: string; reason: string }[];
+};
+
+// 부하 테스트 실행용 태그(k6/...)를 지운다. 다른 태그(v1.0.0 같은 릴리스 태그)는 건드리지 않는다.
+export class TagCleaner {
+  private readonly repository: TagRepository;
+  private readonly prefix: string;
+
+  constructor(repository: TagRepository, prefix: string = K6_TAG_PREFIX) {
+    this.repository = repository;
+    this.prefix = prefix;
+  }
+
+  async clean({ dryRun }: { dryRun: boolean }): Promise<CleanupResult> {
+    const names = (await this.repository.listTagNames(this.prefix)).filter((name) => name.startsWith(this.prefix));
+    const result: CleanupResult = { dryRun, deleted: [], failed: [] };
+
+    for (const name of names) {
+      if (dryRun) {
+        result.deleted.push(name);
+        continue;
+      }
+      try {
+        await this.repository.deleteTag(name);
+        result.deleted.push(name);
+      } catch (error) {
+        result.failed.push({ name, reason: error instanceof Error ? error.message : "알 수 없는 오류" });
+      }
+    }
+
+    return result;
+  }
+}
