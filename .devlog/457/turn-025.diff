index 0000000000000000000000000000000000000000..fef578073a387698c05dcd4ab4a0a4684788a920
--- /dev/null
+++ b/.github/k6-tag-cleanup/cli.ts
@@ -0,0 +1,38 @@
+import { pathToFileURL } from "node:url";
+import { GitHubTagRepository } from "./github-tag-repository.ts";
+import { TagCleaner } from "./tag-cleaner.ts";
+
+const requiredEnvironment = ["GITHUB_TOKEN", "GITHUB_REPOSITORY"] as const;
+
+type CleanupEnvironment = Record<(typeof requiredEnvironment)[number], string> & { DRY_RUN?: string };
+
+export function validateEnvironment(environment: NodeJS.ProcessEnv): CleanupEnvironment {
+  const missing = requiredEnvironment.filter((name) => !environment[name]?.trim());
+  if (missing.length > 0) throw new Error(`필수 환경변수가 없습니다: ${missing.join(", ")}`);
+
+  return environment as CleanupEnvironment;
+}
+
+export async function main(environment: NodeJS.ProcessEnv = process.env) {
+  try {
+    const values = validateEnvironment(environment);
+    const cleaner = new TagCleaner(new GitHubTagRepository(values.GITHUB_REPOSITORY, values.GITHUB_TOKEN));
+    const result = await cleaner.clean({ dryRun: values.DRY_RUN === "true" });
+
+    const action = result.dryRun ? "삭제 대상" : "삭제";
+    console.log(`k6 태그 ${action} ${result.deleted.length}건`);
+    for (const name of result.deleted) console.log(`- ${name}`);
+
+    if (result.failed.length > 0) {
+      for (const failure of result.failed) console.error(`::error title=k6 태그 삭제 실패::${failure.name}: ${failure.reason}`);
+      process.exitCode = 1;
+    }
+  } catch (error) {
+    const message = error instanceof Error ? error.message : "알 수 없는 오류가 발생했습니다.";
+    console.error(`::error title=k6 태그 정리 실패::${message}`);
+    process.exitCode = 1;
+  }
+}
+
+const entrypoint = process.argv[1] ? pathToFileURL(process.argv[1]).href : "";
+if (entrypoint === import.meta.url) await main();
diff --git a/.github/k6-tag-cleanup/github-tag-repository.ts b/.github/k6-tag-cleanup/github-tag-repository.ts
