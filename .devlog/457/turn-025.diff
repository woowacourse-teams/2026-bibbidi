+name: 비비디 k6 태그 정리
+
+on:
+  # 스케줄은 default 브랜치(main)의 파일 기준으로 동작한다. 매주 월요일 03:00(KST)에 지운다.
+  schedule:
+    - cron: "0 18 * * 0"
+  workflow_dispatch:
+    inputs:
+      dry-run:
+        description: 지우지 않고 대상만 확인한다
+        type: boolean
+        default: true
+
+# 태그 삭제에 쓰기 권한이 필요하다.
+permissions:
+  contents: write
+
+concurrency:
+  group: k6-tag-cleanup
+  cancel-in-progress: false
+
+jobs:
+  cleanup:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    steps:
+      - uses: actions/checkout@v7
+
+      - uses: actions/setup-node@v6
+        with:
+          node-version: 24.19.0
+
+      - name: 정리 코드 테스트
+        run: node --experimental-strip-types --test .github/k6-tag-cleanup/*.test.ts
+
+      - name: k6 태그 지우기
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+          DRY_RUN: ${{ inputs.dry-run && 'true' || 'false' }}
+        run: node --experimental-strip-types .github/k6-tag-cleanup/cli.ts
