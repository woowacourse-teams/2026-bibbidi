diff --git a/BE/src/test/java/com/bibbidi/wedding/catalog/domain/CatalogTest.java b/BE/src/test/java/com/bibbidi/wedding/catalog/domain/CatalogTest.java
index a020ed382713905624ee028bb6766a5d69e02e87..8671eb05814d28882c09402b16686340ef23688c 100644
--- a/BE/src/test/java/com/bibbidi/wedding/catalog/domain/CatalogTest.java
+++ b/BE/src/test/java/com/bibbidi/wedding/catalog/domain/CatalogTest.java
@@ -32,4 +32,82 @@ class CatalogTest {
                 .extracting(Item::id)
                 .containsExactly(1L, 2L);
     }
+
+    @Test
+    @DisplayName("담은 항목 중 가장 큰 단계 이하의 항목을 카테고리 구분 없이 추천한다")
+    void shouldRecommendItemsUpToHighestAddedPhaseAcrossCategories() {
+        // given
+        Catalog catalog = constructPhasedCatalog();
+
+        // when
+        Catalog recommended = catalog.recommendFor(List.of(3L));
+
+        // then
+        assertThat(itemIdsOf(recommended)).containsExactly(1L, 2L, 5L, 6L);
+    }
+
+    @Test
+    @DisplayName("이미 담은 항목은 추천하지 않는다")
+    void shouldNotRecommendAddedItems() {
+        // given
+        Catalog catalog = constructPhasedCatalog();
+
+        // when
+        Catalog recommended = catalog.recommendFor(List.of(1L, 4L));
+
+        // then
+        assertThat(itemIdsOf(recommended)).containsExactly(2L, 3L, 5L, 6L, 7L);
+    }
+
+    @Test
+    @DisplayName("담은 항목이 없으면 단계 제한 없이 모든 항목을 추천한다")
+    void shouldRecommendAllItemsWhenNothingAdded() {
+        // given
+        Catalog catalog = constructPhasedCatalog();
+
+        // when
+        Catalog recommended = catalog.recommendFor(List.of());
+
+        // then
+        assertThat(itemIdsOf(recommended)).containsExactly(1L, 2L, 3L, 4L, 5L, 6L, 7L);
+    }
+
+    @Test
+    @DisplayName("가장 큰 단계 이하의 항목을 모두 담았으면 추천할 항목이 없다")
+    void shouldRecommendNothingWhenEveryItemUpToHighestPhaseIsAdded() {
+        // given
+        Catalog catalog = constructPhasedCatalog();
+
+        // when
+        Catalog recommended = catalog.recommendFor(List.of(1L, 2L, 5L));
+
+        // then
+        assertThat(itemIdsOf(recommended)).isEmpty();
+    }
+
+    private static Catalog constructPhasedCatalog() {
+        Category weddingHall = new Category(1L, "웨딩홀", 1, List.of(
+                new Step(1L, "웨딩홀 정하기", null, null, 1, List.of(item(1L), item(2L))),
+                new Step(2L, "예식 진행 방식 결정", null, null, 2, List.of(item(3L))),
+                new Step(3L, "예식 진행 인원 섭외", null, null, 3, List.of(item(4L)))
+        ));
+        Category invitation = new Category(2L, "초대", 2, List.of(
+                new Step(4L, "하객 명단 작성", null, null, 1, List.of(item(5L))),
+                new Step(5L, "청첩장 내용 정하기", null, null, 2, List.of(item(6L))),
+                new Step(6L, "청첩장 주문", null, null, 3, List.of(item(7L)))
+        ));
+        return new Catalog(List.of(weddingHall, invitation));
+    }
+
+    private static Item item(Long id) {
+        return new Item(id, "할 일 " + id, id.intValue(), true);
+    }
+
+    private static List<Long> itemIdsOf(Catalog catalog) {
+        return catalog.categories().stream()
+                .flatMap(category -> category.steps().stream())
+                .flatMap(step -> step.items().stream())
+                .map(Item::id)
+                .toList();
+    }
 }
