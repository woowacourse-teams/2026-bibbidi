@@ -0,0 +1,43 @@
+package com.bibbidi.wedding.chat.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.bibbidi.wedding.chat.adapter.ai.BibbidiInMemoryChatMemory;
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.springframework.ai.chat.memory.InMemoryChatMemoryRepository;
+import org.springframework.ai.chat.messages.AssistantMessage;
+import org.springframework.ai.chat.messages.Message;
+import org.springframework.ai.chat.messages.UserMessage;
+
+class AiChatConfigTest {
+
+    private static final String CONVERSATION = "7:conversation-a";
+    private static final int MEMORY_MAX_MESSAGES = 20;
+    private static final int FIXED_MESSAGES = 2;
+
+    @Test
+    @DisplayName("전체 메시지 한도에서 고정 정보 2개를 뺀 최근 대화만 기억한다")
+    void keepsOnlyTheRecentMessagesLeftAfterTheFixedContext() {
+        // given
+        BibbidiInMemoryChatMemory memory = new AiChatConfig().aiChatMemory(
+                new InMemoryChatMemoryRepository(),
+                new AiChatProperties(MEMORY_MAX_MESSAGES, Duration.ofHours(1), Duration.ofMinutes(10)));
+        List<Message> messages = new ArrayList<>();
+        for (int turn = 1; turn <= MEMORY_MAX_MESSAGES; turn++) {
+            messages.add(new UserMessage("질문 " + turn));
+            messages.add(new AssistantMessage("답변 " + turn));
+        }
+
+        // when
+        memory.add(CONVERSATION, messages);
+
+        // then
+        List<Message> remembered = memory.get(CONVERSATION);
+        assertThat(remembered).hasSize(MEMORY_MAX_MESSAGES - FIXED_MESSAGES);
+        assertThat(remembered.getLast().getText()).isEqualTo("답변 " + MEMORY_MAX_MESSAGES);
+    }
+}
