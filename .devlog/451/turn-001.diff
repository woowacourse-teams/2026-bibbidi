@@ -0,0 +1,40 @@
+package com.bibbidi.wedding.chat.config;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.PositiveOrZero;
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Optional;
+import org.springframework.boot.context.properties.ConfigurationProperties;
+import org.springframework.validation.annotation.Validated;
+
+@Validated
+@ConfigurationProperties("bibbidi.ai.pricing")
+public record AiPricing(
+        @NotNull List<@Valid ModelPrice> models
+) {
+
+    private static final BigDecimal ONE_MILLION = BigDecimal.valueOf(1_000_000);
+
+    public Optional<ModelPrice> find(String modelName) {
+        return models.stream()
+                .filter(price -> price.name().equals(modelName))
+                .findFirst();
+    }
+
+    public record ModelPrice(
+            @NotBlank String name,
+            @NotNull @PositiveOrZero BigDecimal inputPerMillionTokens,
+            @NotNull @PositiveOrZero BigDecimal outputPerMillionTokens
+    ) {
+
+        public double costUsd(long inputTokens, long outputTokens) {
+            return inputPerMillionTokens.multiply(BigDecimal.valueOf(inputTokens))
+                    .add(outputPerMillionTokens.multiply(BigDecimal.valueOf(outputTokens)))
+                    .divide(ONE_MILLION)
+                    .doubleValue();
+        }
+    }
+}
