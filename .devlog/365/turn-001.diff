+    });
+    fireEvent.pointerDown(card, { ...pointer, clientX: 180, clientY: 100 });
+    fireEvent.pointerUp(card, { ...pointer, clientX: 100, clientY: 100 });
+    expect(screen.getByText("추천 할 일을 모두 확인했어요.")).toBeTruthy();
+  });
