+    unmount();
+    render(<AiChatFeature />);
+    fireEvent.click(screen.getByRole("button", { name: "AI 채팅 열기" }));
+    expect(screen.queryByRole("log")).toBeNull();
+    expect((screen.getByRole("textbox") as HTMLTextAreaElement).value).toBe("");
+  });
+});
