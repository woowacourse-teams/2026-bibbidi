+
+.social-login-form__button--apple {
+  background: #000000;
+  color: #ffffff;
+}
+
+.social-login-form__icon {
+  display: inline-flex;
+  width: 22px;
+  height: 22px;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+}
+
+.social-login-form__icon svg {
+  display: block;
+  width: 100%;
+  height: 100%;
