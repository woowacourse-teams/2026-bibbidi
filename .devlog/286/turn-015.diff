+  background: var(--color-bg-layer-default);
+  box-shadow:
+    0 24px 64px rgb(103 75 55 / 10%),
+    0 4px 16px rgb(103 75 55 / 6%);
+  padding: 48px 44px 40px;
+}
+
+.social-login-form__intro {
+  margin-bottom: 32px;
+}
+
+.social-login-form__headline {
+  display: flex;
+  flex-direction: column;
+  gap: 2px;
+  margin: 0 0 28px;
+  color: var(--color-fg-neutral);
+  font-size: clamp(25px, 3vw, 31px);
+  font-weight: 800;
+  line-height: 1.32;
+  letter-spacing: -0.045em;
+}
+
+.social-login-form__brand {
+  color: var(--color-fg-neutral);
+  font-family: "Nunito", sans-serif;
+  font-size: 1.42em;
+  font-weight: 950;
+  line-height: 1.08;
+  letter-spacing: -0.065em;
+}
+
+.social-login-form__title {
+  margin: 0;
+  color: var(--color-fg-neutral);
+  font-size: 19px;
+  font-weight: 800;
+  line-height: 1.4;
+  letter-spacing: -0.03em;
+}
+
+.social-login-form__buttons {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.social-login-form__button {
+  display: flex;
+  width: 100%;
+  height: 52px;
+  align-items: center;
+  justify-content: center;
+  gap: 12px;
+  border: 1px solid transparent;
+  border-radius: 10px;
+  cursor: pointer;
+  font: inherit;
+  font-size: 15px;
+  font-weight: 700;
+  line-height: 1;
+  padding: 0 20px;
+  transition:
+    background-color 120ms ease,
