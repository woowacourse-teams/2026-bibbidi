+package com.bibbidi.wedding.chat.evaluation.data.metric;
+
+import java.util.List;
+import java.util.Map;
+
+/** 무엇을 어떤 기준으로 평가하는지와 그 출처. */
+final class Criterion {
+
+    private final String task;
+    private final String rubric;
+    private final String source;
+
+    Criterion(String task, String rubric, String source) {
+        this.task = task;
+        this.rubric = rubric;
+        this.source = source;
+    }
+
+    Map<String, Object> variables() {
+        return Map.of("task", task, "rubric", rubric);
+    }
+
+    List<String> violations() {
+        if (blank(task) || blank(rubric) || blank(source)) {
+            return List.of("task, rubric, source는 비어 있을 수 없다");
+        }
+        return List.of();
+    }
+
+    private boolean blank(String value) {
+        return value == null || value.isBlank();
+    }
+}
