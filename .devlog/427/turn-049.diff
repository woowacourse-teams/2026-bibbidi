+package com.bibbidi.wedding.chat.evaluation.data.metric;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.stream.Collectors;
+
+/** 프롬프트를 어떻게 배치하는지. 입력 데이터로 넣을 항목과 순서, 구역의 순서를 안다. */
+final class PromptLayout {
+
+    private static final String SECTION_SEPARATOR = "\n\n";
+    private static final String INPUT_SEPARATOR = "\n";
+
+    private final List<EvaluationInput> inputs;
+    private final List<PromptSection> order;
+
+    PromptLayout(List<EvaluationInput> inputs, List<PromptSection> order) {
+        this.inputs = inputs;
+        this.order = order;
+    }
+
+    String render(SectionTemplate template, Map<String, Object> variables, InputSource source) {
+        Map<String, Object> all = new HashMap<>(variables);
+        all.put("input", input(source));
+        return order.stream()
+                .map(section -> template.render(section, all))
+                .collect(Collectors.joining(SECTION_SEPARATOR));
+    }
+
+    List<String> violations() {
+        List<String> violations = new ArrayList<>();
+        if (inputs == null
+                || !inputs.contains(EvaluationInput.USER_MESSAGE)
+                || !inputs.contains(EvaluationInput.MODEL_RESPONSE)) {
+            violations.add("requiredInputs에는 userMessage와 modelResponse가 있어야 한다");
+        } else if (new HashSet<>(inputs).size() != inputs.size()) {
+            violations.add("requiredInputs에 같은 항목이 중복됐다");
+        }
+        if (order == null
+                || order.size() != PromptSection.values().length
+                || new HashSet<>(order).size() != order.size()
+                || order.getLast() != PromptSection.INPUT) {
+            violations.add("promptOrder는 role, task, rubric, input을 한 번씩 담고 input으로 끝나야 한다");
+        }
+        return violations;
+    }
+
+    private String input(InputSource source) {
+        return inputs.stream()
+                .map(input -> source.text(input).map(input::wrap))
+                .flatMap(Optional::stream)
+                .collect(Collectors.joining(INPUT_SEPARATOR));
+    }
+}
