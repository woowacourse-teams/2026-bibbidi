+package com.bibbidi.wedding.chat.evaluation.data.metric;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+/** 점수를 매기는 척도. 허용하는 점수 단계, 점수 방향, 보고서 기록 전용 여부를 함께 안다. */
+final class Scale {
+
+    private final List<ScaleLevel> levels;
+    private final String direction;
+    private final boolean reportOnly;
+
+    Scale(List<ScaleLevel> levels, String direction, boolean reportOnly) {
+        this.levels = levels;
+        this.direction = direction;
+        this.reportOnly = reportOnly;
+    }
+
+    boolean accepts(int score) {
+        return levels.stream().anyMatch(level -> level.accepts(score));
+    }
+
+    Map<String, Object> variables() {
+        return Map.of(
+                "direction", direction,
+                "scale", levels.stream().map(ScaleLevel::describe).collect(Collectors.joining("\n")));
+    }
+
+    Map<String, Object> attributes() {
+        return Map.of("direction", direction, "reportOnly", reportOnly);
+    }
+
+    List<String> violations() {
+        List<String> violations = new ArrayList<>();
+        if (levels == null || levels.size() < 2) {
+            violations.add("척도는 두 단계 이상이어야 한다");
+        } else {
+            for (int i = 0; i < levels.size(); i++) {
+                ScaleLevel level = levels.get(i);
+                if (level.undefined()) {
+                    violations.add("척도 " + level.name() + "의 뜻이 비어 있다");
+                }
+                for (int j = i + 1; j < levels.size(); j++) {
+                    if (level.sameScoreAs(levels.get(j))) {
+                        violations.add("척도 값 중복 " + level.name());
+                    }
+                }
+            }
+        }
+        if (direction == null || direction.isBlank()) {
+            violations.add("direction은 비어 있을 수 없다");
+        }
+        return violations;
+    }
+}
