+import com.fasterxml.jackson.annotation.JsonCreator;
+import com.fasterxml.jackson.annotation.JsonProperty;
+
+/** 채점 척도의 한 단계. 점수 값 하나와 그 뜻이다. */
+public final class ScaleLevel {
+
+    private final int score;
+    private final String definition;
+
+    @JsonCreator
+    public ScaleLevel(@JsonProperty("value") int score, @JsonProperty("definition") String definition) {
+        this.score = score;
+        this.definition = definition;
+    }
+
+    boolean accepts(int other) {
+        return score == other;
+    }
+
+    boolean sameScoreAs(ScaleLevel other) {
+        return score == other.score;
+    }
+
+    boolean undefined() {
+        return definition == null || definition.isBlank();
+    }
+
+    String describe() {
+        return score + ": " + definition;
+    }
+
+    String name() {
+        return String.valueOf(score);
+    }
+}
