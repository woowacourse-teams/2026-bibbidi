index 0000000000000000000000000000000000000000..63337e42cc17b43d8f155bb0fe1d17b3961fcead
--- /dev/null
+++ b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/CodexCliBibbidiJudge.java
@@ -0,0 +1,130 @@
+package com.bibbidi.wedding.chat.evaluation;
+
+import com.bibbidi.wedding.chat.evaluation.data.MetricInformation;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.time.Duration;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+import org.springframework.ai.chat.prompt.Prompt;
+import org.springframework.ai.evaluation.EvaluationResponse;
+import org.springframework.core.io.ClassPathResource;
+import tools.jackson.databind.ObjectMapper;
+
+public class CodexCliBibbidiJudge implements BibbidiJudge {
+
+    private static final String RESULT_SCHEMA = "ai-evaluation/schema/judge-result.json";
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+    private final String executable;
+    private final String model;
+    private final String reasoningEffort;
+    private final Duration timeout;
+
+    public CodexCliBibbidiJudge(String model, String reasoningEffort, Duration timeout) {
+        this(System.getProperty("os.name").startsWith("Windows") ? "codex.cmd" : "codex",
+                model, reasoningEffort, timeout);
+    }
+
+    public CodexCliBibbidiJudge(String executable, String model, String reasoningEffort, Duration timeout) {
+        this.executable = executable;
+        this.model = model;
+        this.reasoningEffort = reasoningEffort;
+        this.timeout = timeout;
+    }
+
+    @Override
+    public EvaluationResponse evaluate(Prompt prompt, MetricInformation metric, String scenarioName) {
+        try {
+            return parseResult(runCodex(prompt), metric, scenarioName);
+        } catch (IOException exception) {
+            throw new IllegalStateException("Codex judge output could not be read", exception);
+        } catch (InterruptedException exception) {
+            Thread.currentThread().interrupt();
+            throw new IllegalStateException("Codex judge execution was interrupted", exception);
+        }
+    }
+
+    EvaluationResponse parseResult(String json, MetricInformation metric, String scenarioName) {
+        JudgeResult result = objectMapper.readValue(json, JudgeResult.class);
+        if (!scenarioName.equals(result.scenarioName()) || !metric.metricType().equals(result.metricType())) {
+            throw new IllegalStateException("Codex judge returned a different scenario or metric");
+        }
+        if (result.reason() == null || result.reason().isBlank()) {
+            throw new IllegalStateException("Codex judge returned an empty reason");
+        }
+        if ("unscorable".equals(result.status()) && result.score() == null) {
+            throw new UnscorableException(result.reason());
+        }
+        if (!"scored".equals(result.status())) {
+            throw new IllegalStateException("Codex judge returned an invalid status or score combination");
+        }
+        if (result.score() == null || metric.scale().stream()
+                .noneMatch(level -> level.value() == result.score())) {
+            throw new IllegalStateException("Codex judge returned a score outside the metric scale");
+        }
+        return new EvaluationResponse(false, result.score(), result.reason(), Map.of(
+                "scenarioName", scenarioName,
+                "metricType", metric.metricType(),
+                "rawScore", result.score(),
+                "scale", metric.scale(),
+                "direction", metric.direction(),
+                "qualityPassDetermined", false,
+                "judgeModel", model,
+                "reasoningEffort", reasoningEffort));
+    }
+
+    private String runCodex(Prompt prompt) throws IOException, InterruptedException {
+        Path directory = Files.createTempDirectory("bibbidi-judge-");
+        Path schema = directory.resolve("schema.json");
+        Path answer = directory.resolve("answer.json");
+        try {
+            try (InputStream input = new ClassPathResource(RESULT_SCHEMA).getInputStream()) {
+                Files.copy(input, schema);
+            }
+            Process process = new ProcessBuilder(
+                    executable, "exec", "--ephemeral", "--ignore-user-config", "--ignore-rules",
+                    "--sandbox", "read-only", "--model", model,
+                    "--config", "model_reasoning_effort=" + reasoningEffort,
+                    "--output-schema", schema.toString(),
+                    "--output-last-message", answer.toString(), "-")
+                    .redirectOutput(ProcessBuilder.Redirect.DISCARD)
+                    .redirectError(ProcessBuilder.Redirect.DISCARD)
+                    .start();
+            try (OutputStream input = process.getOutputStream()) {
+                input.write(prompt.getContents().getBytes(StandardCharsets.UTF_8));
+            }
+            try {
+                if (!process.waitFor(timeout.toMillis(), TimeUnit.MILLISECONDS)) {
+                    process.destroyForcibly().onExit().join();
+                    throw new IllegalStateException("Codex judge timed out");
+                }
+            } catch (InterruptedException exception) {
+                process.destroyForcibly().onExit().join();
+                throw exception;
+            }
+            if (process.exitValue() != 0) {
+                throw new IllegalStateException("Codex judge exited with code " + process.exitValue());
+            }
+            return Files.readString(answer, StandardCharsets.UTF_8);
+        } finally {
+            Files.deleteIfExists(answer);
+            Files.deleteIfExists(schema);
+            Files.deleteIfExists(directory);
+        }
+    }
+
+    public static class UnscorableException extends RuntimeException {
+
+        public UnscorableException(String reason) {
+            super(reason);
+        }
+    }
+
+    private record JudgeResult(String scenarioName, String metricType, String status, Integer score, String reason) {
+    }
+}
