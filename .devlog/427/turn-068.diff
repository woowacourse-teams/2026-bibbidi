+package com.bibbidi.wedding.chat.evaluation;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.bibbidi.wedding.chat.evaluation.data.EvaluationDataLoader;
+import java.io.IOException;
+import java.time.Duration;
+import org.junit.jupiter.api.Test;
+
+class CodexCliBibbidiJudgeTest {
+
+    private final CodexCliBibbidiJudge judge =
+            new CodexCliBibbidiJudge("codex", "test-model", "high", Duration.ofSeconds(1));
+
+    @Test
+    void keepsRawScoreWithoutDeclaringQualityPass() throws IOException {
+        var metric = new EvaluationDataLoader().loadMetrics().stream()
+                .filter(candidate -> candidate.metricType().equals("Correctness"))
+                .findFirst().orElseThrow();
+
+        var response = judge.parseResult("""
+                {"scenarioName":"scenario01","metricType":"Correctness", "status":"scored", "score":4,"reason":"근거와 일치"}
+                """, metric, "scenario01");
+
+        assertThat(response.getScore()).isEqualTo(4.0f);
+        assertThat(response.getFeedback()).isEqualTo("근거와 일치");
+        assertThat(response.getMetadata()).containsEntry("qualityPassDetermined", false);
+    }
+
+    @Test
+    void keepsUnscorableSeparateFromZeroScore() throws IOException {
+        var metric = new EvaluationDataLoader().loadMetrics().getFirst();
+
+        assertThatThrownBy(() -> judge.parseResult("""
+                {"scenarioName":"scenario01","metricType":"%s", "status":"unscorable", "score":null,"reason":"조회 결과 없음"}
+                """.formatted(metric.metricType()), metric, "scenario01"))
+                .isInstanceOf(CodexCliBibbidiJudge.UnscorableException.class)
+                .hasMessage("조회 결과 없음");
+    }
+
+    @Test
+    void rejectsScoresOutsideTheMetricScale() throws IOException {
+        var metric = new EvaluationDataLoader().loadMetrics().stream()
+                .filter(candidate -> candidate.metricType().equals("Refusal"))
+                .findFirst().orElseThrow();
+
+        assertThatThrownBy(() -> judge.parseResult("""
+                {"scenarioName":"scenario01","metricType":"Refusal", "status":"scored", "score":4,"reason":"거부함"}
+                """, metric, "scenario01"))
+                .isInstanceOf(IllegalStateException.class)
+                .hasMessageContaining("outside the metric scale");
+    }
+}
