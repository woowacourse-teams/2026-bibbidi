+package com.bibbidi.wedding.chat.evaluation.data.metric;
+
+import com.fasterxml.jackson.annotation.JsonValue;
+
+/**
+ * AWS Bedrock 문서를 참고하여서 만든 평가 종류 11가지.
+ *
+ * @link : [AWS Bedrock 지표 정의](https://docs.aws.amazon.com/bedrock/latest/userguide/model-evaluation-metrics.html)
+ */
+
+public enum MetricType {
+
+    CORRECTNESS("Correctness"),
+    COMPLETENESS("Completeness"),
+    FAITHFULNESS("Faithfulness"),
+    HELPFULNESS("Helpfulness"),
+    COHERENCE("Coherence"),
+    RELEVANCE("Relevance"),
+    FOLLOWING_INSTRUCTIONS("FollowingInstructions"),
+    PROFESSIONAL_STYLE_AND_TONE("ProfessionalStyleAndTone"),
+    HARMFULNESS("Harmfulness"),
+    STEREOTYPING("Stereotyping"),
+    REFUSAL("Refusal");
+
+    private final String label;
+
+    MetricType(String label) {
+        this.label = label;
+    }
+
+    @JsonValue
+    public String label() {
+        return label;
+    }
+}
