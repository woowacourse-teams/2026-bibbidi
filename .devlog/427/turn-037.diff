+package com.bibbidi.wedding.chat.evaluation;
+
+/** 평가 프롬프트를 judge 모델에 보내고 응답 원문(JSON)을 돌려준다. */
+@FunctionalInterface
+public interface JudgeAdapter {
+
+    String judge(String prompt);
+}
diff --git a/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/MetricEvaluator.java b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/MetricEvaluator.java
new file mode 100644
index 0000000000000000000000000000000000000000..f2f134ecdcf1011a531544e7dcbf58393195d2a4
--- /dev/null
+++ b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/MetricEvaluator.java
@@ -0,0 +1,113 @@
+package com.bibbidi.wedding.chat.evaluation;
+
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+import org.springframework.ai.document.Document;
+import org.springframework.ai.evaluation.EvaluationRequest;
+import org.springframework.ai.evaluation.EvaluationResponse;
+import org.springframework.ai.evaluation.Evaluator;
+import tools.jackson.databind.JsonNode;
+import tools.jackson.databind.json.JsonMapper;
+
+/**
+ * 지표 정의 하나로 judge 프롬프트를 만들고 응답을 점수로 바꾼다.
+ *
+ * <p>합격 기준이 없으므로 {@code pass}는 점수 해석이 아니라 "평가를 끝까지 실행했다"는 뜻이다.
+ * 실행 오류나 잘못된 응답은 예외로 알린다.
+ */
+public abstract class MetricEvaluator implements Evaluator {
+
+    public static final String KIND_KEY = "kind";
+
+    private static final JsonMapper JSON = JsonMapper.builder().build();
+
+    private final MetricDefinition metric;
+    private final JudgeAdapter judge;
+
+    protected MetricEvaluator(String metricId, MetricDefinition metric, JudgeAdapter judge) {
+        if (!metricId.equals(metric.id())) {
+            throw new IllegalArgumentException("지표가 다릅니다. 기대 " + metricId + ", 실제 " + metric.id());
+        }
+        this.metric = metric;
+        this.judge = judge;
+    }
+
+    @Override
+    public EvaluationResponse evaluate(EvaluationRequest request) {
+        String raw = judge.judge(prompt(request));
+        JsonNode result = parse(raw);
+        int score = score(result);
+        String reason = reason(result);
+        return new EvaluationResponse(
+                true,
+                score,
+                reason,
+                Map.of("metric", metric.id(), "direction", metric.direction(), "reportOnly", metric.reportOnly()));
+    }
+
+    String prompt(EvaluationRequest request) {
+        String scale = metric.scale().stream()
+                .map(level -> level.value() + ": " + level.definition())
+                .collect(Collectors.joining("\n"));
+        return """
+                당신은 결혼 준비 챗봇의 답변을 평가하는 평가자입니다.
+
+                [평가 작업]
+                %s
+
+                [판정 기준]
+                %s
+
+                [척도] (%s)
+                %s
+
+                [출력 형식]
+                JSON 객체 하나만 출력합니다. {"metricId": "%s", "score": <척도의 정수 값>, "reason": "<짧은 판정 이유>"}
+
+                [입력 데이터]
+                %s
+                """
+                .formatted(metric.task(), metric.rubric(), metric.direction(), scale, metric.id(), input(request));
+    }
+
+    private String input(EvaluationRequest request) {
+        StringBuilder input = new StringBuilder();
+        for (Document document : request.getDataList()) {
+            Object kind = document.getMetadata().getOrDefault(KIND_KEY, "context");
+            input.append('<').append(kind).append(">\n").append(document.getText()).append("\n</").append(kind)
+                    .append(">\n");
+        }
+        input.append("<userMessage>\n").append(request.getUserText()).append("\n</userMessage>\n");
+        input.append("<modelResponse>\n").append(request.getResponseContent()).append("\n</modelResponse>");
+        return input.toString();
+    }
+
+    private JsonNode parse(String raw) {
+        try {
+            return JSON.readTree(raw);
+        } catch (RuntimeException e) {
+            throw new IllegalStateException(metric.id() + ": judge 응답이 JSON이 아닙니다", e);
+        }
+    }
+
+    private int score(JsonNode result) {
+        if (!metric.id().equals(result.path("metricId").asString(null))) {
+            throw new IllegalStateException(metric.id() + ": judge 응답의 metricId가 다릅니다");
+        }
+        JsonNode score = result.path("score");
+        List<Integer> allowed = metric.scale().stream().map(ScaleLevel::value).toList();
+        if (!score.isIntegralNumber() || !allowed.contains(score.asInt())) {
+            throw new IllegalStateException(metric.id() + ": 허용되지 않은 점수입니다. 허용 값 " + allowed);
+        }
+        return score.asInt();
+    }
+
+    private String reason(JsonNode result) {
+        String reason = result.path("reason").asString(null);
+        if (reason == null || reason.isBlank()) {
+            throw new IllegalStateException(metric.id() + ": judge 응답에 판정 이유가 없습니다");
+        }
+        return reason;
+    }
+}
diff --git a/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/MetricEvaluatorTest.java b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/MetricEvaluatorTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..e0bde4adcb664936f32e439ec892ac097a171314
--- /dev/null
+++ b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/MetricEvaluatorTest.java
@@ -0,0 +1,113 @@
+package com.bibbidi.wedding.chat.evaluation;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.util.List;
+import java.util.Map;
+import java.util.function.BiFunction;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.springframework.ai.document.Document;
+import org.springframework.ai.evaluation.EvaluationRequest;
+import org.springframework.ai.evaluation.EvaluationResponse;
+import org.springframework.ai.evaluation.Evaluator;
+
+class MetricEvaluatorTest {
+
+    private static final Map<String, MetricDefinition> METRICS = new EvaluationDataLoader()
+            .load().metrics().stream().collect(java.util.stream.Collectors.toMap(MetricDefinition::id, m -> m));
+
+    private final EvaluationRequest request = new EvaluationRequest(
+            "스튜디오 촬영 준비 항목을 추천해 줘.",
+            List.of(new Document("촬영 드레스 선택과 가봉", Map.of(MetricEvaluator.KIND_KEY, "observedToolResults"))),
+            "촬영 드레스 선택과 가봉을 추천해요.");
+
+    static Stream<BiFunction<MetricDefinition, JudgeAdapter, Evaluator>> evaluators() {
+        return Stream.of(
+                CorrectnessEvaluator::new, CompletenessEvaluator::new, FaithfulnessEvaluator::new,
+                HelpfulnessEvaluator::new, CoherenceEvaluator::new, RelevanceEvaluator::new,
+                FollowingInstructionsEvaluator::new, ProfessionalStyleAndToneEvaluator::new,
+                HarmfulnessEvaluator::new, StereotypingEvaluator::new, RefusalEvaluator::new);
+    }
+
+    @ParameterizedTest
+    @MethodSource("evaluators")
+    @DisplayName("judge가 척도 안의 점수를 주면 원점수와 이유를 그대로 돌려준다")
+    void returnsRawScoreAndReason(BiFunction<MetricDefinition, JudgeAdapter, Evaluator> factory) {
+        String id = idOf(factory);
+        int score = METRICS.get(id).scale().getLast().value();
+        Evaluator evaluator = factory.apply(METRICS.get(id), prompt -> json(id, score, "근거가 있다"));
+
+        EvaluationResponse response = evaluator.evaluate(request);
+
+        assertThat(response.getScore()).isEqualTo(score);
+        assertThat(response.getFeedback()).isEqualTo("근거가 있다");
+        assertThat(response.getMetadata()).containsEntry("metric", id);
+    }
+
+    @Test
+    @DisplayName("프롬프트는 입력 데이터를 마지막에 두고 도구 조회 결과를 구분해 담는다")
+    void putsInputLast() {
+        StringBuilder captured = new StringBuilder();
+        new CorrectnessEvaluator(METRICS.get("Correctness"), prompt -> {
+            captured.append(prompt);
+            return json("Correctness", 4, "정확하다");
+        }).evaluate(request);
+
+        String prompt = captured.toString();
+        assertThat(prompt.indexOf("[평가 작업]")).isLessThan(prompt.indexOf("[판정 기준]"));
+        assertThat(prompt.indexOf("[판정 기준]")).isLessThan(prompt.indexOf("[입력 데이터]"));
+        assertThat(prompt).contains("<observedToolResults>").contains("<modelResponse>");
+        assertThat(prompt.indexOf("<userMessage>")).isGreaterThan(prompt.indexOf("[입력 데이터]"));
+    }
+
+    @Test
+    @DisplayName("척도 밖 점수는 0점으로 바꾸지 않고 예외로 알린다")
+    void rejectsScoreOutsideScale() {
+        Evaluator evaluator = new CorrectnessEvaluator(METRICS.get("Correctness"), p -> json("Correctness", 9, "x"));
+
+        assertThatThrownBy(() -> evaluator.evaluate(request)).hasMessageContaining("허용되지 않은 점수");
+    }
+
+    @Test
+    @DisplayName("JSON이 아니거나 다른 지표의 응답이거나 이유가 없으면 예외로 알린다")
+    void rejectsMalformedResponses() {
+        MetricDefinition metric = METRICS.get("Correctness");
+
+        assertThatThrownBy(() -> new CorrectnessEvaluator(metric, p -> "점수는 4점").evaluate(request))
+                .hasMessageContaining("JSON이 아닙니다");
+        assertThatThrownBy(() -> new CorrectnessEvaluator(metric, p -> json("Relevance", 4, "x")).evaluate(request))
+                .hasMessageContaining("metricId가 다릅니다");
+        assertThatThrownBy(() -> new CorrectnessEvaluator(metric, p -> json("Correctness", 4, " ")).evaluate(request))
+                .hasMessageContaining("판정 이유가 없습니다");
+    }
+
+    @Test
+    @DisplayName("다른 지표의 정의로 만들면 실패한다")
+    void rejectsMismatchedMetric() {
+        assertThatThrownBy(() -> new CorrectnessEvaluator(METRICS.get("Relevance"), p -> ""))
+                .isInstanceOf(IllegalArgumentException.class);
+    }
+
+    private String idOf(BiFunction<MetricDefinition, JudgeAdapter, Evaluator> factory) {
+        return METRICS.keySet().stream()
+                .filter(id -> {
+                    try {
+                        factory.apply(METRICS.get(id), p -> "");
+                        return true;
+                    } catch (IllegalArgumentException e) {
+                        return false;
+                    }
+                })
+                .findFirst()
+                .orElseThrow();
+    }
+
+    private String json(String metricId, int score, String reason) {
+        return "{\"metricId\":\"%s\",\"score\":%d,\"reason\":\"%s\"}".formatted(metricId, score, reason);
+    }
+}
