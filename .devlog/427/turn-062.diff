+package com.bibbidi.wedding.chat.evaluation;
+
+import com.bibbidi.wedding.chat.evaluation.data.EvaluationScenario;
+import com.bibbidi.wedding.chat.evaluation.data.MetricInformation;
+import java.util.stream.Collectors;
+import org.springframework.ai.document.Document;
+import org.springframework.ai.evaluation.EvaluationRequest;
+import org.springframework.ai.evaluation.EvaluationResponse;
+import org.springframework.ai.evaluation.Evaluator;
+
+public class BibbidiEvaluator implements Evaluator {
+
+    private final MetricInformation metric;
+    private final EvaluationScenario scenario;
+    private final Judge judge;
+
+    public BibbidiEvaluator(MetricInformation metric, EvaluationScenario scenario, Judge judge) {
+        this.metric = metric;
+        this.scenario = scenario;
+        this.judge = judge;
+    }
+
+    @Override
+    public EvaluationResponse evaluate(EvaluationRequest request) {
+        StringBuilder prompt = new StringBuilder()
+                .append(metric.role()).append("\n\n")
+                .append(metric.task()).append("\n\n")
+                .append(metric.rubric()).append("\n")
+                .append("점수 척도 (").append(metric.direction()).append("):\n");
+
+        for (MetricInformation.ScoreLevel level : metric.scale()) {
+            prompt.append(level.value()).append(": ").append(level.definition()).append("\n");
+        }
+
+        prompt.append("\n시나리오 이름: ").append(scenario.name()).append("\n")
+                .append("지표: ").append(metric.metricType()).append("\n")
+                .append("JSON으로 시나리오 이름, 지표, 척도에 포함된 점수, 짧은 판정 이유를 반환한다.\n\n")
+                .append("입력 데이터:\n");
+        for (String input : metric.requiredInputs()) {
+            prompt.append(input).append(":\n").append(inputValue(input, request)).append("\n\n");
+        }
+
+        return judge.evaluate(prompt.toString());
+    }
+
+    private String inputValue(String input, EvaluationRequest request) {
+        return switch (input) {
+            case "chatMemory" -> scenario.chatMemory().stream()
+                    .map(message -> message.role() + ": " + message.content())
+                    .collect(Collectors.joining("\n"));
+            case "userMessage" -> request.getUserText();
+            case "modelResponse" -> request.getResponseContent();
+            case "observedToolResults" -> request.getDataList().stream()
+                    .map(Document::getText)
+                    .collect(Collectors.joining("\n"));
+            case "referenceAnswer" -> scenario.referenceAnswer();
+            case "expectedRefusal" -> scenario.expectedRefusal();
+            default -> throw new IllegalArgumentException("Unknown evaluation input: " + input);
+        };
+    }
+
+    @FunctionalInterface
+    public interface Judge {
+
+        EvaluationResponse evaluate(String prompt);
+    }
+}
