+package com.bibbidi.wedding.chat.evaluation;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.bibbidi.wedding.chat.evaluation.data.EvaluationDataLoader;
+import java.io.IOException;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.jupiter.api.Test;
+import org.springframework.ai.chat.prompt.Prompt;
+import org.springframework.ai.document.Document;
+import org.springframework.ai.evaluation.EvaluationRequest;
+import org.springframework.ai.evaluation.EvaluationResponse;
+
+class BibbidiEvaluatorTest {
+
+    @Test
+    void rendersResourceTemplateAsPromptForJudge() throws IOException {
+        EvaluationDataLoader loader = new EvaluationDataLoader();
+        var metric = loader.loadMetrics().stream()
+                .filter(candidate -> candidate.metricType().equals("Correctness"))
+                .findFirst().orElseThrow();
+        var scenario = loader.loadScenarios().getFirst();
+        AtomicReference<Prompt> capturedPrompt = new AtomicReference<>();
+        EvaluationResponse judgeResponse = new EvaluationResponse(false, "test", Map.of());
+        BibbidiEvaluator evaluator = new BibbidiEvaluator(metric, scenario, prompt -> {
+            capturedPrompt.set(prompt);
+            return judgeResponse;
+        });
+
+        EvaluationResponse response = evaluator.evaluate(new EvaluationRequest(
+                "질문", List.of(new Document("실제 조회 결과")), "모델 답변"));
+
+        assertThat(response).isSameAs(judgeResponse);
+        String content = capturedPrompt.get().getContents();
+        assertThat(content).contains(metric.role(), metric.task(), metric.rubric(), "실제 조회 결과", "질문", "모델 답변")
+                .doesNotContain("{role}", "{inputs}");
+        assertThat(content.indexOf(metric.role())).isLessThan(content.indexOf("입력 데이터:"));
+    }
+}
