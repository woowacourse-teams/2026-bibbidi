+package com.bibbidi.wedding.chat.evaluation.data;
+
+import static org.assertj.core.api.Assertions.assertThatCode;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import com.bibbidi.wedding.chat.evaluation.data.metric.EvaluationInput;
+import com.bibbidi.wedding.chat.evaluation.data.metric.MetricDefinition;
+import com.bibbidi.wedding.chat.evaluation.data.metric.MetricType;
