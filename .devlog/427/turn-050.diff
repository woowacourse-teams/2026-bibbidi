+package com.bibbidi.wedding.chat.evaluation.data;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatCode;
+
+import com.bibbidi.wedding.chat.evaluation.data.metric.MetricDefinition;
+import com.bibbidi.wedding.chat.evaluation.data.scenario.EvaluationScenario;
+import java.util.List;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+class FileEvaluationDatasetTest {
+
+    private final EvaluationDataset dataset = new FileEvaluationDataset();
+
+    @Test
+    @DisplayName("저장소의 시나리오 55개와 지표 11개를 읽는다")
+    void readsRepositoryData() {
+        assertThat(dataset.scenarios()).hasSize(55);
+        assertThat(dataset.metrics()).extracting(metric -> metric.metricType().label())
+                .containsExactlyInAnyOrder(
+                        "Correctness", "Completeness", "Faithfulness", "Helpfulness", "Coherence", "Relevance",
+                        "FollowingInstructions", "ProfessionalStyleAndTone", "Harmfulness", "Stereotyping", "Refusal");
+    }
+
+    @Test
+    @DisplayName("저장소의 평가 데이터는 검증을 통과한다")
+    void repositoryDataIsValid() {
+        EvaluationDataset valid = new ValidEvaluationDataset(dataset);
+
+        assertThatCode(valid::scenarios).doesNotThrowAnyException();
+        assertThatCode(valid::metrics).doesNotThrowAnyException();
+    }
+
+    @Test
+    @DisplayName("지표마다 시나리오 10개가 배정돼 총 110개 조합이다")
+    void assignsTenScenariosPerMetric() {
+        List<EvaluationScenario> scenarios = dataset.scenarios();
+
+        long combinations = dataset.metrics().stream()
+                .map(MetricDefinition::metricType)
+                .mapToLong(type -> scenarios.stream().filter(scenario -> scenario.assignedTo(type)).count())
+                .sum();
+
+        assertThat(combinations).isEqualTo(110);
+    }
+}
