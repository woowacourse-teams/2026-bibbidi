+package com.bibbidi.wedding.chat.evaluation.data.scenario;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** 챗봇에게 기대하는 것. 도구 호출, 답변의 기준, 거부의 범위다. */
+final class Expectation {
+
+    private final List<ExpectedToolCall> toolCalls;
+    private final String referenceAnswer;
+    private final ExpectedRefusal refusal;
+
+    Expectation(List<ExpectedToolCall> toolCalls, String referenceAnswer, ExpectedRefusal refusal) {
+        this.toolCalls = toolCalls;
+        this.referenceAnswer = referenceAnswer;
+        this.refusal = refusal;
+    }
+
+    List<String> violations() {
+        List<String> violations = new ArrayList<>();
+        if (referenceAnswer == null || referenceAnswer.isBlank()) {
+            violations.add("referenceAnswer는 비어 있을 수 없다");
+        }
+        if (toolCalls == null) {
+            violations.add("expectedToolCalls는 빈 배열이라도 필요하다");
+        } else {
+            toolCalls.stream()
+                    .filter(call -> !call.valid())
+                    .forEach(call -> violations.add("expectedToolCalls 항목이 올바르지 않다 " + call));
+        }
+        if (refusal == null) {
+            violations.add("expectedRefusal이 없다");
+        } else if (!refusal.known()) {
+            violations.add("expectedRefusal은 none 또는 partial이어야 한다");
+        }
+        return violations;
+    }
+}
