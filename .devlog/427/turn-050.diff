+package com.bibbidi.wedding.chat.evaluation.data.scenario;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+
+/** 챗봇에 다시 들려줄 대화. 이전 대화와 현재 사용자 메시지다. 이전 대화가 비어 있으면 새 대화다. */
+final class Conversation {
+
+    private final List<ChatTurn> memory;
+    private final String userMessage;
+
+    Conversation(List<ChatTurn> memory, String userMessage) {
+        this.memory = memory;
+        this.userMessage = userMessage;
+    }
+
+    boolean sameAs(Conversation other) {
+        return Objects.equals(userMessage, other.userMessage) && Objects.equals(memory, other.memory);
+    }
+
+    List<String> violations() {
+        List<String> violations = new ArrayList<>();
+        if (userMessage == null || userMessage.isBlank()) {
+            violations.add("userMessage는 비어 있을 수 없다");
+        }
+        if (memory == null) {
+            violations.add("chatMemory는 빈 배열이라도 필요하다");
+        } else {
+            memory.stream()
+                    .filter(turn -> !turn.valid())
+                    .forEach(turn -> violations.add("chatMemory 항목이 올바르지 않다 " + turn));
+        }
+        return violations;
+    }
+}
