--- /dev/null
+++ b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/data/ValidEvaluationDataset.java
@@ -0,0 +1,82 @@
+package com.bibbidi.wedding.chat.evaluation.data;
+
+import com.bibbidi.wedding.chat.evaluation.data.metric.MetricDefinition;
+import com.bibbidi.wedding.chat.evaluation.data.metric.MetricType;
+import com.bibbidi.wedding.chat.evaluation.data.scenario.EvaluationScenario;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+
+/**
+ * 규칙에 맞는 평가 데이터만 돌려주는 묶음. 부를 때 감싼 묶음을 검사하고, 어긴 규칙이 있으면 모두 모아 예외로 알린다.
+ *
+ * <p>지표 정의와 시나리오는 스스로 검증하고, 이 묶음은 여럿을 함께 볼 때만 보이는 규칙을 본다: 이름 중복, 같은 입력 복제,
+ * 정의 없는 지표 참조, 지표마다 같은 수의 시나리오 배정.
+ */
+public final class ValidEvaluationDataset implements EvaluationDataset {
+
+    private static final int SCENARIOS_PER_METRIC = 10;
+
+    private final EvaluationDataset origin;
+
+    public ValidEvaluationDataset(EvaluationDataset origin) {
+        this.origin = origin;
+    }
+
+    @Override
+    public List<EvaluationScenario> scenarios() {
+        check();
+        return origin.scenarios();
+    }
+
+    @Override
+    public List<MetricDefinition> metrics() {
+        check();
+        return origin.metrics();
+    }
+
+    private void check() {
+        List<String> violations = violations();
+        if (!violations.isEmpty()) {
+            throw new IllegalStateException("평가 데이터 검증 실패:\n- " + String.join("\n- ", violations));
+        }
+    }
+
+    private List<String> violations() {
+        List<String> violations = new ArrayList<>();
+        Set<MetricType> defined = new HashSet<>();
+        for (MetricDefinition metric : origin.metrics()) {
+            if (metric.metricType() == null) {
+                violations.add("지표 metricType이 비어 있다");
+                continue;
+            }
+            if (!defined.add(metric.metricType())) {
+                violations.add("지표 중복: " + metric.metricType().label());
+            }
+            violations.addAll(metric.violations());
+        }
+        List<EvaluationScenario> scenarios = origin.scenarios();
+        for (int i = 0; i < scenarios.size(); i++) {
+            EvaluationScenario scenario = scenarios.get(i);
+            violations.addAll(scenario.violations(defined));
+            for (int j = i + 1; j < scenarios.size(); j++) {
+                EvaluationScenario other = scenarios.get(j);
+                if (Objects.equals(scenario.id(), other.id())) {
+                    violations.add("시나리오 id 중복: " + scenario.id());
+                }
+                if (scenario.sameInputAs(other)) {
+                    violations.add(other.id() + ": " + scenario.id() + "와 같은 입력이다");
+                }
+            }
+        }
+        for (MetricType metricType : defined) {
+            long count = scenarios.stream().filter(scenario -> scenario.assignedTo(metricType)).count();
+            if (count != SCENARIOS_PER_METRIC) {
+                violations.add(metricType.label() + ": 배정 " + count + "개, 기대 " + SCENARIOS_PER_METRIC + "개");
+            }
+        }
+        return violations;
+    }
+}
