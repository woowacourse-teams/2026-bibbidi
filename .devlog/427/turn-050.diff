+import com.bibbidi.wedding.chat.evaluation.data.scenario.EvaluationScenario;
+import com.bibbidi.wedding.chat.evaluation.data.scenario.ExpectedRefusal;
+import com.bibbidi.wedding.chat.evaluation.data.scenario.ExpectedToolCall;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.IntStream;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+class ValidEvaluationDatasetTest {
+
+    private static final MetricType CORRECTNESS = new MetricType("Correctness");
+    private static final MetricType RELEVANCE = new MetricType("Relevance");
+
+    @Test
+    @DisplayName("지표 하나에 시나리오 10개가 배정되면 통과한다")
+    void passesValidDataset() {
+        assertThatCode(() -> valid(scenarios(10)).scenarios()).doesNotThrowAnyException();
+        assertThatCode(() -> valid(scenarios(10)).metrics()).doesNotThrowAnyException();
+    }
+
+    @Test
+    @DisplayName("지표 배정 수가 10개가 아니면 실패한다")
+    void rejectsWrongAssignmentCount() {
+        assertThatThrownBy(() -> valid(scenarios(9)).scenarios())
+                .hasMessageContaining("Correctness: 배정 9개, 기대 10개");
+    }
+
+    @Test
+    @DisplayName("시나리오 id가 중복되면 실패한다")
+    void rejectsDuplicateScenarioId() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.set(1, scenario("scenario0", List.of(CORRECTNESS), "질문 1"));
+
+        assertThatThrownBy(() -> valid(scenarios).scenarios()).hasMessageContaining("시나리오 id 중복: scenario0");
+    }
+
+    @Test
+    @DisplayName("정의되지 않은 지표를 참조하면 실패한다")
+    void rejectsUnknownMetric() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.add(scenario("extra", List.of(RELEVANCE), "다른 질문"));
+
+        assertThatThrownBy(() -> valid(scenarios).scenarios())
+                .hasMessageContaining("extra: 정의되지 않은 지표 Relevance");
+    }
+
+    @Test
+    @DisplayName("같은 대화 입력을 복제하면 실패한다")
+    void rejectsDuplicatedInput() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.set(1, scenario("scenario1", List.of(CORRECTNESS), "질문 0"));
+
+        assertThatThrownBy(() -> valid(scenarios).scenarios())
+                .hasMessageContaining("scenario1: scenario0와 같은 입력이다");
+    }
+
+    @Test
+    @DisplayName("같은 지표 정의가 둘이면 실패한다")
+    void rejectsDuplicatedMetric() {
+        EvaluationDataset dataset = new FixedEvaluationDataset(scenarios(10), List.of(metric(), metric()));
+
+        assertThatThrownBy(() -> new ValidEvaluationDataset(dataset).metrics())
+                .hasMessageContaining("지표 중복: Correctness");
+    }
+
+    @Test
+    @DisplayName("기준 데이터가 비어 있거나 허용 값이 아니면 모든 위반을 함께 알린다")
+    void reportsEveryViolation() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.set(0, new EvaluationScenario(
+                2, "scenario0", List.of(CORRECTNESS), " ",
+                List.of(new ChatTurn(null, "안내")), List.of(new ExpectedToolCall("", null)), "", null));
+
+        assertThatThrownBy(() -> valid(scenarios).scenarios())
+                .hasMessageContaining("scenario0: 지원하지 않는 schemaVersion 2")
+                .hasMessageContaining("scenario0: userMessage는 비어 있을 수 없다")
+                .hasMessageContaining("scenario0: referenceAnswer는 비어 있을 수 없다")
+                .hasMessageContaining("scenario0: expectedRefusal이 없다")
+                .hasMessageContaining("scenario0: chatMemory 항목이 올바르지 않다")
+                .hasMessageContaining("scenario0: expectedToolCalls 항목이 올바르지 않다");
+    }
+
+    @Test
+    @DisplayName("허용되지 않은 대화 역할이나 거부 범위는 실패한다")
+    void rejectsUnknownLabels() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.set(0, new EvaluationScenario(
+                1, "scenario0", List.of(CORRECTNESS), "질문 0",
+                List.of(new ChatTurn(new ChatRole("system"), "안내")), List.of(), "기준 답변",
+                new ExpectedRefusal("all")));
+
+        assertThatThrownBy(() -> valid(scenarios).scenarios())
+                .hasMessageContaining("scenario0: chatMemory 항목이 올바르지 않다")
+                .hasMessageContaining("scenario0: expectedRefusal은 none 또는 partial이어야 한다");
+    }
+
+    @Test
+    @DisplayName("지표 척도 값이 중복되거나 promptOrder가 규칙을 어기면 실패한다")
+    void rejectsInvalidMetric() {
+        MetricDefinition broken = new MetricDefinition(
+                CORRECTNESS, "정확한가", "사실 오류를 찾는다",
+                List.of(new ScaleLevel(1, "낮음"), new ScaleLevel(1, "높음")),
+                "높을수록 정확함", true, allInputs(), List.of(new PromptSection("input"), new PromptSection("role")),
+                "https://docs.aws.amazon.com");
+
+        assertThatThrownBy(() -> new ValidEvaluationDataset(new FixedEvaluationDataset(scenarios(10), List.of(broken))).metrics())
+                .hasMessageContaining("Correctness: 척도 값 중복 1")
+                .hasMessageContaining("Correctness: promptOrder는 role, task, rubric, input을 한 번씩 담고 input으로 끝나야 한다");
+    }
+
+    @Test
+    @DisplayName("requiredInputs에 userMessage나 modelResponse가 없거나 알 수 없는 항목이 있으면 실패한다")
+    void rejectsInvalidRequiredInputs() {
+        MetricDefinition missing = metricWith(List.of(new EvaluationInput("chatMemory")));
+        MetricDefinition unknown = metricWith(List.of(
+                new EvaluationInput("userMessage"), new EvaluationInput("modelResponse"), new EvaluationInput("memo")));
+
+        assertThatThrownBy(() -> validMetrics(missing).metrics())
+                .hasMessageContaining("Correctness: requiredInputs에는 userMessage와 modelResponse가 있어야 한다");
+        assertThatThrownBy(() -> validMetrics(unknown).metrics())
+                .hasMessageContaining("Correctness: requiredInputs에 알 수 없는 항목이 있다");
+    }
+
+    private ValidEvaluationDataset valid(List<EvaluationScenario> scenarios) {
+        return new ValidEvaluationDataset(new FixedEvaluationDataset(scenarios, List.of(metric())));
+    }
+
+    private ValidEvaluationDataset validMetrics(MetricDefinition metric) {
+        return new ValidEvaluationDataset(new FixedEvaluationDataset(scenarios(10), List.of(metric)));
+    }
+
+    private MetricDefinition metric() {
+        return metricWith(allInputs());
+    }
+
+    private MetricDefinition metricWith(List<EvaluationInput> inputs) {
+        return new MetricDefinition(
+                CORRECTNESS, "정확한가", "사실 오류를 찾는다",
+                List.of(new ScaleLevel(0, "미충족"), new ScaleLevel(1, "충족")),
+                "높을수록 정확함", true, inputs, allSections(), "https://docs.aws.amazon.com");
+    }
+
+    private List<EvaluationInput> allInputs() {
+        return List.of(new EvaluationInput("chatMemory"), new EvaluationInput("userMessage"),
+                new EvaluationInput("modelResponse"), new EvaluationInput("observedToolResults"));
+    }
+
+    private List<PromptSection> allSections() {
+        return List.of(new PromptSection("role"), new PromptSection("task"), new PromptSection("rubric"),
+                new PromptSection("input"));
+    }
+
+    private List<EvaluationScenario> scenarios(int count) {
+        return new ArrayList<>(IntStream.range(0, count)
+                .mapToObj(i -> scenario("scenario" + i, List.of(CORRECTNESS), "질문 " + i))
+                .toList());
+    }
+
+    private EvaluationScenario scenario(String id, List<MetricType> metrics, String userMessage) {
+        return new EvaluationScenario(
+                1, id, metrics, userMessage, List.of(),
+                List.of(new ExpectedToolCall("findCatalog", Map.of())), "기준 답변", new ExpectedRefusal("none"));
+    }
+}
