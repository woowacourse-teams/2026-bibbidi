-        String referenceAnswer,
-        ExpectedRefusal expectedRefusal
-) {
+/**
+ * 평가 시나리오 하나. {@code scenarios/*.json} 파일 하나와 대응한다.
+ *
+ * <p>JSON의 평평한 필드를 식별({@link ScenarioIdentity}), 대화({@link Conversation}), 기대({@link Expectation})
+ * 세 객체로 나눠 맡긴다. 밖에서는 필드를 꺼내 가지 않고 이 객체에 묻는다.
+ */
+public final class EvaluationScenario {
+
+    private final ScenarioIdentity identity;
+    private final List<MetricType> metrics;
+    private final Conversation conversation;
+    private final Expectation expectation;
+
+    /**
+     * @param schemaVersion     파일이 따르는 형식의 버전
+     * @param id                시나리오 이름
+     * @param metrics           이 시나리오에 적용할 지표 종류
+     * @param userMessage       현재 사용자 메시지
+     * @param chatMemory        이전 대화. 비어 있으면 새 대화다
+     * @param expectedToolCalls 기대하는 도구 호출
+     * @param referenceAnswer   답변의 사실관계와 범위를 판단할 기준
+     * @param expectedRefusal   기대하는 거부의 범위 (none 또는 partial)
+     */
+    @JsonCreator
+    public EvaluationScenario(
+            @JsonProperty("schemaVersion") int schemaVersion,
+            @JsonProperty("id") String id,
+            @JsonProperty("metrics") List<MetricType> metrics,
+            @JsonProperty("userMessage") String userMessage,
+            @JsonProperty("chatMemory") List<ChatTurn> chatMemory,
+            @JsonProperty("expectedToolCalls") List<ExpectedToolCall> expectedToolCalls,
+            @JsonProperty("referenceAnswer") String referenceAnswer,
+            @JsonProperty("expectedRefusal") ExpectedRefusal expectedRefusal) {
+        this(
+                new ScenarioIdentity(id, schemaVersion),
+                metrics,
+                new Conversation(chatMemory, userMessage),
+                new Expectation(expectedToolCalls, referenceAnswer, expectedRefusal));
+    }
+
+    private EvaluationScenario(
+            ScenarioIdentity identity, List<MetricType> metrics, Conversation conversation, Expectation expectation) {
+        this.identity = identity;
+        this.metrics = metrics;
+        this.conversation = conversation;
+        this.expectation = expectation;
+    }
+
+    public String id() {
+        return identity.id();
+    }
+
+    public boolean assignedTo(MetricType metricType) {
+        return metrics != null && metrics.contains(metricType);
+    }
+
+    public boolean sameInputAs(EvaluationScenario other) {
+        return conversation.sameAs(other.conversation);
+    }
+
+    /** 시나리오가 규칙에 맞는지 확인하고, 어긴 내용을 시나리오 이름을 붙여 알린다. {@code defined}는 정의가 있는 지표 종류다. */
+    public List<String> violations(Set<MetricType> defined) {
+        return Stream.of(identity.violations(), conversation.violations(), expectation.violations(), metricViolations(defined))
+                .flatMap(List::stream)
+                .map(violation -> identity.name() + ": " + violation)
+                .toList();
+    }
+
+    private List<String> metricViolations(Set<MetricType> defined) {
+        List<String> violations = new ArrayList<>();
+        if (metrics == null || metrics.isEmpty()) {
+            violations.add("적용 지표가 없다");
+            return violations;
+        }
+        if (new HashSet<>(metrics).size() != metrics.size()) {
+            violations.add("같은 지표가 중복 지정됐다");
+        }
+        metrics.stream()
+                .filter(metric -> !defined.contains(metric))
+                .forEach(metric -> violations.add("정의되지 않은 지표 " + metric.label()));
+        return violations;
+    }
 }
