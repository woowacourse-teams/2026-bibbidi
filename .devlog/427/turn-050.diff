+package com.bibbidi.wedding.chat.evaluation.data.scenario;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** 시나리오를 구분하는 이름과, 파일이 따르는 형식의 버전. */
+final class ScenarioIdentity {
+
+    private static final int SUPPORTED_SCHEMA_VERSION = 1;
+    private static final String UNNAMED = "시나리오";
+
+    private final String id;
+    private final int schemaVersion;
+
+    ScenarioIdentity(String id, int schemaVersion) {
+        this.id = id;
+        this.schemaVersion = schemaVersion;
+    }
+
+    String id() {
+        return id;
+    }
+
+    /** 메시지에 붙일 이름. id가 없으면 일반 이름을 쓴다. */
+    String name() {
+        return id == null || id.isBlank() ? UNNAMED : id;
+    }
+
+    List<String> violations() {
+        List<String> violations = new ArrayList<>();
+        if (id == null || id.isBlank()) {
+            violations.add("id가 비어 있다");
+        }
+        if (schemaVersion != SUPPORTED_SCHEMA_VERSION) {
+            violations.add("지원하지 않는 schemaVersion " + schemaVersion);
+        }
+        return violations;
+    }
+}
