+package com.bibbidi.wedding.chat.evaluation;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.bibbidi.wedding.chat.evaluation.data.EvaluationScenario;
+import com.bibbidi.wedding.chat.evaluation.data.MetricConfig;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.jupiter.api.Test;
+import tools.jackson.databind.ObjectMapper;
+
+class EvaluationDataMappingTest {
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    void metricJsonMapsNestedScoreLevels() throws IOException {
+        String json = Files.readString(
+                Path.of("src/test/resources/ai-evaluation/metrics/Correctness.json"), StandardCharsets.UTF_8);
+
+        MetricConfig metric = objectMapper.readValue(json, MetricConfig.class);
+
+        assertThat(metric.metricType()).isEqualTo("Correctness");
+        assertThat(metric.scale()).hasSize(5);
+        assertThat(metric.scale().getFirst().value()).isZero();
+        assertThat(metric.scale().getFirst().definition()).isNotBlank();
+    }
+
+    @Test
+    void scenarioJsonMapsNestedMessagesAndToolArguments() throws IOException {
+        String json = Files.readString(
+                Path.of("src/test/resources/ai-evaluation/scenarios/scenario21.json"), StandardCharsets.UTF_8);
+
+        EvaluationScenario scenario = objectMapper.readValue(json, EvaluationScenario.class);
+
+        assertThat(scenario.id()).isEqualTo("scenario21");
+        assertThat(scenario.chatMemory()).hasSize(2);
+        assertThat(scenario.chatMemory().getFirst().role()).isEqualTo("user");
+        assertThat(scenario.expectedToolCalls()).hasSize(1);
+        assertThat(scenario.expectedToolCalls().getFirst().arguments()).isNotNull();
+    }
+}
