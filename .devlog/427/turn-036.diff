+package com.bibbidi.wedding.chat.evaluation;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatCode;
+
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+class EvaluationDataLoaderTest {
+
+    private final EvaluationDataset dataset = new EvaluationDataLoader().load();
+
+    @Test
+    @DisplayName("저장소의 시나리오 55개와 지표 11개를 읽는다")
+    void loadsRepositoryData() {
+        assertThat(dataset.scenarios()).hasSize(55);
+        assertThat(dataset.metrics()).hasSize(11);
+    }
+
+    @Test
+    @DisplayName("저장소의 평가 데이터는 검증을 통과한다")
+    void repositoryDataIsValid() {
+        assertThatCode(() -> new EvaluationDataValidator().validate(dataset)).doesNotThrowAnyException();
+    }
+
+    @Test
+    @DisplayName("지표마다 시나리오 10개가 배정돼 총 110개 조합이다")
+    void assignsTenScenariosPerMetric() {
+        long combinations = dataset.scenarios().stream()
+                .mapToLong(scenario -> scenario.metrics().size())
+                .sum();
+
+        assertThat(combinations).isEqualTo(110);
+    }
+}
