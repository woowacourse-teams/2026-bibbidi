@@ -0,0 +1,119 @@
+package com.bibbidi.wedding.chat.evaluation;
+
+import static org.assertj.core.api.Assertions.assertThatCode;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.function.UnaryOperator;
+import java.util.stream.IntStream;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+class EvaluationDataValidatorTest {
+
+    private final EvaluationDataValidator validator = new EvaluationDataValidator();
+
+    @Test
+    @DisplayName("지표 하나에 시나리오 10개가 배정되면 통과한다")
+    void passesValidDataset() {
+        assertThatCode(() -> validator.validate(dataset(scenarios(10)))).doesNotThrowAnyException();
+    }
+
+    @Test
+    @DisplayName("지표 배정 수가 10개가 아니면 실패한다")
+    void rejectsWrongAssignmentCount() {
+        assertThatThrownBy(() -> validator.validate(dataset(scenarios(9))))
+                .hasMessageContaining("Correctness: 배정 9개, 기대 10개");
+    }
+
+    @Test
+    @DisplayName("시나리오 id가 중복되면 실패한다")
+    void rejectsDuplicateScenarioId() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.set(1, withId(scenarios.get(1), "scenario0"));
+
+        assertThatThrownBy(() -> validator.validate(dataset(scenarios))).hasMessageContaining("시나리오 id 중복: scenario0");
+    }
+
+    @Test
+    @DisplayName("정의되지 않은 지표를 참조하면 실패한다")
+    void rejectsUnknownMetric() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.add(scenario("extra", List.of("Unknown"), "다른 질문"));
+
+        assertThatThrownBy(() -> validator.validate(dataset(scenarios)))
+                .hasMessageContaining("extra: 정의되지 않은 지표 Unknown");
+    }
+
+    @Test
+    @DisplayName("같은 대화 입력을 복제하면 실패한다")
+    void rejectsDuplicatedInput() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.set(1, scenario("scenario1", List.of("Correctness"), "질문 0"));
+
+        assertThatThrownBy(() -> validator.validate(dataset(scenarios)))
+                .hasMessageContaining("scenario1: scenario0와 같은 입력이다");
+    }
+
+    @Test
+    @DisplayName("기준 데이터가 비어 있거나 허용 값이 아니면 모든 위반을 함께 알린다")
+    void reportsEveryViolation() {
+        List<EvaluationScenario> scenarios = scenarios(10);
+        scenarios.set(0, new EvaluationScenario(
+                2, "scenario0", List.of("Correctness"), " ",
+                List.of(new ChatTurn("system", "안내")), List.of(new ExpectedToolCall("", null)), "", "all"));
+
+        assertThatThrownBy(() -> validator.validate(dataset(scenarios)))
+                .hasMessageContaining("지원하지 않는 schemaVersion 2")
+                .hasMessageContaining("userMessage, referenceAnswer는 비어 있을 수 없다")
+                .hasMessageContaining("expectedRefusal은 none 또는 partial이어야 한다")
+                .hasMessageContaining("chatMemory 항목이 올바르지 않다")
+                .hasMessageContaining("expectedToolCalls 항목이 올바르지 않다");
+    }
+
+    @Test
+    @DisplayName("지표 척도 값이 중복되거나 promptOrder가 input으로 끝나지 않으면 실패한다")
+    void rejectsInvalidMetric() {
+        MetricDefinition broken = metric(m -> new MetricDefinition(
+                m.id(), m.task(), m.rubric(),
+                List.of(new ScaleLevel(1, "낮음"), new ScaleLevel(1, "높음")),
+                m.direction(), true, m.requiredInputs(), List.of("input", "role"), m.source()));
+
+        assertThatThrownBy(() -> validator.validate(new EvaluationDataset(scenarios(10), List.of(broken))))
+                .hasMessageContaining("Correctness: 척도 값 중복 1")
+                .hasMessageContaining("Correctness: promptOrder는 input으로 끝나야 한다");
+    }
+
+    private EvaluationDataset dataset(List<EvaluationScenario> scenarios) {
+        return new EvaluationDataset(scenarios, List.of(metric(UnaryOperator.identity())));
+    }
+
+    private MetricDefinition metric(UnaryOperator<MetricDefinition> customizer) {
+        return customizer.apply(new MetricDefinition(
+                "Correctness", "정확한가", "사실 오류를 찾는다",
+                List.of(new ScaleLevel(0, "미충족"), new ScaleLevel(1, "충족")),
+                "높을수록 정확함", true,
+                List.of("chatMemory", "userMessage", "modelResponse", "observedToolResults"),
+                List.of("role", "task", "rubric", "input"), "https://docs.aws.amazon.com"));
+    }
+
+    private List<EvaluationScenario> scenarios(int count) {
+        return new ArrayList<>(IntStream.range(0, count)
+                .mapToObj(i -> scenario("scenario" + i, List.of("Correctness"), "질문 " + i))
+                .toList());
+    }
+
+    private EvaluationScenario scenario(String id, List<String> metrics, String userMessage) {
+        return new EvaluationScenario(
+                EvaluationDataValidator.SUPPORTED_SCHEMA_VERSION, id, metrics, userMessage, List.of(),
+                List.of(new ExpectedToolCall("findCatalog", Map.of())), "기준 답변", "none");
+    }
+
+    private EvaluationScenario withId(EvaluationScenario source, String id) {
+        return new EvaluationScenario(
+                source.schemaVersion(), id, source.metrics(), source.userMessage(), source.chatMemory(),
+                source.expectedToolCalls(), source.referenceAnswer(), source.expectedRefusal());
+    }
+}
