+package com.bibbidi.wedding.chat.evaluation;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.UncheckedIOException;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.List;
+import org.springframework.core.io.Resource;
+import org.springframework.core.io.support.PathMatchingResourcePatternResolver;
+import tools.jackson.databind.json.JsonMapper;
+
+public class EvaluationDataLoader {
+
+    private static final String ROOT = "classpath:ai-evaluation/";
+
+    private final PathMatchingResourcePatternResolver resolver = new PathMatchingResourcePatternResolver();
+    private final JsonMapper jsonMapper = JsonMapper.builder().build();
+
+    public EvaluationDataset load() {
+        return new EvaluationDataset(
+                read("scenarios/*.json", EvaluationScenario.class),
+                read("metrics/*.json", MetricDefinition.class));
+    }
+
+    private <T> List<T> read(String pattern, Class<T> type) {
+        try {
+            Resource[] resources = resolver.getResources(ROOT + pattern);
+            return Arrays.stream(resources)
+                    .sorted(Comparator.comparing(Resource::getFilename))
+                    .map(resource -> parse(resource, type))
+                    .toList();
+        } catch (IOException e) {
+            throw new UncheckedIOException("평가 데이터를 찾지 못했습니다: " + pattern, e);
+        }
+    }
+
+    private <T> T parse(Resource resource, Class<T> type) {
+        try (InputStream in = resource.getInputStream()) {
+            return jsonMapper.readValue(in, type);
+        } catch (IOException e) {
+            throw new UncheckedIOException("평가 데이터를 읽지 못했습니다: " + resource.getFilename(), e);
+        } catch (RuntimeException e) {
+            throw new IllegalStateException("평가 데이터 형식이 올바르지 않습니다: " + resource.getFilename(), e);
+        }
+    }
+}
