+++ b/BE/src/test/java/com/bibbidi/wedding/chat/evaluation/EvaluationDataValidator.java
@@ -0,0 +1,147 @@
+package com.bibbidi.wedding.chat.evaluation;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+public class EvaluationDataValidator {
+
+    static final int SUPPORTED_SCHEMA_VERSION = 1;
+    static final int SCENARIOS_PER_METRIC = 10;
+    private static final Set<String> ROLES = Set.of("user", "assistant");
+    private static final Set<String> REFUSALS = Set.of("none", "partial");
+    private static final Set<String> INPUTS =
+            Set.of("chatMemory", "userMessage", "modelResponse", "observedToolResults");
+
+    public void validate(EvaluationDataset dataset) {
+        List<String> violations = new ArrayList<>();
+        Set<String> metricIds = validateMetrics(dataset.metrics(), violations);
+        validateScenarios(dataset.scenarios(), metricIds, violations);
+        if (!violations.isEmpty()) {
+            throw new IllegalStateException("평가 데이터 검증 실패:\n- " + String.join("\n- ", violations));
+        }
+    }
+
+    private Set<String> validateMetrics(List<MetricDefinition> metrics, List<String> violations) {
+        Set<String> ids = new HashSet<>();
+        for (MetricDefinition metric : metrics) {
+            if (blank(metric.id())) {
+                violations.add("지표 id가 비어 있다");
+                continue;
+            }
+            if (!ids.add(metric.id())) {
+                violations.add("지표 id 중복: " + metric.id());
+            }
+            validateMetric(metric, violations);
+        }
+        return ids;
+    }
+
+    private void validateMetric(MetricDefinition metric, List<String> violations) {
+        String id = metric.id();
+        if (blank(metric.task()) || blank(metric.rubric()) || blank(metric.direction()) || blank(metric.source())) {
+            violations.add(id + ": task, rubric, direction, source는 비어 있을 수 없다");
+        }
+        if (metric.scale() == null || metric.scale().size() < 2) {
+            violations.add(id + ": 척도는 두 단계 이상이어야 한다");
+        } else {
+            Set<Integer> values = new HashSet<>();
+            for (ScaleLevel level : metric.scale()) {
+                if (!values.add(level.value())) {
+                    violations.add(id + ": 척도 값 중복 " + level.value());
+                }
+                if (blank(level.definition())) {
+                    violations.add(id + ": 척도 " + level.value() + "의 뜻이 비어 있다");
+                }
+            }
+        }
+        if (metric.requiredInputs() == null || metric.requiredInputs().isEmpty()) {
+            violations.add(id + ": requiredInputs가 비어 있다");
+        } else if (!INPUTS.containsAll(metric.requiredInputs())) {
+            violations.add(id + ": 알 수 없는 입력 " + metric.requiredInputs());
+        }
+        List<String> order = metric.promptOrder();
+        if (order == null || order.isEmpty() || !"input".equals(order.getLast())) {
+            violations.add(id + ": promptOrder는 input으로 끝나야 한다");
+        }
+    }
+
+    private void validateScenarios(
+            List<EvaluationScenario> scenarios, Set<String> metricIds, List<String> violations) {
+        Set<String> ids = new HashSet<>();
+        Map<String, String> inputOwners = new HashMap<>();
+        Map<String, Integer> assigned = new HashMap<>();
+        for (EvaluationScenario scenario : scenarios) {
+            String id = scenario.id();
+            if (blank(id)) {
+                violations.add("시나리오 id가 비어 있다");
+                continue;
+            }
+            if (!ids.add(id)) {
+                violations.add("시나리오 id 중복: " + id);
+            }
+            validateScenario(scenario, metricIds, violations);
+            String owner = inputOwners.putIfAbsent(scenario.chatMemory() + "|" + scenario.userMessage(), id);
+            if (owner != null) {
+                violations.add(id + ": " + owner + "와 같은 입력이다");
+            }
+            if (scenario.metrics() != null) {
+                new HashSet<>(scenario.metrics()).forEach(metric -> assigned.merge(metric, 1, Integer::sum));
+            }
+        }
+        for (String metricId : metricIds) {
+            int count = assigned.getOrDefault(metricId, 0);
+            if (count != SCENARIOS_PER_METRIC) {
+                violations.add(metricId + ": 배정 " + count + "개, 기대 " + SCENARIOS_PER_METRIC + "개");
+            }
+        }
+    }
+
+    private void validateScenario(EvaluationScenario scenario, Set<String> metricIds, List<String> violations) {
+        String id = scenario.id();
+        if (scenario.schemaVersion() != SUPPORTED_SCHEMA_VERSION) {
+            violations.add(id + ": 지원하지 않는 schemaVersion " + scenario.schemaVersion());
+        }
+        if (blank(scenario.userMessage()) || blank(scenario.referenceAnswer())) {
+            violations.add(id + ": userMessage, referenceAnswer는 비어 있을 수 없다");
+        }
+        if (scenario.expectedRefusal() == null || !REFUSALS.contains(scenario.expectedRefusal())) {
+            violations.add(id + ": expectedRefusal은 none 또는 partial이어야 한다");
+        }
+        if (scenario.metrics() == null || scenario.metrics().isEmpty()) {
+            violations.add(id + ": 적용 지표가 없다");
+        } else {
+            if (new HashSet<>(scenario.metrics()).size() != scenario.metrics().size()) {
+                violations.add(id + ": 같은 지표가 중복 지정됐다");
+            }
+            scenario.metrics().stream()
+                    .filter(metric -> !metricIds.contains(metric))
+                    .forEach(metric -> violations.add(id + ": 정의되지 않은 지표 " + metric));
+        }
+        if (scenario.chatMemory() == null) {
+            violations.add(id + ": chatMemory는 빈 배열이라도 필요하다");
+        } else {
+            scenario.chatMemory().forEach(turn -> {
+                if (turn.role() == null || !ROLES.contains(turn.role()) || blank(turn.content())) {
+                    violations.add(id + ": chatMemory 항목이 올바르지 않다 " + turn);
+                }
+            });
+        }
+        if (scenario.expectedToolCalls() == null) {
+            violations.add(id + ": expectedToolCalls는 빈 배열이라도 필요하다");
+        } else {
+            scenario.expectedToolCalls().forEach(call -> {
+                if (blank(call.name()) || call.arguments() == null) {
+                    violations.add(id + ": expectedToolCalls 항목이 올바르지 않다 " + call);
+                }
+            });
+        }
+    }
+
+    private boolean blank(String value) {
+        return value == null || value.isBlank();
+    }
+}
