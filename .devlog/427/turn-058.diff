+package com.bibbidi.wedding.chat.evaluation.data;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.io.IOException;
+import org.junit.jupiter.api.Test;
+
+class EvaluationDataLoaderTest {
+
+    private final EvaluationDataLoader loader = new EvaluationDataLoader();
+
+    @Test
+    void loadsAllScenariosInFilenameOrder() throws IOException {
+        var scenarios = loader.loadScenarios();
+
+        assertThat(scenarios).hasSize(55);
+        assertThat(scenarios.getFirst().name()).isEqualTo("scenario01");
+        assertThat(scenarios.getLast().name()).isEqualTo("scenario55");
+        assertThat(scenarios.get(20).chatMemory()).hasSize(2);
+    }
+
+    @Test
+    void loadsAllMetrics() throws IOException {
+        var metrics = loader.loadMetrics();
+
+        assertThat(metrics).hasSize(11);
+        assertThat(metrics).extracting(MetricConfig::metricType)
+                .contains("Correctness", "Stereotyping");
+        assertThat(metrics).allSatisfy(metric -> assertThat(metric.scale()).isNotEmpty());
+    }
+}
