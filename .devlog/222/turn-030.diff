+  if (!stem || stem === filename) return [];
+
+  const patterns = [
+    `${stem}Test.java`, `${stem}Test.kt`, `${stem}.test.ts`, `${stem}.test.tsx`,
+    `${stem}.spec.ts`, `${stem}.spec.tsx`,
+  ];
+  return tree
+    .filter((item) => item.type === "blob" && item.path !== file.filename)
+    .map((item) => item.path)
