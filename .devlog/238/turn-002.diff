+package com.bibbidi.wedding.auth.security;
+
+import java.util.Collection;
+import java.util.List;
+import org.springframework.security.authentication.AbstractAuthenticationToken;
+import org.springframework.security.core.GrantedAuthority;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+
+/** 검증을 마친 access token이 만들어 내는 인증 정보다. */
+public class AccessTokenAuthentication extends AbstractAuthenticationToken {
+
+    private final AuthenticatedUser principal;
+
+    private AccessTokenAuthentication(AuthenticatedUser principal, Collection<GrantedAuthority> authorities) {
+        super(authorities);
+        this.principal = principal;
+        setAuthenticated(true);
+    }
+
+    public static AccessTokenAuthentication of(AuthenticatedUser user) {
+        return new AccessTokenAuthentication(user, List.of(
+                new SimpleGrantedAuthority(AuthorityNames.STATUS_PREFIX + user.status().name())));
+    }
+
+    @Override
+    public AuthenticatedUser getPrincipal() {
+        return principal;
+    }
+
+    @Override
+    public Object getCredentials() {
+        return null;
