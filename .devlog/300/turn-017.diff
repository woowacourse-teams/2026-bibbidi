+    acceptWebAccessToken(accessToken(Date.now() + 120_000, "27"));
+
+    expect(currentWebUserId()).toBe("27");
+  });
+
+  it("access token을 Web Storage에 기록하지 않는다", () => {
+    const localStorageSetItem = vi.fn();
