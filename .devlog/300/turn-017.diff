+import { afterEach, describe, expect, it } from "vitest";
+
+import {
+  clearAccountSetupChoice,
+  readAccountSetupChoice,
+  saveAccountSetupChoice,
+} from "./accountSetupChoice";
+
+afterEach(() => {
+  clearAccountSetupChoice();
+});
+
+describe("accountSetupChoice", () => {
+  it("선택한 계정 설정 폼을 저장하고 복원한다", () => {
