@@ -0,0 +1,206 @@
+.onboarding {
+  display: flex;
+  width: min(100%, 420px);
+  flex-direction: column;
+}
+
+.onboarding__title {
+  margin: 0;
+  color: var(--color-fg-neutral);
+  font-size: 28px;
+  font-weight: 800;
+  line-height: 1.35;
+  letter-spacing: -0.03em;
+}
+
+.onboarding__description,
+.onboarding__status {
+  margin: 8px 0 0;
+  color: var(--color-fg-neutral-muted);
+  font-size: 14px;
+  line-height: 1.5;
+}
+
+.onboarding__terms {
+  min-width: 0;
+  margin: 28px 0 0;
+  border: 0;
+  padding: 0;
+}
+
+.onboarding__legend {
+  color: var(--color-fg-neutral);
+  font-size: 15px;
+  font-weight: 700;
+  line-height: 1.4;
+}
+
+.onboarding__agree-all {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  margin-top: 12px;
+  border: 1px solid var(--color-stroke-brand-weak);
+  border-radius: 8px;
+  background: var(--color-bg-brand-weak);
+  color: var(--color-fg-brand-contrast);
+  cursor: pointer;
+  font-size: 15px;
+  font-weight: 700;
+  padding: 14px;
+}
+
+.onboarding input[type="checkbox"] {
+  width: 18px;
+  height: 18px;
+  margin: 0;
+  accent-color: var(--color-bg-brand-solid);
+}
+
+.onboarding input[type="checkbox"]:focus-visible,
+.onboarding__term-toggle:focus-visible,
+.onboarding__retry:focus-visible,
+.onboarding__switch-account-button:focus-visible,
+.onboarding__submit:focus-visible {
+  outline: 3px solid var(--color-stroke-focus-ring);
+  outline-offset: 3px;
+}
+
+.onboarding__term-list {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  margin: 12px 0 0;
+  padding: 0;
+  list-style: none;
+}
+
+.onboarding__term {
+  overflow: hidden;
+  border: 1px solid var(--color-stroke-neutral-weak);
+  border-radius: 8px;
+  background: var(--color-bg-layer-default);
+}
+
+.onboarding__term-summary {
+  display: flex;
+  min-height: 48px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 12px 14px;
+}
+
+.onboarding__term-label {
+  display: flex;
+  min-width: 0;
+  align-items: center;
+  gap: 10px;
+  color: var(--color-fg-neutral);
+  cursor: pointer;
+  font-size: 14px;
+  font-weight: 600;
+  line-height: 1.4;
+}
+
+.onboarding__term-toggle {
+  flex: none;
+  border: 0;
+  border-radius: 4px;
+  background: transparent;
+  color: var(--color-fg-brand);
+  cursor: pointer;
+  font: inherit;
+  font-size: 13px;
+  font-weight: 700;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+
+.onboarding__term-content {
+  border-top: 1px solid var(--color-stroke-neutral-weak);
+  background: var(--color-bg-neutral-weak);
+  color: var(--color-fg-neutral-muted);
+  font-size: 13px;
+  line-height: 1.6;
+  padding: 14px;
+  white-space: pre-wrap;
+}
+
+.onboarding__error {
+  margin: 0;
+  color: var(--color-fg-critical);
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1.4;
+}
+
+.onboarding__submit-area {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-top: 24px;
+}
+
+.onboarding__switch-account {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-top: 16px;
+}
+
+.onboarding__switch-account-button {
+  align-self: center;
+  border: 0;
+  border-radius: 4px;
+  background: transparent;
+  color: var(--color-fg-brand);
+  cursor: pointer;
+  font: inherit;
+  font-size: 13px;
+  font-weight: 700;
+  padding: 6px 8px;
+  text-decoration: underline;
+  text-underline-offset: 3px;
+}
+
+.onboarding__switch-account-button:disabled {
+  cursor: not-allowed;
+  opacity: 0.65;
+}
+
+.onboarding__submit,
+.onboarding__retry {
+  width: 100%;
+  height: 48px;
+  border: 0;
+  border-radius: 8px;
+  background: var(--color-bg-brand-solid);
+  color: var(--color-fg-on-brand);
+  cursor: pointer;
+  font: inherit;
+  font-size: 15px;
+  font-weight: 700;
+}
+
+.onboarding__retry {
+  margin-top: 20px;
+}
+
+.onboarding__submit:disabled {
+  cursor: not-allowed;
+  opacity: 0.65;
+}
+
+@media (hover: hover) and (pointer: fine) {
+  .onboarding__submit:not(:disabled):hover,
+  .onboarding__retry:hover {
+    background: var(--color-bg-brand-solid-pressed);
+  }
+}
+
+@media (max-width: 520px) {
+  .onboarding__title {
+    font-size: 26px;
+  }
+}
