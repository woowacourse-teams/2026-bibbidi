+  detail: PreparationStepDetailViewModel;
+  id: string;
+  onAddAllTasks: () => void;
+  onCollapse: () => void;
+  onTaskAdd: (catalogItemId: string) => void;
+}
+
+export function PreparationStepInlineDetail({
+  additionErrorMessage,
+  addingCatalogItemIds,
+  canAddTasks,
