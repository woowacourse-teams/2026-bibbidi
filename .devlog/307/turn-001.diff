+.monthly-calendar {
+  min-width: 0;
+  padding: 24px;
+  border-radius: 12px;
+  background: var(--color-bg-layer-default);
+  box-shadow: inset 0 0 0 1px var(--color-stroke-neutral);
+}
+
+.monthly-calendar__header {
+  display: flex;
+  min-height: 44px;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  margin-bottom: 12px;
+}
+
+.monthly-calendar__header h2,
+.monthly-calendar__header p {
+  margin: 0;
+}
+
+.monthly-calendar__header h2 {
+  color: var(--color-fg-neutral);
+  font-size: 20px;
+  font-weight: 700;
+  line-height: 1.3;
+}
+
+.monthly-calendar__header p {
+  margin-top: 2px;
+  color: var(--color-fg-neutral-muted);
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1.4;
+}
+
+.monthly-calendar__controls {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.monthly-calendar__controls button {
+  display: grid;
+  min-width: 36px;
+  height: 36px;
+  place-items: center;
+  padding: 0;
+  border: 0;
+  border-radius: 8px;
+  background: transparent;
+  color: var(--color-fg-neutral);
+  cursor: pointer;
+  font: inherit;
+}
+
+.monthly-calendar__controls button:hover {
+  background: var(--color-bg-neutral-weak);
+}
+
+.monthly-calendar__controls button:focus-visible {
+  outline: 2px solid var(--color-stroke-focus-ring);
+  outline-offset: 2px;
+}
+
+.monthly-calendar__controls svg {
+  width: 18px;
+  height: 18px;
+  stroke: currentcolor;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  stroke-width: 1.8;
+}
+
+.monthly-calendar__controls .monthly-calendar__today-button {
+  width: auto;
+  padding: 0 10px;
+  box-shadow: inset 0 0 0 1px var(--color-stroke-neutral);
+  font-size: 13px;
+  font-weight: 700;
+}
+
+.monthly-calendar__grid {
+  width: 100%;
+  border-collapse: collapse;
+  table-layout: fixed;
+}
+
+.monthly-calendar__grid caption {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  border: 0;
+  margin: -1px;
+  clip-path: inset(50%);
+  overflow: hidden;
+  white-space: nowrap;
+}
+
+.monthly-calendar__grid th {
+  height: 28px;
+  color: var(--color-fg-neutral-muted);
+  font-size: 12px;
+  font-weight: 600;
+}
+
+.monthly-calendar__grid th:first-child,
+.monthly-calendar__grid td:first-child:not(.monthly-calendar__day--outside) {
+  color: var(--color-fg-critical);
+}
+
+.monthly-calendar__grid td {
+  height: 48px;
+  padding: 2px;
+  color: var(--color-fg-neutral);
+  font-size: 13px;
+  text-align: center;
+}
+
+.monthly-calendar__grid time {
+  display: inline-grid;
+  width: 32px;
+  height: 32px;
+  place-items: center;
+  border-radius: 50%;
+}
+
+.monthly-calendar__grid .monthly-calendar__day--outside {
+  color: var(--color-fg-placeholder);
+}
+
+.monthly-calendar__grid .monthly-calendar__day--today time {
+  background: var(--color-bg-brand-solid);
+  color: var(--color-fg-on-brand);
+  font-weight: 700;
+}
+
+@media (max-width: 600px) {
