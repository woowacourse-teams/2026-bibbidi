+
+const requiredEnvironment = [
+  "GITHUB_TOKEN",
+  "OPENAI_API_KEY",
+  "REVIEW_REPOSITORY",
+  "REVIEW_PULL_NUMBER",
+  "REVIEW_HEAD_SHA",
+];
+
+for (const name of requiredEnvironment) {
