+}
+
+const pullNumber = Number(process.env.REVIEW_PULL_NUMBER);
+if (!Number.isSafeInteger(pullNumber) || pullNumber <= 0) {
+  throw new Error("REVIEW_PULL_NUMBER must be a positive integer");
