diff --git a/FE/src/features/ai-chat/view/AiChatRecommendations.css b/FE/src/features/ai-chat/view/AiChatRecommendations.css
new file mode 100644
index 0000000000000000000000000000000000000000..7e75d41fc4115e7c9289559da009b8c6c6f88beb
--- /dev/null
+++ b/FE/src/features/ai-chat/view/AiChatRecommendations.css
@@ -0,0 +1,250 @@
+.ai-recommendations {
+  position: relative;
+  container-type: inline-size;
+  margin-top: 24px;
+  color: var(--color-fg-neutral);
+}
+
+.ai-recommendations--pressed {
+  z-index: 3;
+}
+
+.ai-recommendations--pressed .ai-recommendations__header {
+  opacity: 0.48;
+}
+
+.ai-recommendations__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  font-size: 15px;
+}
+
+.ai-recommendations__header > span {
+  color: var(--color-fg-neutral-muted);
+  font-size: 13px;
+}
+
+.ai-recommendations__direction,
+.ai-recommendations__hint {
+  position: relative;
+  margin: 12px 0;
+  color: var(--color-fg-neutral-muted);
+  font-size: 12px;
+  text-align: center;
+}
+
+.ai-recommendations__stage {
+  position: relative;
+  display: flex;
+  justify-content: center;
+  padding: 20px 0;
+  overflow: clip;
+}
+
+.ai-recommendations__card,
+.ai-recommendations__peek {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  padding: clamp(14px, 5.7cqw, 24px);
+  border: 0;
+  border-radius: 26px;
+  background: transparent;
+  text-align: left;
+  color: inherit;
+  line-height: 1.5;
+}
+
+.ai-recommendations__card {
+  z-index: 4;
+  width: min(280px, calc(100% - 48px));
+  aspect-ratio: 280 / 272;
+  flex: none;
+  margin: 0;
+  touch-action: pan-y;
+  user-select: none;
+  transform: translateX(var(--recommendation-x))
+    rotate(var(--recommendation-rotation));
+  transition: transform 0.25s ease;
+  animation: ai-recommendation-enter 0.25s ease;
+}
+
+/* 드래그 중인 카드만 스크롤·캐러셀의 잘림 영역 위에서 그린다. */
+.ai-recommendations__card:popover-open {
+  position: fixed;
+  inset: auto;
+  left: var(--recommendation-left);
+  top: var(--recommendation-top);
+  width: var(--recommendation-width);
+  height: var(--recommendation-height);
+}
+
+.ai-recommendations__card::backdrop {
+  background: transparent;
+  pointer-events: none;
+}
+
+.ai-recommendations--pressed .ai-recommendations__card {
+  cursor: grabbing;
+  transition: none;
+  animation: none;
+}
+
+.ai-recommendations__surface {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+  width: 100%;
+  height: auto;
+  pointer-events: none;
+}
+
+.ai-recommendations__number {
+  margin-bottom: clamp(10px, 4.8cqw, 20px);
+  color: var(--color-bg-brand-solid-pressed);
+  font-size: clamp(18px, 6cqw, 25px);
+  font-weight: 700;
+  line-height: 1.2;
+}
+
+.ai-recommendations__title {
+  display: -webkit-box;
+  width: 100%;
+  margin-bottom: auto;
+  overflow: hidden;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 3;
+  font-size: clamp(16px, 6cqw, 23px);
+  line-height: 1.4;
+  word-break: keep-all;
+  overflow-wrap: anywhere;
+}
+
+.ai-recommendations__step {
+  position: relative;
+  display: inline-flex;
+  width: 122px;
+  height: 28px;
+  flex: none;
+  align-items: center;
+  justify-content: center;
+  margin-top: 12px;
+  color: var(--color-fg-neutral-muted);
+  font-size: 12px;
+}
+
+.ai-recommendations__step img {
+  position: absolute;
+  top: 0;
+  left: 0;
+  z-index: -1;
+}
+
+.ai-recommendations__step > span {
+  overflow: hidden;
+  max-width: 102px;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.ai-recommendations__description {
+  margin-top: clamp(8px, 4.8cqw, 20px);
+  color: var(--color-fg-neutral-muted);
+  font-size: clamp(11px, 3.5cqw, 14px);
+}
+
+.ai-recommendations__peek {
+  position: absolute;
+  top: 50%;
+  width: 280px;
+  height: 248px;
+  transform: translateY(-50%);
+  padding: 18px 24px;
+  color: var(--color-fg-neutral);
+  z-index: 1;
+}
+
+.ai-recommendations__peek--previous {
+  right: calc(50% + min(140px, 50cqw - 24px) + 12px);
+}
+.ai-recommendations__peek--next {
+  left: calc(50% + min(140px, 50cqw - 24px) + 12px);
+}
+.ai-recommendations__peek .ai-recommendations__title {
+  font-size: 20px;
+}
+.ai-recommendations__peek .ai-recommendations__number {
+  color: #bd8b7c;
+}
+.ai-recommendations__peek .ai-recommendations__step {
+  width: 130px;
+  height: 26px;
+}
+
+.ai-recommendations__badge {
+  position: absolute;
+  top: 12px;
+  right: 18px;
+  display: grid;
+  width: 78px;
+  height: 34px;
+  place-items: center;
+  font-size: 13px;
+  font-weight: 700;
+}
+
+.ai-recommendations__badge img {
+  position: absolute;
+  inset: 0;
+  z-index: -1;
+}
+.ai-recommendations__saving {
+  position: absolute;
+  inset: auto 16px 12px auto;
+  font-size: 12px;
+  color: var(--color-fg-brand);
+}
+.ai-recommendations__complete {
+  margin: 24px 0 0;
+  color: var(--color-fg-neutral-muted);
+  font-size: 13px;
+}
+
+.ai-chat-panel:has(.ai-recommendations--pressed)::after,
+.ai-chat-dialog:has(.ai-recommendations--pressed)::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 2;
+  background: rgb(50 50 45 / 28%);
+  pointer-events: none;
+}
+
+.ai-recommendations--pressed
+  :is(.ai-recommendations__direction, .ai-recommendations__hint) {
+  z-index: 4;
+  color: var(--color-fg-on-brand);
+}
+.ai-recommendations--pressed .ai-recommendations__peek {
+  opacity: 0.48;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ai-recommendations__card {
+    transition: none;
+    animation: none;
+  }
+}
+
+@keyframes ai-recommendation-enter {
+  from {
+    opacity: 0.5;
+    transform: translateX(var(--recommendation-enter-x));
+  }
+  to {
+    opacity: 1;
+    transform: translateX(0);
+  }
+}
diff --git a/FE/src/features/ai-chat/view/AiChatRecommendations.tsx b/FE/src/features/ai-chat/view/AiChatRecommendations.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..6329de42abb1b4d9b48689c9645a8e66d2251bf3
--- /dev/null
+++ b/FE/src/features/ai-chat/view/AiChatRecommendations.tsx
@@ -0,0 +1,344 @@
+import {
+  useId,
+  useEffect,
+  useRef,
+  useState,
+  type CSSProperties,
+  type PointerEvent,
+} from "react";
+
+import cardSurface from "../../../assets/ai-chat/recommendation-card.svg";
+import peekSurface from "../../../assets/ai-chat/recommendation-peek.svg";
+import stepSurface from "../../../assets/ai-chat/recommendation-step.svg";
+import peekStepSurface from "../../../assets/ai-chat/recommendation-peek-step.svg";
+import skipSurface from "../../../assets/ai-chat/recommendation-skip.svg";
+import addSurface from "../../../assets/ai-chat/recommendation-add.svg";
+import type { RecommendedTask } from "../hooks/useAiChatRecommendations";
+import "./AiChatRecommendations.css";
+
+function CardContent({
+  task,
+  peek = false,
+}: {
+  task: RecommendedTask;
+  peek?: boolean;
+}) {
+  return (
+    <>
+      <img
+        alt=""
+        className="ai-recommendations__surface"
+        draggable={false}
+        src={peek ? peekSurface : cardSurface}
+      />
+      <span className="ai-recommendations__number">
+        {String(task.order).padStart(2, "0")}
+      </span>
+      <strong className="ai-recommendations__title">{task.title}</strong>
+      <span className="ai-recommendations__step">
+        <img
+          alt=""
+          draggable={false}
+          src={peek ? peekStepSurface : stepSurface}
+        />
+        <span title={task.stepTitle}>{task.stepTitle}</span>
+      </span>
+      <span className="ai-recommendations__description">
+        내 로드맵의 세부 할 일로
+        <br />
+        추가할 수 있어요.
+      </span>
+    </>
+  );
+}
+
+export function AiChatRecommendations({
+  tasks,
+  selectedId,
+  status,
+  saving,
+  error,
+  onSelect,
+  onSkip,
+  onAdd,
+  onRetry,
+}: {
+  tasks: RecommendedTask[];
+  selectedId?: string;
+  status: "loading" | "error" | "ready";
+  saving: boolean;
+  error?: string;
+  onSelect: (id: string) => void;
+  onSkip: (id: string) => void;
+  onAdd: (id: string) => void;
+  onRetry: () => void;
+}) {
+  const helpId = useId();
+  const cardRef = useRef<HTMLButtonElement>(null);
+  const completeRef = useRef<HTMLParagraphElement>(null);
+  const errorRef = useRef<HTMLDivElement>(null);
+  const restoreFocus = useRef(false);
+  const gesture = useRef<{ pointerId: number; x: number; y: number } | null>(
+    null,
+  );
+  const [drag, setDrag] = useState<number | null>(null);
+  const [floatingBounds, setFloatingBounds] = useState<{
+    left: number;
+    top: number;
+    width: number;
+    height: number;
+    viewportWidth: number;
+    viewportHeight: number;
+  } | null>(null);
+  const [entryDirection, setEntryDirection] = useState(1);
+  const current = Math.max(
+    0,
+    tasks.findIndex((task) => task.id === selectedId),
+  );
+  const task = tasks[current];
+  useEffect(() => {
+    if (!saving && restoreFocus.current) {
+      (cardRef.current ?? completeRef.current)?.focus();
+      restoreFocus.current = false;
+    }
+  }, [saving, task?.id]);
+  useEffect(() => {
+    errorRef.current?.scrollIntoView?.({ block: "nearest" });
+  }, [error, status]);
+  const add = () => {
+    restoreFocus.current = true;
+    onAdd(task.id);
+  };
+  const skip = () => {
+    restoreFocus.current = true;
+    onSkip(task.id);
+  };
+  const previous =
+    tasks.length > 1
+      ? tasks[(current - 1 + tasks.length) % tasks.length]
+      : undefined;
+  const next =
+    tasks.length > 1 ? tasks[(current + 1) % tasks.length] : undefined;
+  const direction =
+    drag !== null && Math.abs(drag) >= 70 ? (drag < 0 ? "skip" : "add") : null;
+  const rotation = Math.max(-6, Math.min(6, (drag ?? 0) / 12));
+  let visibleX = drag ?? 0;
+  let visibleTop = floatingBounds?.top ?? 0;
+  if (floatingBounds) {
+    const { left, top, width, height, viewportWidth, viewportHeight } =
+      floatingBounds;
+    const radians = (Math.abs(rotation) * Math.PI) / 180;
+    const extraX =
+      (width * Math.cos(radians) + height * Math.sin(radians) - width) / 2;
+    const extraY =
+      (height * Math.cos(radians) + width * Math.sin(radians) - height) / 2;
+    // 회전한 모서리까지 화면 안에 두되, 동작 판정은 실제 손가락 이동량을 쓴다.
+    visibleX = Math.max(
+      8 + extraX - left,
+      Math.min(visibleX, viewportWidth - left - width - extraX - 8),
+    );
+    visibleTop = Math.max(
+      8 + extraY,
+      Math.min(top, viewportHeight - height - extraY - 8),
+    );
+  }
+  const reset = () => {
+    cardRef.current?.hidePopover?.();
+    gesture.current = null;
+    setDrag(null);
+    setFloatingBounds(null);
+  };
+  const move = (event: PointerEvent<HTMLButtonElement>) => {
+    const start = gesture.current;
+    if (!start || event.pointerId !== start.pointerId) return;
+    const dx = event.clientX - start.x;
+    if (Math.abs(event.clientY - start.y) > Math.max(12, Math.abs(dx))) {
+      reset();
+      return;
+    }
+    setDrag(Math.max(-140, Math.min(140, dx)));
+  };
+
+  if (status === "loading")
+    return <p role="status">추천 카드를 불러오고 있어요.</p>;
+  if (status === "error")
+    return (
+      <div className="ai-chat__error" role="alert" ref={errorRef}>
+        <p>추천 카드를 불러오지 못했어요.</p>
+        <button onClick={onRetry} type="button">
+          카드 다시 불러오기
+        </button>
+      </div>
+    );
+  if (!task)
+    return (
+      <p
+        className="ai-recommendations__complete"
+        role="status"
+        ref={completeRef}
+        tabIndex={-1}
+      >
+        추천을 모두 확인했어요.
+      </p>
+    );
+
+  return (
+    <section
+      aria-label="추천 할 일"
+      aria-busy={saving}
+      className={`ai-recommendations${drag !== null ? " ai-recommendations--pressed" : ""}`}
+    >
+      <header className="ai-recommendations__header">
+        <strong>추천 할 일</strong>
+        <span aria-live="polite">
+          {current + 1} / {tasks.length}
+        </span>
+      </header>
+      <p className="ai-recommendations__direction" aria-hidden="true">
+        {drag !== null
+          ? "← 스킵 · 좌우로 드래그 · 추가 →"
+          : "옆 카드를 누르면 다른 추천을 볼 수 있어요."}
+      </p>
+      <div
+        className="ai-recommendations__stage"
+        style={
+          floatingBounds ? { minHeight: floatingBounds.height + 40 } : undefined
+        }
+      >
+        {([previous, next] as const).map((side, index) =>
+          side ? (
+            <button
+              aria-label={`${index === 0 ? "이전" : "다음"} 추천: ${side.title}`}
+              className={`ai-recommendations__peek ai-recommendations__peek--${index === 0 ? "previous" : "next"}`}
+              disabled={saving}
+              key={index}
+              onClick={() => {
+                setEntryDirection(index === 0 ? -1 : 1);
+                onSelect(side.id);
+              }}
+              type="button"
+            >
+              <CardContent task={side} peek />
+            </button>
+          ) : null,
+        )}
+        <button
+          aria-label={`현재 추천: ${task.title}`}
+          aria-describedby={helpId}
+          aria-keyshortcuts="ArrowLeft ArrowRight Delete Enter"
+          className="ai-recommendations__card"
+          popover="manual"
+          key={task.id}
+          ref={cardRef}
+          disabled={saving}
+          onClick={(event) => {
+            if (event.detail === 0) add();
+          }}
+          onKeyDown={(event) => {
+            if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
+              event.preventDefault();
+              const target = event.key === "ArrowLeft" ? previous : next;
+              if (target) {
+                restoreFocus.current = true;
+                setEntryDirection(event.key === "ArrowLeft" ? -1 : 1);
+                onSelect(target.id);
+              }
+            } else if (event.key === "Delete") {
+              event.preventDefault();
+              skip();
+            } else if (event.key === "Escape") reset();
+          }}
+          onLostPointerCapture={reset}
+          onPointerCancel={reset}
+          onPointerDown={(event) => {
+            if (event.isPrimary === false || event.button !== 0 || saving)
+              return;
+            gesture.current = {
+              pointerId: event.pointerId,
+              x: event.clientX,
+              y: event.clientY,
+            };
+            if (event.currentTarget.showPopover) {
+              const { left, top, width, height } =
+                event.currentTarget.getBoundingClientRect();
+              const viewport =
+                event.currentTarget.ownerDocument.documentElement;
+              setFloatingBounds({
+                left,
+                top,
+                width,
+                height,
+                viewportWidth: viewport.clientWidth,
+                viewportHeight: viewport.clientHeight,
+              });
+              event.currentTarget.showPopover();
+            }
+            event.currentTarget.setPointerCapture(event.pointerId);
+            setDrag(0);
+          }}
+          onPointerMove={move}
+          onPointerUp={(event) => {
+            const start = gesture.current;
+            if (!start || event.pointerId !== start.pointerId) return;
+            const distance = event.clientX - start.x;
+            const vertical = event.clientY - start.y;
+            reset();
+            if (Math.abs(vertical) > Math.abs(distance)) return;
+            if (distance <= -70) skip();
+            if (distance >= 70) add();
+          }}
+          style={
+            {
+              "--recommendation-x": `${visibleX}px`,
+              "--recommendation-rotation": `${rotation}deg`,
+              "--recommendation-enter-x": `${entryDirection * 40}px`,
+              "--recommendation-left": `${floatingBounds?.left ?? 0}px`,
+              "--recommendation-top": `${visibleTop}px`,
+              "--recommendation-width": `${floatingBounds?.width ?? 0}px`,
+              "--recommendation-height": `${floatingBounds?.height ?? 0}px`,
+            } as CSSProperties
+          }
+          type="button"
+        >
+          <CardContent task={task} />
+          {direction ? (
+            <span className="ai-recommendations__badge" aria-hidden="true">
+              <img
+                alt=""
+                draggable={false}
+                src={direction === "skip" ? skipSurface : addSurface}
+              />
+              <span>{direction === "skip" ? "스킵 ←" : "추가 ✓"}</span>
+            </span>
+          ) : null}
+          {saving ? (
+            <span className="ai-recommendations__saving" role="status">
+              저장 중…
+            </span>
+          ) : null}
+        </button>
+      </div>
+      <p className="ai-recommendations__hint" aria-hidden="true">
+        {drag !== null
+          ? direction === "skip"
+            ? "손을 떼면 이 추천을 스킵해요"
+            : direction === "add"
+              ? "손을 떼면 내 로드맵에 추가해요"
+              : "손을 떼면 원래 위치로 돌아와요"
+          : "중앙 카드를 누른 채 좌우로 드래그하세요"}
+      </p>
+      <p className="ai-chat__sr-only" id={helpId}>
+        좌우 방향키로 추천 이동, Delete로 스킵, Enter 또는 스페이스로 내
+        로드맵에 추가합니다.
+      </p>
+      {error ? (
+        <div className="ai-chat__error" role="alert" ref={errorRef}>
+          <p>{error}</p>
+          <button disabled={saving} onClick={add} type="button">
+            저장 다시 시도
+          </button>
+        </div>
+      ) : null}
+    </section>
+  );
+}
