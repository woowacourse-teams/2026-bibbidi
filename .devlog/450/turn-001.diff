diff --git a/FE/src/features/ai-chat/hooks/useAiChatRecommendations.ts b/FE/src/features/ai-chat/hooks/useAiChatRecommendations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..343bc8fb4a0ef4dcfc0b58f939e4d11fccbeca09
--- /dev/null
+++ b/FE/src/features/ai-chat/hooks/useAiChatRecommendations.ts
@@ -0,0 +1,228 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+
+import { catalogRepository, type CatalogModel } from "../../catalog";
+import { useMyChecklistQueryRepository } from "../../checklist";
+import {
+  usePreparationChecklistRepository,
+  PreparationAuthenticationRequiredError,
+} from "../../preparation";
+import { PreparationDuplicateChecklistItemError } from "../../preparation/repository/preparationErrors";
+import type { ChatMessage } from "../model/aiChat";
+
+export interface RecommendedTask {
+  id: string;
+  title: string;
+  stepTitle: string;
+  order: number;
+}
+
+interface RecommendationState {
+  dismissed: string[];
+  selectedId?: string;
+  savingId?: string;
+  error?: string;
+}
+
+const EMPTY_STATE: RecommendationState = { dismissed: [] };
+
+export function useAiChatRecommendations(
+  messages: ChatMessage[],
+  isAuthenticated: boolean,
+  onAuthenticationRequired: () => void,
+) {
+  const checklist = usePreparationChecklistRepository();
+  const query = useMyChecklistQueryRepository();
+  const [catalogResult, setCatalogResult] = useState<{
+    catalog?: CatalogModel;
+    failed?: boolean;
+  } | null>(null);
+  const [attempt, setAttempt] = useState(0);
+  const [states, setStates] = useState<Record<number, RecommendationState>>({});
+  const [added, setAdded] = useState<string[]>([]);
+  const requests = useRef(
+    new Map<number, { id: string; controller: AbortController }>(),
+  );
+  const hasRecommendations =
+    isAuthenticated &&
+    messages.some(
+      (message) =>
+        message.role === "assistant" &&
+        message.status === "complete" &&
+        Boolean(message.catalogItemIds?.length),
+    );
+
+  useEffect(() => {
+    if (!hasRecommendations || catalogResult) return;
+    const controller = new AbortController();
+    catalogRepository.getCatalog(controller.signal).then(
+      (catalog) => {
+        if (!controller.signal.aborted) setCatalogResult({ catalog });
+      },
+      () => {
+        if (!controller.signal.aborted) setCatalogResult({ failed: true });
+      },
+    );
+    return () => controller.abort();
+  }, [hasRecommendations, catalogResult, attempt]);
+
+  useEffect(() => {
+    const pending = requests.current;
+    return () => {
+      const cancelled = [...pending.keys()];
+      for (const { controller } of pending.values()) controller.abort();
+      pending.clear();
+      if (cancelled.length)
+        setStates((current) =>
+          Object.fromEntries(
+            Object.entries(current).map(([id, state]) => [
+              id,
+              cancelled.includes(Number(id))
+                ? { ...state, savingId: undefined }
+                : state,
+            ]),
+          ),
+        );
+    };
+  }, [checklist, isAuthenticated]);
+
+  const tasksById = useMemo(() => {
+    const catalog = catalogResult?.catalog;
+    const steps = new Map(
+      catalog?.roadmaps.flatMap((roadmap) =>
+        roadmap.steps.map((step) => [step.id, step.title] as const),
+      ),
+    );
+    return new Map(
+      catalog?.stepDetails.flatMap((detail) =>
+        detail.tasks.map(
+          (task) =>
+            [
+              task.id,
+              { ...task, stepTitle: steps.get(detail.stepId) ?? "" },
+            ] as const,
+        ),
+      ),
+    );
+  }, [catalogResult]);
+
+  const update = (answerId: number, change: Partial<RecommendationState>) => {
+    setStates((current) => ({
+      ...current,
+      [answerId]: { ...(current[answerId] ?? EMPTY_STATE), ...change },
+    }));
+  };
+
+  const cards = (answerId: number, ids: string[]): RecommendedTask[] =>
+    ids.flatMap((id, index) => {
+      const task = tasksById.get(id);
+      return task &&
+        !added.includes(id) &&
+        !states[answerId]?.dismissed.includes(id)
+        ? [
+            {
+              id,
+              title: task.title,
+              stepTitle: task.stepTitle,
+              order: index + 1,
+            },
+          ]
+        : [];
+    });
+
+  const nextCardId = (answerId: number, id: string) => {
+    const message = messages.find((message) => message.id === answerId);
+    const current = cards(
+      answerId,
+      message?.role === "assistant" ? (message.catalogItemIds ?? []) : [],
+    );
+    const index = current.findIndex((task) => task.id === id);
+    const remaining = current.filter((task) => task.id !== id);
+    return remaining[Math.min(Math.max(0, index), remaining.length - 1)]?.id;
+  };
+
+  const skip = (answerId: number, id: string) => {
+    if (!isAuthenticated || requests.current.has(answerId)) return;
+    setStates((current) => {
+      const state = current[answerId] ?? EMPTY_STATE;
+      return {
+        ...current,
+        [answerId]: {
+          ...state,
+          dismissed: [...state.dismissed, id],
+          selectedId: nextCardId(answerId, id),
+          error: undefined,
+        },
+      };
+    });
+  };
+
+  const add = async (answerId: number, id: string) => {
+    if (
+      !isAuthenticated ||
+      requests.current.has(answerId) ||
+      [...requests.current.values()].some((request) => request.id === id)
+    )
+      return;
+    const controller = new AbortController();
+    requests.current.set(answerId, { id, controller });
+    update(answerId, { savingId: id, error: undefined });
+    try {
+      const existing = await checklist.getCatalogItemIds(
+        "authenticated",
+        controller.signal,
+      );
+      if (controller.signal.aborted) return;
+      if (!existing.includes(id))
+        await checklist.addCatalogItemIds(
+          "authenticated",
+          [id],
+          controller.signal,
+        );
+      if (!controller.signal.aborted) {
+        setAdded((current) => [...new Set([...current, id])]);
+        update(answerId, { selectedId: nextCardId(answerId, id) });
+      }
+    } catch (error) {
+      if (controller.signal.aborted) return;
+      if (error instanceof PreparationDuplicateChecklistItemError) {
+        setAdded((current) => [...new Set([...current, id])]);
+        update(answerId, { selectedId: nextCardId(answerId, id) });
+        // 다른 화면/기기에서 먼저 추가한 항목도 공통 조회 상태에 반영한다.
+        void query.refresh(controller.signal).catch(() => {});
+      } else {
+        const expired = error instanceof PreparationAuthenticationRequiredError;
+        update(answerId, {
+          error: expired
+            ? "로그인이 만료됐어요. 다시 로그인한 뒤 시도해 주세요."
+            : "할 일을 저장하지 못했어요. 다시 시도해 주세요.",
+        });
+        if (expired) onAuthenticationRequired();
+      }
+    } finally {
+      if (requests.current.get(answerId)?.controller === controller) {
+        requests.current.delete(answerId);
+        update(answerId, { savingId: undefined });
+      }
+    }
+  };
+
+  return {
+    cards,
+    states,
+    catalogStatus: catalogResult?.catalog
+      ? ("ready" as const)
+      : catalogResult?.failed
+        ? ("error" as const)
+        : ("loading" as const),
+    retryCatalog: () => {
+      setCatalogResult(null);
+      setAttempt((value) => value + 1);
+    },
+    select: (answerId: number, id: string) => {
+      if (!requests.current.has(answerId))
+        update(answerId, { selectedId: id, error: undefined });
+    },
+    skip,
+    add,
+  };
+}
