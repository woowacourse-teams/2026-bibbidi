diff --git a/FE/src/test/dialog.ts b/FE/src/test/dialog.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4f11f645369c2f4c51e1e88c7e96fb1e2cb3215d
--- /dev/null
+++ b/FE/src/test/dialog.ts
@@ -0,0 +1,34 @@
+export function installDialogMock() {
+  const descriptors = Object.getOwnPropertyDescriptors(
+    HTMLDialogElement.prototype,
+  );
+  Object.defineProperties(HTMLDialogElement.prototype, {
+    showModal: {
+      configurable: true,
+      value(this: HTMLDialogElement) {
+        this.setAttribute("open", "");
+      },
+    },
+    close: {
+      configurable: true,
+      value(this: HTMLDialogElement) {
+        this.removeAttribute("open");
+      },
+    },
+  });
+
+  return () => {
+    for (const method of ["showModal", "close"] as const) {
+      if (descriptors[method])
+        Object.defineProperty(
+          HTMLDialogElement.prototype,
+          method,
+          descriptors[method],
+        );
+      else
+        delete (HTMLDialogElement.prototype as Partial<HTMLDialogElement>)[
+          method
+        ];
+    }
+  };
+}
