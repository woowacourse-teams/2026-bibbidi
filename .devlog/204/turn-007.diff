@@ -0,0 +1,26 @@
+import { readFile } from "node:fs/promises";
+import { load } from "js-yaml";
+
+export type ReviewPrompts = {
+  commonInstructions: string;
+  stageInputTemplate: string;
+  finalInputTemplate: string;
+};
+
+function isReviewPrompts(value: unknown): value is ReviewPrompts {
+  if (!value || typeof value !== "object") return false;
+  const prompts = value as Record<string, unknown>;
+  return [
+    prompts.commonInstructions,
+    prompts.stageInputTemplate,
+    prompts.finalInputTemplate,
+  ].every((item) => typeof item === "string");
+}
+
+export async function loadReviewPrompts(path: URL): Promise<ReviewPrompts> {
+  const parsed = load(await readFile(path, "utf8"));
+  if (!isReviewPrompts(parsed)) {
+    throw new Error("AI review prompt file has an invalid format");
+  }
+  return parsed;
+}
