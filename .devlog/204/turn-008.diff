diff --git a/.github/ai-review/service/ai-review-service.ts b/.github/ai-review/service/ai-review-service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3cb72687e1430f59eea76be3458f75f5df4e88db
--- /dev/null
+++ b/.github/ai-review/service/ai-review-service.ts
@@ -0,0 +1,74 @@
+import { readFile } from "node:fs/promises";
+import type { PullRequestFile, ReviewPrompts, ReviewResult } from "../client/ai-review-client.ts";
+
+type Finding = ReviewResult["findings"][number];
+
+const stages = [
+  ["language", "none", "언어 문법, 타입 안정성, null 처리, 자원 정리, 오류 처리 누락과 저장소 컨벤션 위반을 검토한다."],
+  ["framework", "low", "프레임워크와 인프라 관점에서 트랜잭션, 영속성, HTTP 계약, React 상태 흐름, 빌드와 배포 설정의 문제를 검토한다."],
+  ["domain-security", "medium", "도메인 규칙, 동시성, 인증과 인가, 민감정보 노출, 데이터 무결성, 장애 복구와 경계 조건을 검토한다."],
+] as const;
+const finalStage = ["medium", "앞선 검토 결과를 원본 diff와 다시 대조한다. 오탐과 중복을 제거하고, 실제 변경 줄에 근거한 재현 가능하고 구체적인 지적만 남긴다."] as const;
+const conventions = ["docs/convention/code-convention.md", "docs/convention/error-handling.md", "docs/convention/test-strategy.md"];
+
+export function collectCommentableLines(files: PullRequestFile[]) {
+  const lines = new Map<string, Set<string>>();
+  for (const file of files) {
+    if (!file.patch) continue;
+    const commentable = new Set<string>(); let oldLine = 0; let newLine = 0;
+    for (const line of file.patch.split("\n")) {
+      const hunk = line.match(/^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@/);
+      if (hunk) { oldLine = Number(hunk[1]); newLine = Number(hunk[2]); continue; }
+      if (line.startsWith("+") && !line.startsWith("+++")) { commentable.add(`RIGHT:${newLine++}`); }
+      else if (line.startsWith("-") && !line.startsWith("---")) { commentable.add(`LEFT:${oldLine++}`); }
+      else if (line.startsWith(" ")) { commentable.add(`LEFT:${oldLine++}`); commentable.add(`RIGHT:${newLine++}`); }
+    }
+    lines.set(file.filename, commentable);
+  }
+  return lines;
+}
+
+export function selectValidFindings(findings: Finding[], lines: Map<string, Set<string>>, limit = 20) {
+  const rank = { REQUIRED: 0, CAUTION: 1, ADVICE: 2 }; const seen = new Set<string>();
+  return findings.filter((finding) => {
+    const key = [finding.path, finding.side, finding.line, finding.title.trim().toLowerCase()].join(":");
+    if (!lines.get(finding.path)?.has(`${finding.side}:${finding.line}`) || seen.has(key)) return false;
+    seen.add(key); return true;
+  }).sort((left, right) => rank[left.severity] - rank[right.severity]).slice(0, limit);
+}
+
+export function buildDiffBundle(files: PullRequestFile[], limit = 180_000) {
+  const sections: string[] = []; let used = 0; let omittedFiles = 0;
+  for (const file of files) {
+    const section = `FILE: ${file.filename}\nSTATUS: ${file.status}\nCHANGES: +${file.additions} -${file.deletions}\n${file.patch ?? "[binary file or patch unavailable]"}\n`;
+    if (used + section.length > limit) { omittedFiles += 1; continue; }
+    sections.push(section); used += section.length;
+  }
+  return { text: sections.join("\n"), omittedFiles, includedFiles: sections.length };
+}
+
+const fill = (template: string, values: Record<string, string>) => template.replace(/{{(\w+)}}/g, (_, key: string) => values[key] ?? "");
+
+async function loadConventions(files: PullRequestFile[]) {
+  if (!files.some((file) => file.filename.startsWith("BE/"))) return "이 변경 영역에는 별도로 문서화된 코드 컨벤션이 없다. 기존 코드와 패키지 스크립트를 기준으로 검토한다.";
+  const documents = await Promise.all(conventions.map(async (path) => {
+    try { return `# ${path}\n${await readFile(path, "utf8")}`; } catch (error) { if (error.code === "ENOENT") return ""; throw error; }
+  }));
+  return documents.filter(Boolean).join("\n\n");
+}
+
+export async function runReview({ github, openai, pullNumber, expectedHeadSha, prompts }: { github: ReturnType<typeof import("../client/ai-review-client.ts").createGitHubClient>; openai: ReturnType<typeof import("../client/ai-review-client.ts").createOpenAIClient>; pullNumber: number; expectedHeadSha: string; prompts: ReviewPrompts }) {
+  const [pullRequest, files] = await Promise.all([github.getPullRequest(pullNumber), github.getPullRequestFiles(pullNumber)]);
+  if (pullRequest.head.sha !== expectedHeadSha) throw new Error("Pull request head changed before review started");
+  const diff = buildDiffBundle(files); const rules = await loadConventions(files); const cacheKey = `bibbidi-pr-${pullNumber}-${expectedHeadSha}`;
+  const values = { conventions: rules, title: pullRequest.title, body: pullRequest.body || "(empty)", base: pullRequest.base.ref, head: pullRequest.head.ref, diff: diff.text };
+  const results = [];
+  for (const [, effort, focus] of stages) results.push(await openai.review({ instructions: prompts.commonInstructions, input: fill(prompts.stageInputTemplate, { ...values, stageFocus: focus }), reasoningEffort: effort, cacheKey }));
+  const candidates = results.flatMap((result) => result.findings);
+  const final = await openai.review({ instructions: prompts.commonInstructions, input: fill(prompts.finalInputTemplate, { ...values, candidates: JSON.stringify(candidates), stageFocus: finalStage[1] }), reasoningEffort: finalStage[0], cacheKey });
+  if ((await github.getPullRequest(pullNumber)).head.sha !== expectedHeadSha) throw new Error("Pull request head changed while review was running");
+  const findings = selectValidFindings(final.findings, collectCommentableLines(files));
+  const count = (severity: Finding["severity"]) => findings.filter((finding) => finding.severity === severity).length;
+  const body = `## 🤖 Bibbidi AI 코드 리뷰 Harness\n\n${final.summary.trim() || "인라인으로 남길 높은 확신의 지적을 찾지 못했습니다."}\n\n| 심각도 | 개수 |\n| --- | ---: |\n| REQUIRED | ${count("REQUIRED")} |\n| CAUTION | ${count("CAUTION")} |\n| ADVICE | ${count("ADVICE")} |\n\n모델: \`gpt-5.6-luna\` · 인라인 코멘트: ${findings.length}/20${diff.omittedFiles ? `\n\n> diff 크기 제한으로 ${files.length}개 파일 중 ${diff.omittedFiles}개 파일의 patch가 제외되었습니다.` : ""}\n\n> AI 리뷰는 참고용입니다. 최종 판단과 승인은 사람 리뷰어가 담당합니다.`;
+  return github.createReview(pullNumber, { commit_id: expectedHeadSha, event: "COMMENT", body, comments: findings.map((finding) => ({ path: finding.path, side: finding.side, line: finding.line, body: `**[${finding.severity}] ${finding.title.trim()}**\n\n${finding.explanation.trim()}${finding.suggestion.trim() ? `\n\n**제안**\n${finding.suggestion.trim()}` : ""}` })) });
+}
