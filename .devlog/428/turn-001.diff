+    return promise;
+  });
+  return {
+    delta: (text: string) => act(() => receiver.onDelta(text)),
+    complete: () => act(async () => resolve()),
+    fail: (error = new Error("secret failure")) =>
+      act(async () => reject(error)),
+    signal: () => signal,
+  };
