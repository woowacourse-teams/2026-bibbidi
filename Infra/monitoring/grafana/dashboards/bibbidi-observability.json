{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Service Overview",
      "id": 1,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "API Requests",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{uri=~\"/api/(checklists|appointments|auth|users).*\"}[5m]))",
          "legendFormat": "{{uri}} {{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "5xx Error Rate",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1)",
          "legendFormat": "5xx rate"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Availability",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count[5m])), 1))",
          "legendFormat": "availability"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Request Duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 5
    },
    {
      "type": "row",
      "title": "JVM",
      "id": 6,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "{{id}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "GC Pause Time",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[5m])",
          "legendFormat": "{{action}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Threads",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "live"
        },
        {
          "expr": "jvm_threads_daemon_threads",
          "legendFormat": "daemon"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "process_cpu_usage",
          "legendFormat": "process"
        },
        {
          "expr": "system_cpu_usage",
          "legendFormat": "system"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "Database Pool",
      "id": 11,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "timeseries",
      "title": "Hikari Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "active"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "idle"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Connection Acquire Time",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "rate(hikaricp_connection_acquire_seconds_sum[5m]) / clamp_min(rate(hikaricp_connection_acquire_seconds_count[5m]), 1)",
          "legendFormat": "mean acquire time"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "id": 13
    },
    {
      "type": "row",
      "title": "Nginx",
      "id": 14,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      }
    },
    {
      "type": "timeseries",
      "title": "Nginx Requests",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total[5m]))",
          "legendFormat": "requests"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Nginx Status Codes",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(nginx_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "id": 16
    },
    {
      "type": "timeseries",
      "title": "Nginx Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "bibbidi-prometheus"
      },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "active"
        },
        {
          "expr": "nginx_connections_waiting",
          "legendFormat": "waiting"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "id": 17
    },
    {
      "type": "row",
      "title": "Logs",
      "id": 18,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 60
      }
    },
    {
      "type": "logs",
      "title": "Error Logs",
      "datasource": {
        "type": "loki",
        "uid": "bibbidi-loki"
      },
      "targets": [
        {
          "expr": "{service_name=~\"$service\", deployment_environment_name=\"$environment\"} |~ \"(?i)error|exception\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 61
      },
      "id": 19
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "bibbidi",
    "service",
    "jvm",
    "database",
    "nginx",
    "logs"
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "bibbidi-loki"
        },
        "query": "label_values(service_name)",
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "bibbidi-loki"
        },
        "query": "label_values(deployment_environment_name)",
        "current": {
          "text": "production",
          "value": "production"
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Bibbidi Observability",
  "uid": "bibbidi-observability",
  "version": 1
}
