            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "showTime": true,
          "showLabels": false,
          "wrapLogMessage": true,
          "sortOrder": "Descending",
          "enableLogDetails": true
        }
      },
