            }
          ]
        }
      },
      {
        "id": 32,
        "title": "느린 API·소셜 콜백 트레이스",
        "description": "일반 API 1초 초과 또는 소셜 콜백 3초 초과 요청입니다. AI 채팅과 Actuator는 제외합니다.",
        "type": "table",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "gridPos": {
          "x": 0,
          "y": 21,
          "w": 24,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "tempo",
              "uid": "tempo"
            },
            "query": "{resource.deployment.environment.name=\"$env\" && kind=server && duration > 1s && name !~ \".*/api/ai/chat.*\" && name !~ \".*/callback.*\" && name !~ \".*actuator.*\"} || {resource.deployment.environment.name=\"$env\" && kind=server && duration > 3s && name =~ \".*/callback.*\"}",
            "queryType": "traceql",
            "limit": 30,
            "tableType": "traces"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": [
            {
              "displayName": "Value",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 41,
        "title": "backend 오류 로그",
        "description": "오류 원인을 놓치지 않도록 AI 관련 오류도 포함합니다. trace_id 링크로 Tempo를 확인합니다.",
        "type": "logs",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "gridPos": {
          "x": 0,
          "y": 28,
          "w": 12,
          "h": 10
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "{service_name=\"bibbidi-backend\",deployment_environment_name=\"$env\"} | severity_text=~\"(?i)error|fatal\"",
            "range": true,
            "instant": false,
            "editorMode": "code",
            "legendFormat": "backend 오류 로그",
            "queryType": "range"
          }
        ],
        "fieldConfig": {
