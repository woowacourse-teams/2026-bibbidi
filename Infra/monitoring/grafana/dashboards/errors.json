      {
        "id": 26,
        "title": "실패 API · 선택 기간",
        "description": "",
        "type": "table",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 14,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "topk(20,sum by(method,uri,status)(increase(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\",status=~\"5..\"}[$__range])) > 0)",
            "range": false,
            "instant": true,
            "editorMode": "code",
            "legendFormat": "{{method}} {{uri}} · {{status}}",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": [
            {
              "displayName": "Value",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 27,
        "title": "실패 요청 트레이스",
        "description": "",
        "type": "table",
        "datasource": {
          "type": "tempo",
          "uid": "tempo"
        },
        "gridPos": {
          "x": 12,
          "y": 14,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "tempo",
              "uid": "tempo"
            },
            "query": "{resource.deployment.environment.name=\"$env\" && kind=server && status=error && name !~ \".*/api/ai/chat.*\"}",
            "queryType": "traceql",
            "limit": 30,
            "tableType": "traces"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
