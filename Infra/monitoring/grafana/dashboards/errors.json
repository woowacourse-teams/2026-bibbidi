{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "bibbidi-alerts"
  },
  "spec": {
    "title": "비비디 · 에러 대응",
    "description": "실패한 일반 API와 사용자 영향 범위를 확인하고 같은 시간대 로그·트레이스로 이동합니다. AI 채팅은 AI 대시보드에서 확인합니다.",
    "schemaVersion": 41,
    "version": 1,
    "editable": false,
    "tags": [
      "bibbidi",
      "managed"
    ],
    "timezone": "Asia/Seoul",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "읽는 순서",
        "description": "",
        "type": "text",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 3
        },
        "targets": [],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "mode": "markdown",
          "content": "**영향 확인 → 실패 API 확인 → 로그·트레이스 추적.** 일반 API는 `/actuator.*`, `/api/ai/chat`을 제외합니다. 지연은 소셜 콜백도 제외합니다. 5xx는 앱 응답 기준이며 nginx가 만든 502·503·504는 별도 표시합니다. 트래픽이 없으면 비율·분위수는 `측정 없음`입니다."
        }
      },
      {
        "id": 11,
        "title": "앱 수집 상태",
        "description": "1=수집 중, 0=수집 실패. 정상 응답을 보장하는 가용성 지표는 아닙니다.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "max(up{job=\"prometheus.scrape.bibbidi_backend\",deployment_environment_name=\"$env\"})",
            "range": true,
            "instant": false,
            "editorMode": "code",
            "legendFormat": "앱 수집 상태"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": {
                    "text": "수집 실패",
                    "color": "red"
                  },
                  "1": {
                    "text": "수집 중",
                    "color": "green"
                  }
                }
              }
            ]
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "id": 12,
        "title": "일반 API 5xx · 최근 5분",
        "description": "",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 4,
          "y": 3,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum(increase(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\",status=~\"5..\"}[5m])) or (0 * sum(increase(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\"}[5m])))",
            "range": true,
            "instant": false,
            "editorMode": "code",
            "legendFormat": "일반 API 5xx · 최근 5분"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "id": 13,
        "title": "일반 API 실패율",
        "description": "5xx / 일반 API 요청. 0.1%는 #456의 잠정 기준입니다.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 8,
          "y": 3,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "(sum(rate(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\"}[$__rate_interval])) > 0)",
            "range": true,
            "instant": false,
            "editorMode": "code",
            "legendFormat": "일반 API 실패율"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "noValue": "측정 없음",
            "color": {
              "mode": "thresholds"
            },
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 0.001
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "id": 21,
        "title": "일반 API p95",
        "description": "잠정 목표 500ms. W2 알림은 1초 초과가 10분 지속될 때 발생합니다.",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 3,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "histogram_quantile(0.95,sum by (le) (rate(http_server_requests_seconds_bucket{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\",uri!~\".*/callback\"}[$__rate_interval])))",
            "range": true,
            "instant": false,
            "editorMode": "code",
            "legendFormat": "일반 API p95"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "측정 없음",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 0.5
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
