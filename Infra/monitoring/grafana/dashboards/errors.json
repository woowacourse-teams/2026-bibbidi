      {
        "id": 23,
        "title": "nginx 502·503·504 · 최근 5분",
        "description": "AI 채팅을 포함한 전체 nginx 게이트웨이 오류입니다. 앱에 도착하지 못한 요청도 확인합니다.",
        "type": "stat",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "gridPos": {
          "x": 20,
          "y": 3,
          "w": 4,
          "h": 4
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "loki",
              "uid": "loki"
            },
            "expr": "sum(count_over_time({service_name=\"nginx\",deployment_environment_name=\"$env\"} | json | http_response_status_code=~\"502|503|504\" | __error__=\"\" [5m])) or vector(0)",
            "range": false,
            "instant": true,
            "editorMode": "code",
            "legendFormat": "nginx 502·503·504 · 최근 5분",
            "queryType": "instant"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
