{
  "apiVersion": "dashboard.grafana.app/v1",
  "kind": "Dashboard",
  "metadata": {
    "name": "bibbidi-spring"
  },
  "spec": {
    "title": "비비디 · 서비스 성능",
    "description": "일반 API의 트래픽·응답 시간·실패율을 자원 사용과 비교해 병목과 용량을 판단합니다.",
    "schemaVersion": 41,
    "version": 1,
    "editable": false,
    "tags": [
      "bibbidi",
      "managed"
    ],
    "timezone": "Asia/Seoul",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "판단할 것",
        "description": "",
        "type": "text",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 3
        },
        "targets": [],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "mode": "markdown",
          "content": "요청량이 늘 때 **지연·실패율과 어떤 자원이 함께 상승하는지** 비교합니다. 일반 API 집계는 AI 채팅과 Actuator를 제외하고 지연은 소셜 콜백도 제외합니다. 공유 JVM·DB 자원에는 AI 부하도 포함됩니다. 임계선은 잠정 기준이며 요청 수가 적을 때는 p99 해석에 주의합니다."
        }
      },
      {
        "id": 11,
        "title": "일반 API 요청량",
        "description": "",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 3,
          "w": 6,
          "h": 5
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "sum(rate(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\"}[$__rate_interval]))",
            "range": true,
            "instant": false,
            "editorMode": "code",
            "legendFormat": "일반 API 요청량"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "id": 12,
        "title": "일반 API 실패율",
        "description": "",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 6,
          "y": 3,
          "w": 6,
          "h": 5
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "(sum(rate(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\",status=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\"}[$__rate_interval])))) / (sum(rate(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\"}[$__rate_interval])) > 0)",
            "range": true,
            "instant": false,
            "editorMode": "code",
            "legendFormat": "일반 API 실패율"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "noValue": "측정 없음",
            "color": {
              "mode": "thresholds"
            },
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 0.001
                }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "colorMode": "value",
          "graphMode": "none",
          "textMode": "auto"
        }
      },
      {
        "id": 14,
        "title": "일반 API p95",
        "description": "",
        "type": "stat",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
