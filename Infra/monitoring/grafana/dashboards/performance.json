      {
        "id": 19,
        "title": "요청 많은 API Top 10",
        "description": "선택한 기간의 일반 API 요청 수를 method·uri별로 집계합니다.",
        "type": "table",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 15,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "topk(10,sum by(method,uri)(increase(http_server_requests_seconds_count{deployment_environment_name=\"$env\",uri!~\"/actuator.*|/api/ai/chat\"}[$__range])))",
            "range": false,
            "instant": true,
            "editorMode": "code",
            "legendFormat": "{{method}} {{uri}}",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
