            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT COALESCE(u.nickname,'삭제된 사용자') AS nickname,t.user_prompt,t.completion,t.model,t.outcome,t.outcome_reason,t.duration_ms,DATE_FORMAT(t.started_at,'%Y-%m-%d %H:%i:%s') AS started_at,t.conversation_id,t.id,t.user_id,DATE_FORMAT(t.created_at,'%Y-%m-%d %H:%i:%s') AS created_at,DATE_FORMAT(t.updated_at,'%Y-%m-%d %H:%i:%s') AS updated_at FROM chat_turns t LEFT JOIN users u ON u.id=t.user_id WHERE t.user_id < 900000000 AND $__timeFilter(t.started_at) AND ($user_id = -1 OR t.user_id = $user_id) AND (${conversation_id:sqlstring} = '__all__' OR t.conversation_id = ${conversation_id:sqlstring}) ORDER BY t.started_at ASC,t.id ASC LIMIT 400",
