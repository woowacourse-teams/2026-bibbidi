      {
        "id": 9,
        "title": "운영 실패·취소 원인",
        "description": "",
        "type": "table",
        "datasource": {
          "type": "mysql",
          "uid": "mysql"
        },
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 7
