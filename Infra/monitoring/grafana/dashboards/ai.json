      {
        "id": 15,
        "title": "대화별 요약 · ID를 눌러 상세 보기",
        "description": "",
        "type": "table",
        "datasource": {
          "type": "mysql",
          "uid": "mysql"
        },
        "gridPos": {
          "x": 0,
          "y": 38,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT t.conversation_id, t.user_id, COALESCE(u.nickname,'삭제된 사용자') AS nickname, DATE_FORMAT(MIN(t.started_at),'%Y-%m-%d %H:%i:%s') AS first_turn, DATE_FORMAT(MAX(t.started_at),'%Y-%m-%d %H:%i:%s') AS last_turn, COUNT(*) AS turns, SUM(t.outcome='COMPLETED') AS completed, SUM(t.outcome='FAILED') AS failed, SUM(t.outcome='CANCELLED') AS cancelled FROM chat_turns t LEFT JOIN users u ON u.id=t.user_id WHERE t.user_id < 900000000 AND $__timeFilter(t.started_at) AND ($user_id = -1 OR t.user_id = $user_id) AND (${conversation_id:sqlstring} = '__all__' OR t.conversation_id = ${conversation_id:sqlstring}) GROUP BY t.conversation_id,t.user_id,u.nickname ORDER BY last_turn DESC LIMIT 200",
            "format": "table",
            "editorMode": "code",
            "rawQuery": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "conversation_id"
              },
              "properties": [
                {
                  "id": "links",
                  "value": [
                    {
                      "title": "이 대화 보기",
