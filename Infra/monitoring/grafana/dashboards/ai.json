              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT $__timeGroupAlias(started_at,'$__interval'), outcome AS metric, COUNT(*) AS value FROM chat_turns WHERE user_id < 900000000 AND $__timeFilter(started_at) AND ($user_id = -1 OR user_id = $user_id) AND (${conversation_id:sqlstring} = '__all__' OR conversation_id = ${conversation_id:sqlstring}) GROUP BY 1,2 ORDER BY 1",
            "format": "time_series",
            "editorMode": "code",
            "rawQuery": true
