        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT SUM(outcome='FAILED') / NULLIF(COUNT(*),0) AS failure_rate FROM chat_turns WHERE user_id < 900000000 AND $__timeFilter(started_at) AND ($user_id = -1 OR user_id = $user_id) AND (${conversation_id:sqlstring} = '__all__' OR conversation_id = ${conversation_id:sqlstring})",
            "format": "table",
            "editorMode": "code",
            "rawQuery": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "noValue": "측정 없음",
