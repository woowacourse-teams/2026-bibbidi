      {
        "id": 17,
        "title": "운영 난도별 전체 응답 시간 · P50·P95·P99·평균",
        "description": "chat_turns.model이 LOW·MEDIUM·HIGH인 운영 턴만 집계합니다. 실패·취소도 포함합니다. 단위: ms.",
        "type": "table",
        "datasource": {
          "type": "mysql",
          "uid": "mysql"
        },
        "gridPos": {
          "x": 0,
          "y": 62,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "WITH ranked AS (SELECT model,duration_ms,ROW_NUMBER() OVER(PARTITION BY model ORDER BY duration_ms) AS rn,COUNT(*) OVER(PARTITION BY model) AS n FROM chat_turns WHERE model IN ('LOW','MEDIUM','HIGH') AND user_id < 900000000 AND $__timeFilter(started_at) AND ($user_id = -1 OR user_id = $user_id) AND (${conversation_id:sqlstring} = '__all__' OR conversation_id = ${conversation_id:sqlstring})) SELECT model,MAX(n) AS turns,AVG(duration_ms) AS avg_ms,MAX(CASE WHEN rn=CEIL(n*0.5) THEN duration_ms END) AS p50_ms,MAX(CASE WHEN rn=CEIL(n*0.95) THEN duration_ms END) AS p95_ms,MAX(CASE WHEN rn=CEIL(n*0.99) THEN duration_ms END) AS p99_ms FROM ranked GROUP BY model ORDER BY turns DESC",
            "format": "table",
            "editorMode": "code",
            "rawQuery": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": [
            {
              "displayName": "Value",
              "desc": true
            }
          ]
        }
      },
      {
        "id": 19,
        "title": "난도별 TTFT · P50·P95·P99·평균",
        "description": "LOW·MEDIUM·HIGH인 model 라벨이 있는 TTFT만 집계합니다. 첫 delta를 보낸 턴만 포함하며, DB의 전체 응답 시간으로 대체하지 않습니다.",
        "type": "table",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 12,
          "y": 9,
          "w": 12,
          "h": 7
