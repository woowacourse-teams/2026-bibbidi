      {
        "id": 6,
        "title": "전체 TTFT · P50·P95·P99·평균",
        "description": "선택한 기간의 첫 SSE 이벤트 전달 시간을 집계합니다. 사용자·대화 필터는 적용되지 않습니다.",
        "type": "table",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "gridPos": {
          "x": 0,
          "y": 9,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "(label_replace(histogram_quantile(0.5,sum by(le)(increase(ai_chat_ttft_seconds_bucket{deployment_environment_name=\"$env\"}[$__range]))),\"stat\",\"P50\",\"__name__\",\".*\")) or (label_replace(histogram_quantile(0.95,sum by(le)(increase(ai_chat_ttft_seconds_bucket{deployment_environment_name=\"$env\"}[$__range]))),\"stat\",\"P95\",\"__name__\",\".*\")) or (label_replace(histogram_quantile(0.99,sum by(le)(increase(ai_chat_ttft_seconds_bucket{deployment_environment_name=\"$env\"}[$__range]))),\"stat\",\"P99\",\"__name__\",\".*\")) or (label_replace(sum(increase(ai_chat_ttft_seconds_sum{deployment_environment_name=\"$env\"}[$__range])) / sum(increase(ai_chat_ttft_seconds_count{deployment_environment_name=\"$env\"}[$__range])),\"stat\",\"평균\",\"__name__\",\".*\"))",
            "instant": true,
            "range": false,
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": [
            {
              "displayName": "stat",
              "desc": false
            }
          ]
        },
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true
              },
              "renameByName": {
                "stat": "통계",
                "Value": "TTFT"
              }
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "운영 전체 응답 시간 · 모델별 평균",
        "description": "",
        "type": "timeseries",
        "datasource": {
          "type": "mysql",
          "uid": "mysql"
        },
        "gridPos": {
          "x": 0,
          "y": 70,
          "w": 24,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT $__timeGroupAlias(started_at,'$__interval'), model AS metric, AVG(duration_ms) / 1000 AS value FROM chat_turns WHERE user_id < 900000000 AND $__timeFilter(started_at) AND ($user_id = -1 OR user_id = $user_id) AND (${conversation_id:sqlstring} = '__all__' OR conversation_id = ${conversation_id:sqlstring}) GROUP BY 1,2 ORDER BY 1",
            "format": "time_series",
            "editorMode": "code",
            "rawQuery": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
      },
      {
        "id": 8,
