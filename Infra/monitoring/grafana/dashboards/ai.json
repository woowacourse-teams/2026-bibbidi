        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "prometheus"
            },
            "expr": "(label_replace(histogram_quantile(0.5,sum by(le,model)(increase(ai_chat_ttft_seconds_bucket{deployment_environment_name=\"$env\",model=~\"LOW|MEDIUM|HIGH\"}[$__range]))),\"stat\",\"P50\",\"__name__\",\".*\")) or (label_replace(histogram_quantile(0.95,sum by(le,model)(increase(ai_chat_ttft_seconds_bucket{deployment_environment_name=\"$env\",model=~\"LOW|MEDIUM|HIGH\"}[$__range]))),\"stat\",\"P95\",\"__name__\",\".*\")) or (label_replace(histogram_quantile(0.99,sum by(le,model)(increase(ai_chat_ttft_seconds_bucket{deployment_environment_name=\"$env\",model=~\"LOW|MEDIUM|HIGH\"}[$__range]))),\"stat\",\"P99\",\"__name__\",\".*\")) or (label_replace(sum by(model)(increase(ai_chat_ttft_seconds_sum{deployment_environment_name=\"$env\",model=~\"LOW|MEDIUM|HIGH\"}[$__range])) / sum by(model)(increase(ai_chat_ttft_seconds_count{deployment_environment_name=\"$env\",model=~\"LOW|MEDIUM|HIGH\"}[$__range])),\"stat\",\"평균\",\"__name__\",\".*\"))",
            "instant": true,
            "range": false,
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "noValue": "측정 없음",
