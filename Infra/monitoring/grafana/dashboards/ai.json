        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT outcome, COALESCE(outcome_reason,'unknown') AS reason, COUNT(*) AS turns FROM chat_turns WHERE user_id < 900000000 AND $__timeFilter(started_at) AND ($user_id = -1 OR user_id = $user_id) AND (${conversation_id:sqlstring} = '__all__' OR conversation_id = ${conversation_id:sqlstring}) AND outcome <> 'COMPLETED' GROUP BY outcome,reason ORDER BY turns DESC",
            "format": "table",
            "editorMode": "code",
            "rawQuery": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
