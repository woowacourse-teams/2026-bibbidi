            },
            "format": "table",
            "rawSql": "SELECT u.id AS user_id,u.nickname,u.email,u.status,u.role,DATE_FORMAT(u.wedding_date,'%Y-%m-%d') AS wedding_date,si.provider AS login_provider,DATE_FORMAT(u.created_at,'%Y-%m-%d %H:%i:%s') AS signed_up_at,DATE_FORMAT(MIN(rs.created_at),'%Y-%m-%d %H:%i:%s') AS first_return_in_range,DATE_FORMAT(MAX(rs.created_at),'%Y-%m-%d %H:%i:%s') AS last_return_in_range,COUNT(DISTINCT DATE(rs.created_at)) AS return_days,COUNT(*) AS sessions_issued,GROUP_CONCAT(DISTINCT rs.client_type ORDER BY rs.client_type SEPARATOR ', ') AS client_types FROM refresh_sessions rs JOIN users u ON u.id=rs.user_id LEFT JOIN social_identities si ON si.user_id=u.id WHERE u.id < 900000000 AND u.id NOT IN (${excluded_user_ids:csv}) AND DATE(rs.created_at)>DATE(u.created_at) AND $__timeFilter(rs.created_at) AND rs.created_at >= NOW()-INTERVAL 30 DAY GROUP BY u.id,u.nickname,u.email,u.status,u.role,u.wedding_date,u.created_at,si.provider ORDER BY last_return_in_range DESC,u.id DESC LIMIT 1000",
            "rawQuery": true,
            "editorMode": "code"
