      {
        "id": 7,
        "title": "가입일별 7일 내 재방문 · 관찰 완료 코호트",
        "description": "가입 후 24시간 이후부터 8일이 되기 전까지의 세션 발급을 재방문으로 봅니다. 비율과 함께 분모(가입자 수)를 확인합니다.",
        "type": "table",
        "datasource": {
          "type": "mysql",
          "uid": "mysql"
        },
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT DATE_FORMAT(u.created_at,'%Y-%m-%d') AS cohort, COUNT(DISTINCT u.id) AS signups, COUNT(DISTINCT CASE WHEN rs.created_at >= u.created_at + INTERVAL 1 DAY AND rs.created_at < u.created_at + INTERVAL 8 DAY THEN u.id END) AS returned, COUNT(DISTINCT CASE WHEN rs.created_at >= u.created_at + INTERVAL 1 DAY AND rs.created_at < u.created_at + INTERVAL 8 DAY THEN u.id END) / NULLIF(COUNT(DISTINCT u.id),0) AS return_rate FROM users u LEFT JOIN refresh_sessions rs ON rs.user_id=u.id WHERE u.id < 900000000 AND u.id NOT IN (${excluded_user_ids:csv}) AND $__timeFilter(u.created_at) AND u.created_at >= NOW()-INTERVAL 30 DAY AND u.created_at < NOW()-INTERVAL 8 DAY GROUP BY 1 ORDER BY 1",
            "format": "table",
            "editorMode": "code",
            "rawQuery": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "return_rate"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percentunit"
                },
                {
                  "id": "decimals",
                  "value": 1
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true,
          "cellHeight": "sm",
          "sortBy": [
            {
              "displayName": "Value",
              "desc": true
            }
          ]
        }
      },
