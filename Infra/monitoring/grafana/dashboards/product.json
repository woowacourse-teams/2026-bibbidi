        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT COUNT(DISTINCT rs.user_id) AS returning_users FROM refresh_sessions rs JOIN users u ON u.id=rs.user_id WHERE u.id < 900000000 AND u.id NOT IN (${excluded_user_ids:csv}) AND DATE(rs.created_at)>DATE(u.created_at) AND $__timeFilter(rs.created_at) AND rs.created_at >= NOW()-INTERVAL 30 DAY",
            "format": "table",
            "editorMode": "code",
            "rawQuery": true
          }
