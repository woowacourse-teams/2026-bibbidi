      {
        "id": 5,
        "title": "일별 가입 수 · KST",
        "description": "",
        "type": "timeseries",
        "datasource": {
          "type": "mysql",
          "uid": "mysql"
        },
        "gridPos": {
          "x": 0,
          "y": 9,
          "w": 12,
          "h": 7
        },
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "mysql",
              "uid": "mysql"
            },
            "rawSql": "SELECT FLOOR((UNIX_TIMESTAMP(u.created_at)+32400)/86400)*86400-32400 AS time, COUNT(*) AS signups FROM users u WHERE u.id < 900000000 AND u.id NOT IN (${excluded_user_ids:csv}) AND $__timeFilter(u.created_at) GROUP BY 1 ORDER BY 1",
            "format": "time_series",
            "editorMode": "code",
            "rawQuery": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "noValue": "측정 없음",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 70,
              "lineWidth": 0,
              "showPoints": "never"
            }
          },
          "overrides": []
        },
        "options": {
          "legend": {
            "displayMode": "table",
            "placement": "bottom",
            "calcs": [
              "lastNotNull",
              "max"
            ]
          },
          "tooltip": {
            "mode": "multi",
            "sort": "desc"
          }
        }
