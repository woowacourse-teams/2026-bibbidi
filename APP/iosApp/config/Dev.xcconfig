// iOS development environment.
#include "Endpoints.local.xcconfig"
BIBBIDI_ENVIRONMENT = dev
BIBBIDI_APP_ID = com.bobbidi.bibbidi.dev
BIBBIDI_APP_NAME = 비비디 개발
